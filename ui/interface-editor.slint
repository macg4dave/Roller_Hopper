import { Button, ComboBox, LineEdit } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Theme } from "theme.slint";

// Adds further interfaces to the selected device on the edit page, each at its own address and
// connected behind a device of the user's choosing. An added interface is a device of its own,
// listed under this one, and edited like any other.
export component InterfaceEditor inherits VerticalLayout {
    property <bool> adding;
    // Half-typed interfaces belong to the device they were typed for.
    property <int> selected-id: Bridge.selected-id;
    changed selected-id => { adding = false; }

    horizontal-stretch: 1;

    if !adding: HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("edit.interface-add");
            icon: @image-url("icons/plus.svg");
            colorize-icon: true;
            clicked => { adding = true; }
        }
    }
    if adding: HorizontalLayout {
        spacing: Theme.space-xs;

        // As with ports, the row stays open for the next interface; a refused address stays in
        // the field to be corrected.
        function add() {
            if Bridge.add-interface(ip-field.text, via-field.current-index) {
                ip-field.text = "";
                ip-field.focus();
            }
        }

        ip-field := LineEdit {
            width: 140px;
            placeholder-text: @tr("details.ip");
            init => { self.focus(); }
            accepted => { add(); }
        }
        via-field := ComboBox {
            horizontal-stretch: 1;
            model: Bridge.upstream-choices;
            accessible-label: @tr("edit.interface-via");
        }
        Button {
            text: @tr("edit.interface-confirm-add");
            primary: true;
            enabled: ip-field.text != "";
            clicked => { add(); }
        }
        Button {
            icon: @image-url("icons/close.svg");
            colorize-icon: true;
            accessible-label: @tr("edit.cancel");
            clicked => { root.adding = false; }
        }
    }
}
