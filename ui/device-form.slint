import { Button, ComboBox, TextEdit } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { ChildRow } from "components/child-row.slint";
import { DetailField } from "components/detail-field.slint";
import { ForgetDevice } from "components/forget-device.slint";
import { IconChooser } from "components/icon-chooser.slint";
import { NameBox } from "components/name-box.slint";
import { SelectableText } from "components/selectable-text.slint";

// The selected device's editable fields: icon, name, role, the device it runs on, network
// cards, notes, and forgetting it. Used in the map details panel's edit mode and in the
// discovery details for a host on the map, which puts what the run found out
// under the role as this form's children.
export component DeviceForm inherits VerticalLayout {
    alignment: start;
    spacing: Theme.space-xs;

    HorizontalLayout {
        spacing: Theme.space-m;
        padding-bottom: Theme.space-m;
        IconChooser {
            width: 52px;
            height: 52px;
            icon: Bridge.details.icon;
            start-category: Bridge.details.icon.group;
            icon-size: 36px;
            tint: Theme.group-colour(Bridge.details.colour, Theme.accent);
            reset-text: @tr("edit.icon-from-role");
            can-reset: Bridge.details.custom-icon;
            picked(icon) => { Bridge.set-icon(Bridge.selected-id, icon.id); }
            reset => { Bridge.reset-icon(); }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-xs;
            NameBox {
                name: Bridge.details.name;
                placeholder: Labels.device-name("");
                font-size: Theme.font-title;
                font-weight: 600;
                field-label: @tr("details.name");
                commit(text) => { Bridge.rename(text); }
            }
            if Bridge.cards.length > 0: SelectableText {
                text: Labels.address(Bridge.cards[0].ip, Bridge.cards[0].dhcp);
                font-size: Theme.font-body;
                color: Theme.text-muted;
            }
        }
    }

    DetailField {
        label: @tr("details.role");
        // The role decides the icon the device is shown with. New roles are added in the role
        // list.
        ComboBox {
            model: Bridge.roles;
            current-index <=> Bridge.role-index;
            selected => { Bridge.choose-role(self.current-index); }
        }
    }
    DetailField {
        label: @tr("details.host");
        // Such as the host of a virtual machine.
        ComboBox {
            model: Bridge.host-choices;
            current-index: Bridge.host-index;
            accessible-label: @tr("details.host");
            selected => { Bridge.choose-host(self.current-index); }
        }
    }
    @children
    // Cards are edited on their own, opened from their row. A new one is blank and selected.
    DetailField {
        label: @tr("edit.cards");
        VerticalLayout {
            spacing: Theme.space-xs;
            for card in Bridge.cards: ChildRow {
                icon: card.icon;
                start-category: Bridge.card-icon-category;
                name: Labels.card-name(card.name, card.index);
                detail: Labels.card(Labels.address(card.ip, card.dhcp), card.via-name, card.via-card, card.via-index, card.inferred);
                picked(icon) => { Bridge.set-card-icon(card.id, icon.id); }
                clicked => { Bridge.select-card(card.id); }
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("edit.card-add");
                    icon: @image-url("icons/plus.svg");
                    colorize-icon: true;
                    clicked => { Bridge.add-card(); }
                }
            }
        }
    }
    DetailField {
        label: @tr("details.notes");
        TextEdit {
            height: 96px;
            wrap: word-wrap;
            placeholder-text: @tr("details.notes-placeholder");
            text <=> Bridge.notes-draft;
            edited(text) => { Bridge.edit-notes(text); }
        }
    }

    Rectangle { height: Theme.space-m; }
    ForgetDevice { }
}
