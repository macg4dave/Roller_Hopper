import { Button, ComboBox, LineEdit, TextEdit } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { ChildRow } from "components/child-row.slint";
import { DetailField } from "components/detail-field.slint";
import { IconChooser } from "components/icon-chooser.slint";
import { GuestEditor } from "guest-editor.slint";

// The selected device's editable fields: icon, name, role, its network cards and guests with
// adding more, notes, and forgetting it. Used on the edit page and in the details panel's edit
// mode.
export component DeviceForm inherits VerticalLayout {
    // Forgetting asks first; a new selection drops the question.
    property <bool> confirm-forget;
    property <int> selected-id: Bridge.selected-id;
    changed selected-id => { confirm-forget = false; }

    alignment: start;
    spacing: Theme.space-xs;

    // A guest is a child of its host, which it leads back to.
    if Bridge.details.host-id >= 0: HorizontalLayout {
        alignment: start;
        padding-bottom: Theme.space-s;
        Button {
            text: Labels.device-name(Bridge.details.host-name);
            icon: @image-url("icons/chevron-left.svg");
            colorize-icon: true;
            accessible-label: @tr("edit.guest-back");
            clicked => { Bridge.select(Bridge.details.host-id); }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-m;
        padding-bottom: Theme.space-m;
        IconChooser {
            width: 52px;
            height: 52px;
            icon: Bridge.details.icon;
            icon-size: 36px;
            tint: Theme.group-colour(Bridge.details.colour, Theme.accent);
            reset-text: @tr("edit.icon-from-role");
            can-reset: Bridge.details.custom-icon;
            picked(icon) => { Bridge.set-icon(Bridge.selected-id, icon.id); }
            reset => { Bridge.reset-icon(); }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-xs;
            Text {
                text: Labels.device-name(Bridge.details.name);
                font-size: Theme.font-title;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if Bridge.cards.length > 0: Text {
                text: Bridge.cards[0].ip;
                font-size: Theme.font-body;
                color: Theme.text-muted;
            }
        }
    }

    DetailField {
        label: @tr("details.name");
        LineEdit {
            text <=> Bridge.name-draft;
            edited(text) => { Bridge.rename(text); }
        }
    }
    DetailField {
        label: @tr("details.role");
        // The role decides the icon the device is shown with. New roles are added in the role
        // list.
        ComboBox {
            model: Bridge.roles;
            current-index <=> Bridge.role-index;
            selected => { Bridge.choose-role(self.current-index); }
        }
    }
    // Cards and guests are each edited on their own, opened from their row; a new card is
    // selected to be filled in.
    DetailField {
        label: @tr("edit.cards");
        VerticalLayout {
            spacing: Theme.space-xs;
            for card in Bridge.cards: ChildRow {
                icon: card.icon;
                start-category: Bridge.card-icon-category;
                name: Labels.card-name(card.name, card.index);
                detail: Labels.card(card.ip, card.via-name, card.via-card, card.via-index, card.inferred);
                picked(icon) => { Bridge.set-card-icon(card.id, icon.id); }
                clicked => { Bridge.select-card(card.id); }
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("edit.card-add");
                    icon: @image-url("icons/plus.svg");
                    colorize-icon: true;
                    clicked => { Bridge.add-card(); }
                }
            }
        }
    }
    DetailField {
        label: @tr("edit.guests");
        VerticalLayout {
            spacing: Theme.space-xs;
            for guest in Bridge.guests: ChildRow {
                icon: guest.icon;
                tint: Theme.group-colour(guest.colour, Theme.accent);
                name: Labels.device-name(guest.name);
                detail: Labels.guest-summary(guest.kind, guest.ip);
                picked(icon) => { Bridge.set-icon(guest.id, icon.id); }
                clicked => { Bridge.select(guest.id); }
            }
            GuestEditor { }
        }
    }
    DetailField {
        label: @tr("details.notes");
        TextEdit {
            height: 96px;
            wrap: word-wrap;
            placeholder-text: @tr("details.notes-placeholder");
            text <=> Bridge.notes-draft;
            edited(text) => { Bridge.edit-notes(text); }
        }
    }

    Rectangle { height: Theme.space-m; }
    if !confirm-forget: HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("edit.forget");
            icon: @image-url("icons/delete.svg");
            colorize-icon: true;
            clicked => { confirm-forget = true; }
        }
    }
    if confirm-forget: VerticalLayout {
        spacing: Theme.space-s;
        Text {
            text: @tr("edit.forget-question");
            font-size: Theme.font-body;
            color: Theme.text;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.space-s;
            Button {
                text: @tr("edit.forget-confirm");
                primary: true;
                clicked => { Bridge.forget(); }
            }
            Button {
                text: @tr("edit.cancel");
                clicked => { confirm-forget = false; }
            }
        }
    }
}
