import { Button, ComboBox, ScrollView, TextEdit } from "std-widgets.slint";
import { Bridge, FoundDecision, FoundFinding, FoundView } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { FlagChip } from "components/chip.slint";
import { DetailField } from "components/detail-field.slint";
import { DeviceIcon } from "components/device-icon.slint";
import { IconChooser } from "components/icon-chooser.slint";
import { NameBox } from "components/name-box.slint";
import { CardEditor } from "card-editor.slint";
import { DeviceForm } from "device-form.slint";
import { FoundFacts } from "found-facts.slint";

// Right of the discovery results: an editor for the selected host, over what the run found out
// about it. A host on the map is selected there too and gets the edit page's editor, so changes
// go straight to the map; it can also be shown there. A host not on the map can be renamed and
// given a role, an icon and notes, then added to the map with them, or ignored.
export component DiscoveryDetails inherits Rectangle {
    // Show the device with this id on the map, whose first card sits at (x, y) on it.
    callback show-on-map(int, float, float);

    property <FoundView> found: Bridge.found-details;
    property <bool> on-map: found.device-id >= 0 && Bridge.selected-id >= 0;
    property <bool> addable: found.finding != FoundFinding.known && found.decision != FoundDecision.added;

    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius;

    if Bridge.selected-found < 0: Text {
        text: @tr("discovery.details.empty");
        font-size: Theme.font-body;
        color: Theme.text-muted;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width - 4 * Theme.space-l;
    }

    if Bridge.selected-found >= 0 && on-map: map-scroll := ScrollView {
        VerticalLayout {
            width: map-scroll.visible-width;
            alignment: start;
            padding: Theme.space-l;
            spacing: Theme.space-s;

            HorizontalLayout {
                spacing: Theme.space-xs;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start;
                        FlagChip {
                            finding: found.finding;
                            decision: found.decision;
                        }
                    }
                }
                Button {
                    text: @tr("discovery.show-on-map");
                    clicked => { root.show-on-map(found.device-id, found.map-x, found.map-y); }
                }
                Button {
                    icon: @image-url("icons/close.svg");
                    colorize-icon: true;
                    accessible-label: @tr("details.close");
                    clicked => { Bridge.select-found(-1); }
                }
            }
            if Bridge.selected-card >= 0: CardEditor { }
            if Bridge.selected-card < 0: DeviceForm { }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            FoundFacts { found: found; }
        }
    }

    if Bridge.selected-found >= 0 && !on-map: scroll := ScrollView {
        VerticalLayout {
            width: scroll.visible-width;
            alignment: start;
            padding: Theme.space-l;
            spacing: Theme.space-xs;

            HorizontalLayout {
                spacing: Theme.space-m;
                padding-bottom: Theme.space-m;
                if addable: IconChooser {
                    width: 52px;
                    height: 52px;
                    icon: found.icon;
                    icon-size: 36px;
                    tint: found.unidentified ? Theme.unknown : Theme.accent;
                    reset-text: @tr("edit.icon-from-role");
                    can-reset: found.custom-icon;
                    picked(icon) => { Bridge.set-found-icon(found.index, icon.id); }
                    reset => { Bridge.reset-found-icon(found.index); }
                }
                if !addable: DeviceIcon {
                    icon: found.icon.image;
                    width: 44px;
                    height: 44px;
                    colorize: found.unidentified ? Theme.unknown : Theme.accent;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-xs;
                    horizontal-stretch: 1;
                    if addable: NameBox {
                        name: found.name;
                        placeholder: Labels.found-name("");
                        font-size: Theme.font-title;
                        font-weight: 600;
                        field-label: @tr("details.name");
                        commit(text) => { Bridge.rename-found(found.index, text); }
                    }
                    if !addable: Text {
                        text: Labels.found-name(found.name);
                        font-size: Theme.font-title;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        alignment: start;
                        FlagChip {
                            finding: found.finding;
                            decision: found.decision;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        icon: @image-url("icons/close.svg");
                        colorize-icon: true;
                        accessible-label: @tr("details.close");
                        clicked => { Bridge.select-found(-1); }
                    }
                }
            }

            DetailField {
                label: @tr("details.role");
                value: addable ? "" : found.role;
                if addable: ComboBox {
                    // Picking a role replaces the binding, so keep it following Rust's state.
                    property <int> role-index: found.role-index;
                    changed role-index => { self.current-index = self.role-index; }
                    horizontal-stretch: 1;
                    model: Bridge.roles;
                    current-index: found.role-index;
                    selected => { Bridge.set-found-role(found.index, self.current-index); }
                }
            }
            if addable: DetailField {
                label: @tr("details.notes");
                TextEdit {
                    // Typing replaces the binding, so take another host's notes by hand.
                    property <int> host: found.index;
                    changed host => { self.text = found.notes; }
                    height: 96px;
                    wrap: word-wrap;
                    placeholder-text: @tr("details.notes-placeholder");
                    text: found.notes;
                    edited(text) => { Bridge.edit-found-notes(found.index, text); }
                }
            }
            if !addable && found.notes != "": DetailField { label: @tr("details.notes"); value: found.notes; }
            FoundFacts { found: found; }

            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-s;
                padding-top: Theme.space-m;
                if addable: Button {
                    text: @tr("discovery.add");
                    icon: @image-url("icons/plus.svg");
                    colorize-icon: true;
                    primary: true;
                    clicked => { Bridge.add-found(found.index); }
                }
                if addable && found.decision == FoundDecision.pending: Button {
                    text: @tr("discovery.ignore");
                    clicked => { Bridge.ignore-found(found.index); }
                }
            }
        }
    }
}
