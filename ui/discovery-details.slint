import { Button, ScrollView } from "std-widgets.slint";
import { Bridge, FoundDecision, FoundFinding, FoundView } from "bridge.slint";
import { Theme } from "theme.slint";
import { FlagChip } from "components/chip.slint";
import { CardEditor } from "card-editor.slint";
import { DeviceForm } from "device-form.slint";
import { FoundCardDetails } from "found-card-details.slint";
import { FoundFacts } from "found-facts.slint";
import { FoundForm } from "found-form.slint";

// Right of the discovery results: an editor for the selected host or card, with what the run
// found out about the host under its role. A host on the map is selected there too, or its
// card, and gets the edit page's editor, so changes go straight to the map; it can also be
// shown there. A host not on the map, and its cards, are edited in their own form and added to
// the map with what was given, or ignored.
export component DiscoveryDetails inherits Rectangle {
    // Show the device with this id on the map, whose first card sits at (x, y) on it.
    callback show-on-map(int, float, float);

    property <FoundView> found: Bridge.found-details;
    property <bool> on-map: found.device-id >= 0 && Bridge.selected-id >= 0;
    property <bool> addable: found.finding != FoundFinding.known && found.decision != FoundDecision.added;

    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius;

    if Bridge.selected-found < 0: Text {
        text: @tr("discovery.details.empty");
        font-size: Theme.font-body;
        color: Theme.text-muted;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width - 4 * Theme.space-l;
    }

    if Bridge.selected-found >= 0 && on-map: map-scroll := ScrollView {
        VerticalLayout {
            // Padding is inside the layout's width. Leave it out of the content width so the
            // editor fills the sidebar without creating horizontal overflow.
            width: max(0px, map-scroll.visible-width - 2 * Theme.space-l);
            alignment: start;
            padding: Theme.space-l;
            spacing: Theme.space-s;

            HorizontalLayout {
                spacing: Theme.space-xs;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start;
                        FlagChip {
                            finding: found.finding;
                            decision: found.decision;
                        }
                    }
                }
                Button {
                    text: @tr("discovery.show-on-map");
                    clicked => { root.show-on-map(found.device-id, found.map-x, found.map-y); }
                }
                Button {
                    icon: @image-url("icons/close.svg");
                    colorize-icon: true;
                    accessible-label: @tr("details.close");
                    clicked => { Bridge.select-found(-1); }
                }
            }
            if Bridge.selected-card >= 0: CardEditor { }
            if Bridge.selected-card < 0: DeviceForm {
                FoundFacts { found: found; }
            }
        }
    }

    if Bridge.selected-found >= 0 && !on-map: scroll := ScrollView {
        VerticalLayout {
            width: max(0px, scroll.visible-width - 2 * Theme.space-l);
            alignment: start;
            padding: Theme.space-l;

            if Bridge.selected-found-card >= 0: FoundCardDetails {
                host: found;
                card: Bridge.found-cards[Bridge.selected-found-card];
                editable: addable;
            }
            if Bridge.selected-found-card < 0: FoundForm {
                found: found;
                addable: addable;
            }
        }
    }
}
