import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { GroupEditor } from "group-editor.slint";
import { RoleEditor } from "role-editor.slint";

// Role and group management. Device editing stays on the map, where its context remains visible.
export component EditPage inherits Rectangle {
    callback back();

    background: Theme.surface;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        HorizontalLayout {
            spacing: Theme.space-m;
            alignment: start;
            Button {
                text: @tr("edit.back");
                clicked => { root.back(); }
            }
            Text {
                text: @tr("edit.title");
                font-size: Theme.font-title;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            spacing: Theme.space-l;

            GroupEditor { vertical-stretch: 0; }
            RoleEditor { vertical-stretch: 1; }
        }
    }
}
