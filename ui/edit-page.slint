import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BridgeGroupEditor } from "bridge-group-editor.slint";
import { GroupEditor } from "group-editor.slint";
import { RoleEditor } from "role-editor.slint";
import { SegmentEditor } from "segment-editor.slint";
import { CollapsibleSection } from "components/collapsible-section.slint";

// Floating map setup: the map stays usable behind a compact palette. Its title bar moves it,
// while each kind of organisation expands in place rather than opening another page.
export component EditPage inherits Rectangle {
    callback back();

    property <bool> groups-open;
    property <bool> roles-open;
    property <bool> bridges-open;
    property <bool> segments-open;
    property <bool> moved;
    property <length> panel-x;
    property <length> panel-y;
    property <bool> expanded: groups-open || roles-open || bridges-open || segments-open;

    background: transparent;

    panel := Rectangle {
        x: root.moved
            ? root.panel-x.clamp(Theme.space-s, root.width - self.width - Theme.space-s)
            : (root.width - self.width) / 2;
        y: root.moved
            ? root.panel-y.clamp(Theme.space-s, root.height - self.height - Theme.space-s)
            : (root.height - self.height) / 2;
        width: min(480px, parent.width - 2 * Theme.space-s);
        height: root.expanded
            ? min(540px, parent.height - 2 * Theme.space-s)
            : min(220px, parent.height - 2 * Theme.space-s);
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: Theme.panel-radius;
        clip: true;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Theme.scrim;
        accessible-role: groupbox;
        accessible-label: @tr("edit.title");
        animate height { duration: 160ms; easing: ease-out; }

        VerticalLayout {
            title-bar := Rectangle {
                height: 40px;
                background: drag.has-hover ? Theme.hover : Theme.stripe;
                animate background { duration: 140ms; }

                drag := TouchArea {
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.panel-x = panel.x;
                            root.panel-y = panel.y;
                            root.moved = true;
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.panel-x = panel.x + self.mouse-x - self.pressed-x;
                            root.panel-y = panel.y + self.mouse-y - self.pressed-y;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.space-m;
                    padding-right: Theme.space-s;
                    spacing: Theme.space-s;
                    Text {
                        text: @tr("edit.title");
                        font-size: Theme.font-body;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            icon: @image-url("icons/close.svg");
                            colorize-icon: true;
                            accessible-label: @tr("list.finish-editing");
                            clicked => { root.back(); }
                        }
                    }
                }
            }

            VerticalLayout {
                padding: Theme.space-s;

                setup-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout {
                        width: setup-scroll.visible-width;
                        spacing: Theme.space-xs;

                        CollapsibleSection {
                            title: @tr("groups.title");
                            open <=> root.groups-open;
                            GroupEditor { show-heading: false; }
                        }
                        CollapsibleSection {
                            title: @tr("roles.title");
                            open <=> root.roles-open;
                            RoleEditor {
                                show-heading: false;
                                height: 410px;
                            }
                        }
                        CollapsibleSection {
                            title: @tr("bridge-groups.title");
                            open <=> root.bridges-open;
                            BridgeGroupEditor { }
                        }
                        CollapsibleSection {
                            title: @tr("segments.heading");
                            open <=> root.segments-open;
                            SegmentEditor { show-heading: false; }
                        }
                    }
                }
            }
        }
    }
}
