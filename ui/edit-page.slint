import { Button, TabWidget } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DeviceEditor } from "device-editor.slint";
import { GroupEditor } from "group-editor.slint";
import { RoleEditor } from "role-editor.slint";

// The edit page that replaces the map view: a tab each for devices, roles and groups.
export component EditPage inherits Rectangle {
    callback back();

    background: Theme.surface;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        HorizontalLayout {
            spacing: Theme.space-m;
            alignment: start;
            Button {
                text: @tr("edit.back");
                clicked => { root.back(); }
            }
            Text {
                text: @tr("edit.title");
                font-size: Theme.font-title;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: @tr("edit.tab-devices");
                VerticalLayout {
                    padding-top: Theme.space-m;
                    DeviceEditor { }
                }
            }
            Tab {
                title: @tr("edit.tab-roles");
                VerticalLayout {
                    padding-top: Theme.space-m;
                    RoleEditor { }
                }
            }
            Tab {
                title: @tr("edit.tab-groups");
                VerticalLayout {
                    padding-top: Theme.space-m;
                    GroupEditor { }
                }
            }
        }
    }
}
