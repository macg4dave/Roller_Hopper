import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DeviceEditor } from "device-editor.slint";
import { GroupEditor } from "group-editor.slint";
import { RoleEditor } from "role-editor.slint";

// The edit page that replaces the map view: devices on the left, groups and roles on the right.
export component EditPage inherits Rectangle {
    callback back();

    background: Theme.surface;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        HorizontalLayout {
            spacing: Theme.space-m;
            alignment: start;
            Button {
                text: @tr("edit.back");
                clicked => { root.back(); }
            }
            Text {
                text: @tr("edit.title");
                font-size: Theme.font-title;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.space-l;

            DeviceEditor { horizontal-stretch: 1; }

            VerticalLayout {
                horizontal-stretch: 1;
                // Room for a role row's columns, so they never squeeze together.
                min-width: Theme.edit-roles-min-width;
                spacing: Theme.space-l;

                GroupEditor { vertical-stretch: 0; }
                RoleEditor { vertical-stretch: 1; }
            }
        }
    }
}
