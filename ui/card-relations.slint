import { Button, ComboBox } from "std-widgets.slint";
import { Bridge, MembershipMode, RelationshipKind } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { DetailField } from "components/detail-field.slint";
import { SelectableText } from "components/selectable-text.slint";

// Everything that places one card in the network. The ordinary path reads as one connection:
// endpoint, join and segment. Moving a card to another device and adding graph-only joins are
// uncommon operations, so they remain available without competing with that path.
export component CardRelations inherits VerticalLayout {
    property <bool> advanced;
    // Index in Bridge.upstream-choices (0 for none), and in Labels.relationships less the cable.
    property <int> target;
    property <int> kind;

    spacing: Theme.space-s;

    Text {
        text: @tr("connection.heading");
        font-size: Theme.font-heading;
        font-weight: 600;
        color: Theme.text;
    }

    Rectangle {
        height: connection.preferred-height;
        background: Theme.stripe;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius;

        connection := VerticalLayout {
            padding: Theme.space-m;
            spacing: Theme.space-s;

            SelectableText {
                text: @tr("connection.help");
                font-size: Theme.font-small;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            DetailField {
                label: @tr("details.plugged-into");
                ComboBox {
                    horizontal-stretch: 1;
                    model: Bridge.upstream-choices;
                    current-index: Bridge.card-plug-index;
                    accessible-label: @tr("details.plugged-into");
                    selected => { Bridge.plug-card(self.current-index); }
                }
            }
            if Bridge.card-plug-index > 0: DetailField {
                label: @tr("details.relationship");
                ComboBox {
                    model: Labels.relationships;
                    current-index: Bridge.card.relationship == RelationshipKind.virtual-peer ? 1
                        : Bridge.card.relationship == RelationshipKind.bridge-member ? 2
                        : Bridge.card.relationship == RelationshipKind.routed ? 3 : 0;
                    accessible-label: @tr("details.relationship");
                    selected => { Bridge.set-relationship-kind(self.current-index); }
                }
            }
            DetailField {
                label: @tr("details.segment");
                ComboBox {
                    model: Bridge.segment-choices;
                    current-index: Bridge.card.segment-index;
                    accessible-label: @tr("details.segment");
                    selected => { Bridge.set-card-segment(self.current-index); }
                }
            }
            if Bridge.card.segment-index > 0: DetailField {
                label: @tr("details.vlan-mode");
                ComboBox {
                    model: Labels.membership-modes;
                    current-index: Bridge.card.membership-mode == MembershipMode.tagged ? 1
                        : Bridge.card.membership-mode == MembershipMode.native ? 2 : 0;
                    accessible-label: @tr("details.vlan-mode");
                    selected => { Bridge.set-membership-mode(self.current-index); }
                }
            }
            if !root.advanced: VerticalLayout {
                spacing: Theme.space-xs;
                for relation in Bridge.card-relations: SelectableText {
                    text: @tr("relationships.summary", relation.endpoint, Labels.relationship(relation.relationship));
                    font-size: Theme.font-small;
                    color: Theme.text-muted;
                }
            }
        }
    }

    HorizontalLayout {
        alignment: start;
        Button {
            text: root.advanced ? @tr("connection.hide-advanced") : @tr("connection.advanced");
            clicked => { root.advanced = !root.advanced; }
        }
    }

    if advanced: Rectangle {
        height: advanced-layout.preferred-height;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius;

        advanced-layout := VerticalLayout {
            padding: Theme.space-m;
            spacing: Theme.space-s;

            DetailField {
                label: @tr("details.child-of");
                ComboBox {
                    // Picking replaces the binding, so keep it following Rust's state: the move
                    // may be refused, or wait to be confirmed.
                    property <int> parent-index: Bridge.card-parent-index;
                    changed parent-index => { self.current-index = self.parent-index; }
                    horizontal-stretch: 1;
                    model: Bridge.parent-choices;
                    current-index: Bridge.card-parent-index;
                    accessible-label: @tr("details.child-of");
                    selected => {
                        Bridge.set-card-parent(self.current-index);
                        self.current-index = self.parent-index;
                    }
                }
            }

            Text {
                text: @tr("relationships.additional");
                font-size: Theme.font-body;
                font-weight: 600;
                color: Theme.text;
            }
            for relation[index] in Bridge.card-relations: HorizontalLayout {
                spacing: Theme.space-xs;
                SelectableText {
                    horizontal-stretch: 1;
                    text: @tr("relationships.summary", relation.endpoint, Labels.relationship(relation.relationship));
                }
                Button {
                    text: @tr("relationships.remove");
                    clicked => { Bridge.remove-card-relation(index); }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-xs;
                ComboBox {
                    horizontal-stretch: 1;
                    model: Bridge.upstream-choices;
                    current-index <=> root.target;
                    accessible-label: @tr("relationships.target");
                }
                ComboBox {
                    horizontal-stretch: 1;
                    model: [Labels.relationships[1], Labels.relationships[2], Labels.relationships[3]];
                    current-index <=> root.kind;
                    accessible-label: @tr("details.relationship");
                }
                Button {
                    text: @tr("relationships.add");
                    enabled: root.target > 0;
                    clicked => { Bridge.add-card-relation(root.target, root.kind + 1); }
                }
            }
        }
    }
}
