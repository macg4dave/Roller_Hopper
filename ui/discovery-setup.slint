import { Button, CheckBox, LineEdit, ProgressIndicator } from "std-widgets.slint";
import { Bridge, DiscoveryOption, DiscoveryPhase, TargetError } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";

// What to scan and how, the controls of the run, and how far it has got. The network and the
// options are fixed while a run is busy. The network is typed; until it is one that can be
// scanned, the heading says what is wrong and Start stays off.
export component DiscoverySetup inherits VerticalLayout {
    property <DiscoveryPhase> phase: Bridge.discovery.phase;
    property <bool> busy: phase == DiscoveryPhase.running;
    property <bool> can-start: !busy && Bridge.discovery.target-error == TargetError.none;
    property <bool> show-problem: !busy && Bridge.discovery.target-error != TargetError.none;

    spacing: Theme.space-m;

    HorizontalLayout {
        spacing: Theme.space-m;

        Text {
            text: @tr("discovery.network");
            color: Theme.text-muted;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
        LineEdit {
            width: 170px;
            text <=> Bridge.discovery-target-draft;
            placeholder-text: @tr("discovery.network-placeholder");
            enabled: !busy;
            accessible-label: @tr("discovery.network");
            edited(text) => { Bridge.set-discovery-target(text); }
            accepted => {
                if can-start {
                    Bridge.start-discovery();
                }
            }
        }
        for option in [
            { option: DiscoveryOption.port-scan, label: @tr("discovery.option.port-scan"), on: Bridge.discovery.port-scan },
            { option: DiscoveryOption.service-detection, label: @tr("discovery.option.service-detection"), on: Bridge.discovery.service-detection },
        ]: CheckBox {
            text: option.label;
            checked: option.on;
            enabled: !busy;
            toggled => { Bridge.set-discovery-option(option.option, self.checked); }
        }

        Rectangle { horizontal-stretch: 1; }

        Button {
            text: phase == DiscoveryPhase.finished ? @tr("discovery.start-again") : @tr("discovery.start");
            icon: @image-url("icons/scan.svg");
            colorize-icon: true;
            primary: true;
            enabled: can-start;
            clicked => { Bridge.start-discovery(); }
        }
        Button {
            text: @tr("discovery.stop");
            enabled: busy;
            clicked => { Bridge.stop-discovery(); }
        }
    }

    VerticalLayout {
        spacing: Theme.space-xs;
        HorizontalLayout {
            spacing: Theme.space-m;
            Text {
                text: show-problem ? Labels.target-problem(Bridge.discovery.target-error) : Labels.discovery-heading(phase, Bridge.discovery.target);
                font-size: Theme.font-heading;
                font-weight: 600;
                color: show-problem ? Theme.text-muted : Theme.text;
                horizontal-stretch: 1;
            }
            if phase != DiscoveryPhase.idle: Text {
                text: @tr("discovery.progress", Bridge.discovery.swept, Bridge.discovery.addresses, Labels.clock(Bridge.discovery.seconds));
                font-size: Theme.font-body;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
        ProgressIndicator {
            progress: Bridge.discovery.addresses > 0 ? Bridge.discovery.swept / Bridge.discovery.addresses : 0;
        }
    }
}
