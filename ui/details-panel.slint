import { Button, ScrollView } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { DetailField } from "components/detail-field.slint";
import { DeviceIcon } from "components/device-icon.slint";
import { StatusDot } from "components/status-dot.slint";

// Right panel: everything known about the selected device. Editing happens on the edit page.
export component DetailsPanel inherits Rectangle {
    // Open the edit page on the selected device.
    callback edit();

    background: Theme.surface;

    Rectangle {
        width: 1px;
        x: 0;
        background: Theme.border;
    }

    if Bridge.selected-id < 0: Text {
        text: @tr("details.empty");
        font-size: Theme.font-body;
        color: Theme.text-muted;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width - 4 * Theme.space-l;
    }

    if Bridge.selected-id >= 0: scroll := ScrollView {
        VerticalLayout {
            width: scroll.visible-width;
            alignment: start;
            padding: Theme.space-l;
            spacing: Theme.space-xs;

            HorizontalLayout {
                spacing: Theme.space-m;
                padding-bottom: Theme.space-m;
                DeviceIcon {
                    kind: Bridge.details.icon;
                    width: 44px;
                    height: 44px;
                    colorize: Theme.accent;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-xs;
                    horizontal-stretch: 1;
                    Text {
                        text: Labels.device-name(Bridge.details.name);
                        font-size: Theme.font-title;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            StatusDot { status: Bridge.details.status; }
                        }
                        Text {
                            text: Labels.status(Bridge.details.status);
                            font-size: Theme.font-body;
                            color: Theme.text-muted;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-xs;
                    Button {
                        icon: @image-url("icons/edit.svg");
                        colorize-icon: true;
                        accessible-label: @tr("details.edit");
                        clicked => { root.edit(); }
                    }
                    Button {
                        icon: @image-url("icons/close.svg");
                        colorize-icon: true;
                        accessible-label: @tr("details.close");
                        clicked => { Bridge.select(-1); }
                    }
                }
            }

            DetailField { label: @tr("details.role"); value: Bridge.details.role; }
            DetailField { label: @tr("details.ip"); value: Bridge.details.ip; }
            DetailField { label: @tr("details.mac"); value: Bridge.details.mac; }
            DetailField { label: @tr("details.type"); value: Labels.kind(Bridge.details.kind); }
            if Bridge.details.manufacturer != "": DetailField { label: @tr("details.manufacturer"); value: Bridge.details.manufacturer; }
            if Bridge.details.model != "": DetailField { label: @tr("details.model"); value: Bridge.details.model; }
            if Bridge.details.hostname != "": DetailField { label: @tr("details.hostname"); value: Bridge.details.hostname; }
            DetailField { label: @tr("details.last-seen"); value: Labels.last-seen(Bridge.details.last-seen-minutes); }
            if Bridge.details.uplink-name != "": DetailField {
                label: @tr("details.connected-to");
                value: Labels.uplink(Bridge.details.uplink-name, Bridge.details.uplink-inferred);
            }
            if Bridge.details.services != "": DetailField { label: @tr("details.open-ports"); value: Bridge.details.services; }
            if Bridge.details.notes != "": DetailField { label: @tr("details.notes"); value: Bridge.details.notes; }
        }
    }
}
