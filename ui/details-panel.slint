import { Button, ScrollView } from "std-widgets.slint";
import { Bridge, GuestKind } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { DetailField } from "components/detail-field.slint";
import { DeviceIcon } from "components/device-icon.slint";
import { StatusDot } from "components/status-dot.slint";
import { CardEditor } from "card-editor.slint";
import { DeviceForm } from "device-form.slint";

// Right panel: everything known about the selected device, with its network cards, or about
// the selected card (its addresses and open ports) under its device's name. The pencil turns it
// into the same editor as the edit page's, for the device or card, until Done.
export component DetailsPanel inherits Rectangle {
    // Showing the editor rather than the details; ends when nothing is selected.
    property <bool> editing;
    property <int> selected-id: Bridge.selected-id;
    changed selected-id => {
        if selected-id < 0 {
            editing = false;
        }
    }

    // Opens the editor on the selected device, as the pencil does.
    public function edit() {
        editing = true;
    }

    background: Theme.surface;

    Rectangle {
        width: 1px;
        x: 0;
        background: Theme.border;
    }

    if Bridge.selected-id < 0: Text {
        text: @tr("details.empty");
        font-size: Theme.font-body;
        color: Theme.text-muted;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width - 4 * Theme.space-l;
    }

    if Bridge.selected-id >= 0 && editing: edit-scroll := ScrollView {
        VerticalLayout {
            width: edit-scroll.visible-width;
            alignment: start;
            padding: Theme.space-l;
            spacing: Theme.space-s;

            HorizontalLayout {
                alignment: end;
                Button {
                    text: @tr("details.done");
                    primary: true;
                    clicked => { root.editing = false; }
                }
            }
            if Bridge.selected-card >= 0: CardEditor { }
            if Bridge.selected-card < 0: DeviceForm { }
        }
    }

    if Bridge.selected-id >= 0 && !editing: scroll := ScrollView {
        VerticalLayout {
            width: scroll.visible-width;
            alignment: start;
            padding: Theme.space-l;
            spacing: Theme.space-xs;

            HorizontalLayout {
                spacing: Theme.space-m;
                padding-bottom: Theme.space-m;
                DeviceIcon {
                    icon: Bridge.details.icon.image;
                    width: 44px;
                    height: 44px;
                    colorize: Theme.group-colour(Bridge.details.colour, Theme.accent);
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-xs;
                    horizontal-stretch: 1;
                    Text {
                        text: Labels.device-name(Bridge.details.name);
                        font-size: Theme.font-title;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            StatusDot { status: Bridge.details.status; }
                        }
                        Text {
                            text: Labels.status(Bridge.details.status);
                            font-size: Theme.font-body;
                            color: Theme.text-muted;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-xs;
                    Button {
                        icon: @image-url("icons/edit.svg");
                        colorize-icon: true;
                        accessible-label: @tr("details.edit");
                        clicked => { root.editing = true; }
                    }
                    Button {
                        icon: @image-url("icons/close.svg");
                        colorize-icon: true;
                        accessible-label: @tr("details.close");
                        clicked => { Bridge.select(-1); }
                    }
                }
            }

            if Bridge.selected-card >= 0: VerticalLayout {
                DetailField {
                    label: @tr("details.card");
                    value: Labels.card-name(Bridge.card.name, Bridge.card.index);
                }
                DetailField { label: @tr("details.ip"); value: Bridge.card.ip == "" ? @tr("card.no-address") : Bridge.card.ip; }
                if Bridge.card.mask != "": DetailField { label: @tr("details.mask"); value: Bridge.card.mask; }
                if Bridge.card.gateway != "": DetailField { label: @tr("details.gateway"); value: Bridge.card.gateway; }
                if Bridge.card.mac != "": DetailField { label: @tr("details.mac"); value: Bridge.card.mac; }
                DetailField {
                    label: @tr("details.plugged-into");
                    value: Labels.plugged-into(Bridge.card.via-name, Bridge.card.via-card, Bridge.card.via-index, Bridge.card.inferred);
                }
                if Bridge.card.services != "": DetailField { label: @tr("details.open-ports"); value: Bridge.card.services; }
                HorizontalLayout {
                    alignment: start;
                    padding-top: Theme.space-s;
                    Button {
                        text: @tr("details.show-device");
                        clicked => { Bridge.select(Bridge.selected-id); }
                    }
                }
            }

            if Bridge.selected-card < 0: VerticalLayout {
                DetailField { label: @tr("details.role"); value: Bridge.details.role; }
                if Bridge.details.guest != GuestKind.none: DetailField {
                    label: @tr("details.runs-on");
                    value: Labels.runs-on(Bridge.details.host-name, Bridge.details.guest);
                }
                for card in Bridge.cards: VerticalLayout {
                    DetailField {
                        label: Labels.card-name(card.name, card.index);
                        value: Labels.card(card.ip, card.via-name, card.via-card, card.via-index, card.inferred);
                    }
                    if card.mac != "": DetailField { label: @tr("details.mac"); value: card.mac; }
                }
                DetailField { label: @tr("details.type"); value: Labels.kind(Bridge.details.kind); }
                if Bridge.details.manufacturer != "": DetailField { label: @tr("details.manufacturer"); value: Bridge.details.manufacturer; }
                if Bridge.details.model != "": DetailField { label: @tr("details.model"); value: Bridge.details.model; }
                if Bridge.details.hostname != "": DetailField { label: @tr("details.hostname"); value: Bridge.details.hostname; }
                DetailField { label: @tr("details.last-seen"); value: Labels.last-seen(Bridge.details.last-seen-minutes); }
                if Bridge.details.notes != "": DetailField { label: @tr("details.notes"); value: Bridge.details.notes; }
            }
        }
    }
}
