import { Button, ScrollView } from "std-widgets.slint";
import { Bridge, OsFamily } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { DetailField } from "components/detail-field.slint";
import { DeviceIcon } from "components/device-icon.slint";
import { ForgetDevice } from "components/forget-device.slint";
import { CardDetails } from "card-details.slint";
import { CardEditor } from "card-editor.slint";
import { DeviceForm } from "device-form.slint";
import { SelectableText } from "components/selectable-text.slint";

// Right panel: everything known about the selected device, followed by each of its network
// cards in full and a way to forget it, or about the selected card (its addresses and open
// ports) under its device's name. Map edit mode replaces those details with the complete device
// or card editor.
export component DetailsPanel inherits Rectangle {
    in property <bool> edit-mode;

    background: Theme.surface;

    Rectangle {
        width: 1px;
        x: 0;
        background: Theme.border;
    }

    if Bridge.selected-id < 0: SelectableText {
        text: @tr("details.empty");
        font-size: Theme.font-body;
        color: Theme.text-muted;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width - 4 * Theme.space-l;
    }

    if Bridge.selected-id >= 0 && root.edit-mode: edit-scroll := ScrollView {
        content-width: self.visible-width;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        VerticalLayout {
            // Padding is part of the layout's width, so the editor remains flush with the
            // viewport and the inset is applied exactly once.
            width: edit-scroll.visible-width;
            alignment: start;
            padding: Theme.space-l;
            spacing: Theme.space-s;

            if Bridge.selected-card >= 0: CardEditor { }
            if Bridge.selected-card < 0: DeviceForm { }
        }
    }

    if Bridge.selected-id >= 0 && !root.edit-mode: scroll := ScrollView {
        VerticalLayout {
            width: scroll.visible-width;
            alignment: start;
            padding: Theme.space-l;
            spacing: Theme.space-xs;

            HorizontalLayout {
                spacing: Theme.space-m;
                padding-bottom: Theme.space-m;
                DeviceIcon {
                    icon: Bridge.details.icon.image;
                    width: 44px;
                    height: 44px;
                    colorize: Theme.group-colour(Bridge.details.colour, Theme.accent);
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-xs;
                    horizontal-stretch: 1;
                    SelectableText {
                        text: Labels.device-name(Bridge.details.name);
                        font-size: Theme.font-title;
                        font-weight: 600;
                        color: Theme.text;
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-xs;
                    Button {
                        icon: @image-url("icons/close.svg");
                        colorize-icon: true;
                        accessible-label: @tr("details.close");
                        clicked => { Bridge.select(-1); }
                    }
                }
            }

            if Bridge.selected-card >= 0: VerticalLayout {
                DetailField {
                    label: @tr("details.card");
                    value: Labels.card-name(Bridge.card.name, Bridge.card.index);
                }
                CardDetails { card: Bridge.card; }
                HorizontalLayout {
                    alignment: start;
                    padding-top: Theme.space-s;
                    Button {
                        text: @tr("details.show-device");
                        clicked => { Bridge.select(Bridge.selected-id); }
                    }
                }
            }

            if Bridge.selected-card < 0: VerticalLayout {
                DetailField { label: @tr("details.role"); value: Bridge.details.role; }
                DetailField { label: @tr("details.type"); value: Labels.kind(Bridge.details.kind); }
                if Bridge.details.manufacturer != "": DetailField { label: @tr("details.manufacturer"); value: Bridge.details.manufacturer; }
                if Bridge.details.model != "": DetailField { label: @tr("details.model"); value: Bridge.details.model; }
                if Bridge.details.hostname != "": DetailField { label: @tr("details.hostname"); value: Bridge.details.hostname; }
                if Bridge.details.os-family != OsFamily.unknown: DetailField {
                    label: @tr("details.os");
                    value: Labels.os(Bridge.details.os-family, Bridge.details.os-detail);
                }
                if Bridge.details.mdns-services != "": DetailField { label: @tr("details.mdns-services"); value: Bridge.details.mdns-services; }
                DetailField { label: @tr("details.last-seen"); value: Labels.last-seen(Bridge.details.last-seen-minutes); }
                if Bridge.details.notes != "": DetailField { label: @tr("details.notes"); value: Bridge.details.notes; }

                // Below the device, each of its network cards in full; its name selects it.
                for card in Bridge.cards: VerticalLayout {
                    padding-top: Theme.space-m;
                    spacing: Theme.space-xs;
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        alignment: start;
                        padding-top: Theme.space-s;
                        Button {
                            text: Labels.card-name(card.name, card.index);
                            icon: card.icon.image;
                            colorize-icon: true;
                            clicked => { Bridge.select-card(card.id); }
                        }
                    }
                    CardDetails { card: card; }
                }
                ForgetDevice { padding-top: Theme.space-l; }
            }
        }
    }
}
