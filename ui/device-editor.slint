import { ListView, ScrollView } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Theme } from "theme.slint";
import { DeviceRow } from "components/device-row.slint";
import { Splitter } from "components/splitter.slint";
import { AddMenu } from "add-menu.slint";
import { CardEditor } from "card-editor.slint";
import { DeviceForm } from "device-form.slint";

// Edit page, left side: every device with its network cards nested under it on the left, under
// the Add button, where a card's row dropped on another device's group moves it there; the
// selected device's editable fields on the right, or the selected card's.
export component DeviceEditor inherits HorizontalLayout {
    in-out property <length> list-width;

    list := VerticalLayout {
        preferred-width: root.list-width;
        min-width: Theme.panel-min-width;
        horizontal-stretch: 0;
        spacing: Theme.space-s;

        AddMenu { }
        ListView {
            vertical-stretch: 1;
            for device in Bridge.rows: DeviceRow {
                device: device;
                accepts-cards: true;
            }
        }
    }

    Splitter {
        width: Theme.space-l;
        size <=> root.list-width;
        pane-width: list.width;
        min-size: Theme.panel-min-width;
        max-size: root.width - Theme.space-l - Theme.edit-fields-min-width;
    }

    if Bridge.selected-id < 0: Text {
        text: @tr("edit.choose-device");
        font-size: Theme.font-body;
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    if Bridge.selected-id >= 0: scroll := ScrollView {
        horizontal-stretch: 1;
        VerticalLayout {
            // Without an x, Slint centres the form in the scroll area.
            x: 0;
            width: min(scroll.visible-width, 560px);
            alignment: start;

            if Bridge.selected-card >= 0: CardEditor { }
            if Bridge.selected-card < 0: DeviceForm { }
        }
    }
}
