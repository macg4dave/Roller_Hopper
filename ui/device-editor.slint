import { Button, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { DetailField } from "components/detail-field.slint";
import { DeviceIcon } from "components/device-icon.slint";
import { DeviceRow } from "components/device-row.slint";
import { IconPicker } from "components/icon-picker.slint";
import { RolePicker } from "components/role-picker.slint";

// Edit page, Devices tab: every device on the left, the selected one's editable fields on the right.
export component DeviceEditor inherits HorizontalLayout {
    // Forgetting asks first; a new selection drops the question.
    property <bool> confirm-forget;
    property <int> selected-id: Bridge.selected-id;
    changed selected-id => { confirm-forget = false; }

    spacing: Theme.space-l;

    ListView {
        width: Theme.list-width;
        for device in Bridge.devices: DeviceRow {
            device: device;
            selected: device.id == Bridge.selected-id;
            clicked => { Bridge.select(device.id); }
        }
    }

    if Bridge.selected-id < 0: Text {
        text: @tr("edit.choose-device");
        font-size: Theme.font-body;
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    if Bridge.selected-id >= 0: scroll := ScrollView {
        horizontal-stretch: 1;
        VerticalLayout {
            // Without an x, Slint centres the form in the scroll area.
            x: 0;
            width: min(scroll.visible-width, 560px);
            alignment: start;
            spacing: Theme.space-xs;

            HorizontalLayout {
                spacing: Theme.space-m;
                padding-bottom: Theme.space-m;
                DeviceIcon {
                    kind: Bridge.details.icon;
                    width: 44px;
                    height: 44px;
                    colorize: Theme.accent;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-xs;
                    Text {
                        text: Labels.device-name(Bridge.details.name);
                        font-size: Theme.font-title;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: Bridge.details.ip;
                        font-size: Theme.font-body;
                        color: Theme.text-muted;
                    }
                }
            }

            DetailField {
                label: @tr("details.name");
                LineEdit {
                    text <=> Bridge.name-draft;
                    edited(text) => { Bridge.rename(text); }
                }
            }
            DetailField {
                label: @tr("details.role");
                RolePicker { }
            }
            DetailField {
                label: @tr("edit.icon");
                VerticalLayout {
                    spacing: Theme.space-xs;
                    horizontal-stretch: 1;
                    IconPicker {
                        selected: Bridge.details.icon;
                        picked(icon) => { Bridge.set-icon(icon); }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: @tr("edit.icon-from-role");
                            enabled: Bridge.details.custom-icon;
                            clicked => { Bridge.reset-icon(); }
                        }
                    }
                }
            }
            DetailField {
                label: @tr("details.notes");
                TextEdit {
                    height: 96px;
                    wrap: word-wrap;
                    placeholder-text: @tr("details.notes-placeholder");
                    text <=> Bridge.notes-draft;
                    edited(text) => { Bridge.edit-notes(text); }
                }
            }

            Rectangle { height: Theme.space-m; }
            if !confirm-forget: HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("edit.forget");
                    icon: @image-url("icons/delete.svg");
                    colorize-icon: true;
                    clicked => { confirm-forget = true; }
                }
            }
            if confirm-forget: VerticalLayout {
                spacing: Theme.space-s;
                Text {
                    text: @tr("edit.forget-question");
                    font-size: Theme.font-body;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-s;
                    Button {
                        text: @tr("edit.forget-confirm");
                        primary: true;
                        clicked => { Bridge.forget(); }
                    }
                    Button {
                        text: @tr("edit.cancel");
                        clicked => { confirm-forget = false; }
                    }
                }
            }
        }
    }
}
