import { Button, ComboBox, LineEdit } from "std-widgets.slint";
import { Bridge, GuestKind } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";

// Adds a virtual machine or container to the selected device on the edit page, named and with
// the address of its first network card. It is then a device of its own, listed under its host.
export component GuestEditor inherits VerticalLayout {
    property <bool> adding;
    // A half-typed guest belongs to the host it was typed for.
    property <int> selected-id: Bridge.selected-id;
    changed selected-id => { adding = false; }

    spacing: Theme.space-xs;
    horizontal-stretch: 1;

    if !adding: HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("edit.guest-add");
            icon: @image-url("icons/plus.svg");
            colorize-icon: true;
            clicked => { adding = true; }
        }
    }
    if adding: VerticalLayout {
        spacing: Theme.space-xs;

        // A refused name or address stays in its field to be corrected.
        function add() {
            let kind = kind-field.current-index == 1 ? GuestKind.container : GuestKind.virtual-machine;
            if Bridge.add-guest(kind, name-field.text, address-field.text) {
                root.adding = false;
            }
        }

        HorizontalLayout {
            spacing: Theme.space-xs;
            kind-field := ComboBox {
                width: 150px;
                // In the order add() reads them.
                model: [Labels.guest-kind(GuestKind.virtual-machine), Labels.guest-kind(GuestKind.container)];
                accessible-label: @tr("edit.guest-kind");
            }
            name-field := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: @tr("details.name");
                init => { self.focus(); }
                accepted => { address-field.focus(); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-xs;
            address-field := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: @tr("edit.card-address");
                accepted => { add(); }
            }
            Button {
                text: @tr("edit.confirm-add");
                primary: true;
                enabled: name-field.text != "" && address-field.text != "";
                clicked => { add(); }
            }
            Button {
                icon: @image-url("icons/close.svg");
                colorize-icon: true;
                accessible-label: @tr("edit.cancel");
                clicked => { root.adding = false; }
            }
        }
    }
}
