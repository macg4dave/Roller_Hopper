import { Button, Slider, SpinBox, Switch, TabWidget } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Note, SectionTitle } from "ai-text.slint";

// How the model picks each word of an answer. Rust sets the defaults and keeps every value
// within its limits.
export struct GenerationSettings {
    temperature: float,
    top-p: float,
    top-k: int,
    min-p: float,
    repeat-penalty: float,
    max-tokens: int,
    context-tokens: int,
    think: bool,
}

// A labelled slider that shows its value to two decimal places.
component SliderSetting inherits VerticalLayout {
    in property <string> text;
    in property <string> explanation;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> enabled;
    in-out property <float> value;

    spacing: Theme.space-xs;

    HorizontalLayout {
        Text {
            text: root.text;
            color: Theme.text;
            horizontal-stretch: 1;
        }
        Text {
            text: Math.round(root.value * 100) / 100;
            color: Theme.text-muted;
        }
    }
    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        step: 0.05;
        value <=> root.value;
        enabled: root.enabled;
    }
    Note { text: root.explanation; }
}

// A labelled whole-number field.
component NumberSetting inherits VerticalLayout {
    in property <string> text;
    in property <string> explanation;
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step-size: 1;
    in property <bool> enabled;
    in-out property <int> value;

    spacing: Theme.space-xs;

    HorizontalLayout {
        spacing: Theme.space-s;
        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        SpinBox {
            width: 130px;
            minimum: root.minimum;
            maximum: root.maximum;
            step-size: root.step-size;
            value <=> root.value;
            enabled: root.enabled;
        }
    }
    Note { text: root.explanation; }
}

component GenerationSettingsPanel inherits VerticalLayout {
    in-out property <GenerationSettings> settings;
    // The most tokens a prompt and its answer may hold together.
    in property <int> max-context-tokens;
    // False while an answer is being written.
    in property <bool> enabled;

    callback restore-defaults();

    spacing: Theme.space-m;

    SliderSetting {
        text: @tr("ai-settings.temperature");
        explanation: @tr("ai-settings.temperature-explained");
        minimum: 0;
        maximum: 2;
        value <=> root.settings.temperature;
        enabled: root.enabled;
    }
    SliderSetting {
        text: @tr("ai-settings.top-p");
        explanation: @tr("ai-settings.top-p-explained");
        minimum: 0.05;
        maximum: 1;
        value <=> root.settings.top-p;
        enabled: root.enabled && root.settings.temperature > 0;
    }
    NumberSetting {
        text: @tr("ai-settings.top-k");
        explanation: @tr("ai-settings.top-k-explained");
        minimum: 0;
        maximum: 1000;
        value <=> root.settings.top-k;
        enabled: root.enabled && root.settings.temperature > 0;
    }
    SliderSetting {
        text: @tr("ai-settings.min-p");
        explanation: @tr("ai-settings.min-p-explained");
        minimum: 0;
        maximum: 1;
        value <=> root.settings.min-p;
        enabled: root.enabled && root.settings.temperature > 0;
    }
    SliderSetting {
        text: @tr("ai-settings.repeat-penalty");
        explanation: @tr("ai-settings.repeat-penalty-explained");
        minimum: 1;
        maximum: 2;
        value <=> root.settings.repeat-penalty;
        enabled: root.enabled;
    }
    NumberSetting {
        text: @tr("ai-settings.max-tokens");
        explanation: @tr("ai-settings.max-tokens-explained");
        minimum: 1;
        maximum: root.settings.context-tokens;
        step-size: 100;
        value <=> root.settings.max-tokens;
        enabled: root.enabled;
    }
    NumberSetting {
        text: @tr("ai-settings.context-tokens");
        explanation: @tr("ai-settings.context-tokens-explained");
        minimum: 512;
        maximum: root.max-context-tokens;
        step-size: 1024;
        value <=> root.settings.context-tokens;
        enabled: root.enabled;
    }
    VerticalLayout {
        spacing: Theme.space-xs;
        Switch {
            text: @tr("ai-settings.think");
            checked <=> root.settings.think;
            enabled: root.enabled;
        }
        Note { text: @tr("ai-settings.think-explained"); }
    }
    HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("ai-settings.restore-defaults");
            enabled: root.enabled;
            clicked => { root.restore-defaults(); }
        }
    }
}

export component GenerationPanel inherits VerticalLayout {
    in-out property <GenerationSettings> gguf-settings;
    in-out property <GenerationSettings> safetensors-settings;
    in-out property <int> tab-index;
    in property <int> max-context-tokens;
    in property <bool> enabled;

    callback restore-defaults(int);

    spacing: Theme.space-m;

    SectionTitle { text: @tr("ai-settings.generation"); }
    tabs := TabWidget {
        current-index <=> root.tab-index;
        Tab {
            title: @tr("ai-settings.generation-gguf");
            GenerationSettingsPanel {
                settings <=> root.gguf-settings;
                max-context-tokens: root.max-context-tokens;
                enabled: root.enabled;
                restore-defaults => { root.restore-defaults(0); }
            }
        }
        Tab {
            title: @tr("ai-settings.generation-safetensors");
            GenerationSettingsPanel {
                settings <=> root.safetensors-settings;
                max-context-tokens: root.max-context-tokens;
                enabled: root.enabled;
                restore-defaults => { root.restore-defaults(1); }
            }
        }
    }
}
