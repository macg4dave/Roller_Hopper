import { Button, LineEdit, ListView } from "std-widgets.slint";
import { Bridge, DeviceView, StatusFilter } from "bridge.slint";
import { Theme } from "theme.slint";
import { DeviceRow } from "components/device-row.slint";

// Left panel: search, the way to the edit page, All / Online / Offline filters and the
// matching devices, each with its network cards.
export component DeviceList inherits Rectangle {
    // A device was double-clicked: bring it into view on the map.
    callback show-on-map(DeviceView);
    // Opens the edit page.
    callback edit();

    background: Theme.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;

        LineEdit {
            placeholder-text: @tr("list.search-placeholder");
            edited(text) => { Bridge.search(text); }
        }
        Button {
            text: @tr("list.edit-devices");
            icon: @image-url("icons/edit.svg");
            colorize-icon: true;
            clicked => { root.edit(); }
        }

        HorizontalLayout {
            spacing: Theme.space-xs;
            for tab in [
                { filter: StatusFilter.all, label: @tr("filter.all"), count: Bridge.count-all },
                { filter: StatusFilter.online, label: @tr("filter.online"), count: Bridge.count-online },
                { filter: StatusFilter.offline, label: @tr("filter.offline"), count: Bridge.count-offline },
            ]: Button {
                text: @tr("filter.button", tab.label, tab.count);
                primary: Bridge.filter == tab.filter;
                clicked => { Bridge.set-filter(tab.filter); }
            }
        }

        if Bridge.list.length == 0: Text {
            text: @tr("list.no-match");
            font-size: Theme.font-body;
            color: Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: top;
            vertical-stretch: 1;
        }

        if Bridge.list.length > 0: ListView {
            vertical-stretch: 1;
            for device in Bridge.list: DeviceRow {
                device: device;
                double-clicked => { root.show-on-map(device); }
            }
        }
    }
}
