import { Button, LineEdit, ListView } from "std-widgets.slint";
import { Bridge, DeviceView } from "bridge.slint";
import { Theme } from "theme.slint";
import { DeviceRow } from "components/device-row.slint";
import { AddMenu } from "add-menu.slint";

// Left panel: map edit mode, search, the matching devices with their network cards, and access
// to role and group management. Edit mode also allows adding devices and moving cards between
// devices; the selected item is edited in the details panel.
export component DeviceList inherits Rectangle {
    in-out property <bool> edit-mode;
    // A device was double-clicked: bring it into view on the map.
    callback show-on-map(DeviceView);

    background: Theme.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;

        LineEdit {
            placeholder-text: @tr("list.search-placeholder");
            edited(text) => { Bridge.search(text); }
        }
        Button {
            text: root.edit-mode ? @tr("list.finish-editing") : @tr("list.edit-mode");
            icon: @image-url("icons/edit.svg");
            colorize-icon: true;
            primary: root.edit-mode;
            clicked => { root.edit-mode = !root.edit-mode; }
        }
        if Bridge.list.length == 0: Text {
            text: @tr("list.no-match");
            font-size: Theme.font-body;
            color: Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: top;
            vertical-stretch: 1;
        }

        if Bridge.list.length > 0: ListView {
            vertical-stretch: 1;
            for device in Bridge.list: DeviceRow {
                device: device;
                accepts-cards: root.edit-mode;
                double-clicked => { root.show-on-map(device); }
            }
        }

        if root.edit-mode: HorizontalLayout {
            alignment: start;
            AddMenu { }
        }
    }
}
