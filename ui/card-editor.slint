import { Button, CheckBox, ComboBox } from "std-widgets.slint";
import { Bridge, CardField, InterfaceKind, InterfaceState } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { CardRelations } from "card-relations.slint";
import { DetailField } from "components/detail-field.slint";
import { IconChooser } from "components/icon-chooser.slint";
import { NameBox } from "components/name-box.slint";
import { NameEdit } from "components/name-edit.slint";
import { PortEditor } from "port-editor.slint";
import { SelectableText } from "components/selectable-text.slint";

// One setting of the selected card. It is kept on Enter or when the field loses focus. A
// refused value is replaced by the card's own, with a hint saying what is expected.
component CardSetting inherits VerticalLayout {
    in property <CardField> field;
    in property <string> value;
    in property <string> hint;
    in property <bool> enabled: true;
    // What a screen reader calls the field.
    in property <string> label;
    property <bool> refused;
    // A hint belongs to the card it was given for.
    property <int> selected-card: Bridge.selected-card;
    changed selected-card => { refused = false; }

    spacing: Theme.space-xs;
    horizontal-stretch: 1;

    NameEdit {
        name: root.value;
        enabled: root.enabled;
        accessible-label: root.label;
        commit(text) => { root.refused = !Bridge.edit-card(root.field, text); }
    }
    if refused: SelectableText {
        text: root.hint;
        font-size: Theme.font-small;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}

// While a network card is selected in map edit mode: its identity, addressing, one consolidated
// connection editor, open ports, and removal. A card is a child of its device, which it leads
// back to; that uncommon ownership change stays in the connection editor's advanced controls.
export component CardEditor inherits VerticalLayout {
    alignment: start;
    spacing: Theme.space-xs;

    HorizontalLayout {
        alignment: start;
        padding-bottom: Theme.space-s;
        Button {
            text: Labels.device-name(Bridge.details.name);
            icon: @image-url("icons/chevron-left.svg");
            colorize-icon: true;
            accessible-label: @tr("edit.card-back");
            clicked => { Bridge.select(Bridge.selected-id); }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-m;
        padding-bottom: Theme.space-m;
        IconChooser {
            width: 52px;
            height: 52px;
            icon: Bridge.card.icon;
            start-category: Bridge.card-icon-category;
            icon-size: 36px;
            tint: Theme.accent;
            picked(icon) => { Bridge.set-card-icon(Bridge.card.id, icon.id); }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-xs;
            NameBox {
                name: Bridge.card.name;
                placeholder: Labels.card-name("", Bridge.card.index);
                font-size: Theme.font-title;
                font-weight: 600;
                field-label: @tr("details.name");
                commit(text) => { Bridge.edit-card(CardField.name, text); }
            }
            SelectableText {
                text: @tr("edit.card-of", Labels.device-name(Bridge.details.name));
                font-size: Theme.font-body;
                color: Theme.text-muted;
            }
        }
    }

    // Dropdown positions follow the order of the enums.
    DetailField {
        label: @tr("details.interface-kind");
        ComboBox {
            model: Labels.interface-kinds;
            current-index: Bridge.card.interface-kind == InterfaceKind.virtual-adapter ? 1
                : Bridge.card.interface-kind == InterfaceKind.bridge ? 2
                : Bridge.card.interface-kind == InterfaceKind.switch-port ? 3 : 0;
            accessible-label: @tr("details.interface-kind");
            selected => { Bridge.set-interface-kind(self.current-index); }
        }
    }
    DetailField {
        label: @tr("details.interface-state");
        ComboBox {
            model: Labels.interface-states;
            current-index: Bridge.card.interface-state == InterfaceState.up ? 1
                : Bridge.card.interface-state == InterfaceState.down ? 2
                : Bridge.card.interface-state == InterfaceState.admin-down ? 3 : 0;
            accessible-label: @tr("details.interface-state");
            selected => { Bridge.set-interface-state(self.current-index); }
        }
    }
    DetailField {
        label: @tr("details.ip");
        CardSetting {
            field: CardField.address;
            value: Bridge.card.ip;
            hint: @tr("edit.card-ip-hint");
            label: @tr("details.ip");
        }
    }
    DetailField {
        label: @tr("details.dhcp");
        CheckBox {
            checked: Bridge.card.dhcp;
            text: @tr("edit.card-dhcp");
            toggled => { Bridge.set-card-dhcp(self.checked); }
        }
    }
    DetailField {
        label: @tr("details.mask");
        // A subnet belongs to an address, so the mask waits for one.
        CardSetting {
            field: CardField.mask;
            value: Bridge.card.mask;
            enabled: Bridge.card.ip != "";
            hint: @tr("edit.card-mask-hint");
            label: @tr("details.mask");
        }
    }
    DetailField {
        label: @tr("details.gateway");
        CardSetting {
            field: CardField.gateway;
            value: Bridge.card.gateway;
            hint: @tr("edit.card-gateway-hint");
            label: @tr("details.gateway");
        }
    }
    DetailField {
        label: @tr("details.mac");
        CardSetting {
            field: CardField.mac;
            value: Bridge.card.mac;
            hint: @tr("edit.card-mac-hint");
            label: @tr("details.mac");
        }
    }
    CardRelations { }
    DetailField {
        label: @tr("details.open-ports");
        PortEditor { }
    }

    Rectangle { height: Theme.space-m; }
    HorizontalLayout {
        alignment: start;
        // Every device keeps at least one card.
        Button {
            text: @tr("edit.card-remove");
            icon: @image-url("icons/delete.svg");
            colorize-icon: true;
            enabled: Bridge.cards.length > 1;
            clicked => { Bridge.remove-card(); }
        }
    }
}
