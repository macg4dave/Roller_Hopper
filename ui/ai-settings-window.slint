import { Button, Palette, ScrollView, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Card, Note } from "ai-text.slint";
import { GenerationPanel, GenerationSettings } from "ai-generation.slint";
import { AiTrial, AnswerEnd } from "ai-trial.slint";
import { AiInstallPanel } from "ai-install-panel.slint";
import { AiModelPanel, GpuCheck, ModelState } from "ai-model-panel.slint";
import { AiScanHost, AiScanPanel } from "ai-scan-panel.slint";
import { Light } from "components/light.slint";
import { InstallOutcome, TargetError } from "bridge.slint";

export { AiScanHost, GenerationSettings, AnswerEnd, GpuCheck, InstallOutcome, ModelState }

// Whether Save kept the AI settings: nothing to say until it is pressed, and again once a
// setting changes after it.
export enum SaveOutcome { none, saved, failed }

// An automation switch that nothing can act on yet, so it stays off and disabled, with what it
// will do.
component AiControl inherits VerticalLayout {
    in property <string> text;
    in property <string> explanation;

    spacing: Theme.space-xs;

    Switch {
        text: root.text;
        checked: false;
        enabled: false;
    }
    Note { text: root.explanation; }
}

// Its own window, opened from Settings: lights for the model and CUDA, a sidebar that scans a
// network and lists its hosts, installing models, loading one, trying it on a prompt and a
// host's evidence, and the AI settings the user controls.
export component AiSettingsWindow inherits Window {
    in property <[string]> offered-names;
    in property <[float]> offered-gb;
    in property <[bool]> offered-installed;
    in-out property <int> offer-index: 0;
    in property <string> folder;
    in property <bool> installing;
    in property <float> progress;
    in property <InstallOutcome> outcome;

    in property <[string]> models;
    in-out property <int> model-index: -1;
    in property <string> loaded-name;
    in property <ModelState> state;
    in property <GpuCheck> gpu;

    in-out property <string> prompt;
    in-out property <SaveOutcome> save-outcome;
    in-out property <string> input;
    in property <string> output;

    // The sidebar's scan: the network typed, whether a scan can take it, how far a running
    // scan has got, the hosts found and the one whose evidence is in the device text.
    in-out property <string> scan-target;
    in property <TargetError> scan-target-error;
    in property <bool> scanning;
    in property <int> scan-swept;
    in property <int> scan-addresses;
    in property <[AiScanHost]> scan-hosts;
    in property <int> scan-host-index: -1;

    // How the model picks each word, and the most tokens a prompt and its answer may hold.
    in-out property <GenerationSettings> generation;
    in property <int> max-context-tokens;
    // The last answer: its length in tokens, how long it took and how it ended, with its
    // prompt's length and the time to its first token.
    in property <int> answer-tokens;
    in property <float> answer-seconds;
    in property <int> prompt-tokens;
    in property <float> first-token-seconds;
    in property <AnswerEnd> answer-end;

    callback install(int);
    callback cancel-install();
    callback load(int);
    callback unload();
    callback refresh();
    // Sends the prompt and device text exactly as written.
    callback run(string, string);
    // Ends the answer being written, keeping what it has so far.
    callback stop();
    callback restore-generation();
    callback select-thinking(bool);
    // Puts back the default prompt; Save keeps it.
    callback restore-prompt();
    // Keeps the prompt, answer settings and loaded model for next time and for Import with AI.
    callback save();
    callback set-scan-target(string);
    callback scan();
    callback stop-scan();
    // A found host by its AiScanHost.index: its evidence goes in the device text.
    callback select-scan-host(int);

    title: @tr("ai-settings.title");
    preferred-width: 1440px;
    preferred-height: 820px;
    min-width: 1180px;
    min-height: 620px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    // Each window has its own globals, so this one also stays light like the main window.
    init => { Palette.color-scheme = ColorScheme.light; }

    // A change after Save is not saved yet.
    changed prompt => { save-outcome = SaveOutcome.none; }
    changed generation => { save-outcome = SaveOutcome.none; }
    changed loaded-name => { save-outcome = SaveOutcome.none; }

    property <bool> busy: state == ModelState.loading || state == ModelState.running;
    // Loaded and usable; a model that failed only on the GPU is not.
    property <bool> loaded: loaded-name != "" && state != ModelState.no-gpu
        && state != ModelState.insufficient-gpu-memory;
    property <bool> cuda-on: gpu == GpuCheck.supported && state != ModelState.no-gpu
        && state != ModelState.insufficient-gpu-memory;

    pure function model-light-text() -> string {
        if state == ModelState.loading { return @tr("ai-settings.light-loading", loaded-name); }
        if state == ModelState.running { return @tr("ai-settings.light-running", loaded-name); }
        if loaded { return @tr("ai-settings.light-loaded", loaded-name); }
        if state == ModelState.none || state == ModelState.no-model { return @tr("ai-settings.light-none"); }
        return @tr("ai-settings.light-failed");
    }

    pure function model-light-colour() -> color {
        if busy { return Theme.unknown; }
        if loaded { return Theme.online; }
        if state == ModelState.none || state == ModelState.no-model { return Theme.offline; }
        return Theme.light-off;
    }

    pure function cuda-light-text() -> string {
        if gpu == GpuCheck.checking { return @tr("ai-settings.light-cuda-checking"); }
        if gpu == GpuCheck.unsupported || state == ModelState.no-gpu { return @tr("ai-settings.light-cuda-no-gpu"); }
        return @tr("ai-settings.light-cuda-on");
    }

    VerticalLayout {
        Rectangle {
            background: Theme.surface;
            height: Theme.header-height;

            HorizontalLayout {
                padding-left: Theme.space-l * 1.5;
                padding-right: Theme.space-l * 1.5;
                spacing: Theme.space-s;
                alignment: stretch;

                Text {
                    text: @tr("ai-settings.title");
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Light {
                        colour: model-light-colour();
                        text: model-light-text();
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Light {
                        colour: cuda-on ? Theme.online : Theme.light-off;
                        text: cuda-light-text();
                    }
                }
                if save-outcome != SaveOutcome.none: Text {
                    text: save-outcome == SaveOutcome.saved ? @tr("ai-settings.saved") : @tr("ai-settings.save-failed");
                    color: save-outcome == SaveOutcome.saved ? Theme.text-muted : Theme.warning;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("ai-settings.save");
                        primary: true;
                        clicked => { root.save(); }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            padding: Theme.space-l;
            spacing: Theme.space-l;

            Card {
                width: Theme.list-width;
                AiScanPanel {
                    target <=> root.scan-target;
                    target-error: root.scan-target-error;
                    scanning: root.scanning;
                    swept: root.scan-swept;
                    addresses: root.scan-addresses;
                    hosts: root.scan-hosts;
                    host-index: root.scan-host-index;
                    set-target(text) => { root.set-scan-target(text); }
                    scan => { root.scan(); }
                    stop-scan => { root.stop-scan(); }
                    select-host(index) => { root.select-scan-host(index); }
                }
            }

            settings-scroll := ScrollView {
                width: 400px;

                VerticalLayout {
                    width: settings-scroll.visible-width;
                    alignment: start;
                    padding-right: Theme.scrollbar-width;
                    spacing: Theme.space-l;

                    AiModelPanel {
                        models: root.models;
                        model-index <=> root.model-index;
                        loaded-name: root.loaded-name;
                        state: root.state;
                        folder: root.folder;
                        gpu: root.gpu;
                        load(index) => { root.load(index); }
                        unload => { root.unload(); }
                        refresh => { root.refresh(); }
                    }

                    AiInstallPanel {
                        offered-names: root.offered-names;
                        offered-gb: root.offered-gb;
                        offered-installed: root.offered-installed;
                        offer-index <=> root.offer-index;
                        folder: root.folder;
                        installing: root.installing;
                        progress: root.progress;
                        outcome: root.outcome;
                        install(index) => { root.install(index); }
                        cancel-install => { root.cancel-install(); }
                    }

                    Card {
                        GenerationPanel {
                            settings <=> root.generation;
                            max-context-tokens: root.max-context-tokens;
                            enabled: state != ModelState.running;
                            restore-defaults => { root.restore-generation(); }
                            select-thinking(think) => { root.select-thinking(think); }
                        }
                    }

                    Card {
                        title: @tr("ai-settings.behaviour");
                        VerticalLayout {
                            spacing: Theme.space-m;
                            AiControl {
                                text: @tr("ai-settings.fill-missing");
                                explanation: @tr("ai-settings.fill-missing-explained");
                            }
                            AiControl {
                                text: @tr("ai-settings.auto-add");
                                explanation: @tr("ai-settings.auto-add-explained");
                            }
                        }
                    }
                }
            }

            Card {
                horizontal-stretch: 1;
                AiTrial {
                    prompt <=> root.prompt;
                    input <=> root.input;
                    output: root.output;
                    can-run: state == ModelState.ready || state == ModelState.too-long
                        || state == ModelState.failed;
                    running: state == ModelState.running;
                    answer-tokens: root.answer-tokens;
                    answer-seconds: root.answer-seconds;
                    prompt-tokens: root.prompt-tokens;
                    first-token-seconds: root.first-token-seconds;
                    answer-end: root.answer-end;
                    run(prompt, input) => { root.run(prompt, input); }
                    stop => { root.stop(); }
                    restore-prompt => { root.restore-prompt(); }
                }
            }
        }
    }
}
