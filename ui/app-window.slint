import { Button, Palette, ProgressIndicator, Spinner } from "std-widgets.slint";
import { Bridge, FileProblemKind, InstallOutcome } from "bridge.slint";
import { Theme } from "theme.slint";
import { Header } from "header.slint";
import { Labels } from "labels.slint";
import { DeviceList } from "device-list.slint";
import { TopologyCanvas } from "topology-canvas.slint";
import { DetailsPanel } from "details-panel.slint";
import { EditPage } from "edit-page.slint";
import { DiscoveryPage } from "discovery-page.slint";
import { Splitter } from "components/splitter.slint";
import { MoveDialog } from "move-dialog.slint";
import { FileProblemDialog, UnsavedDialog } from "project-dialogs.slint";
import { AiDownloadOutcomeDialog, AiDownloadQuestion, GpuUnsupportedDialog } from "ai-dialogs.slint";
import { AiSettingsWindow, AnswerEnd, GenerationSettings, GpuCheck, ModelState } from "ai-settings-window.slint";

export { Bridge, Labels, AiSettingsWindow, AnswerEnd, GenerationSettings, GpuCheck, InstallOutcome, ModelState }

// What the window shows under the header: the map view, or a page over it.
enum Page { map, edit, discovery }

export component AppWindow inherits Window {
    title: @tr("app.title");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1000px;
    min-height: 600px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    // The design is light-only; without this, std-widgets follow a dark system theme.
    init => { Palette.color-scheme = ColorScheme.light; }

    // The edit and discovery pages cover the map view rather than replacing it, so the map keeps
    // its zoom and pan while a page is open.
    property <Page> page: Page.map;
    // Panel widths the user dragged to; kept here so they survive page changes.
    property <length> list-width: Theme.list-width;
    property <length> details-width: Theme.details-width;
    property <bool> edit-mode;

    // The AI settings window is wanted; Rust opens it, since a .slint file cannot.
    callback open-ai-settings();
    VerticalLayout {
        Header {
            ai-settings => { root.open-ai-settings(); }
            // The selection may have moved on the map meanwhile: back on the found host's device.
            scan => {
                page = Page.discovery;
                Bridge.select-found(Bridge.selected-found);
            }
        }

        Rectangle {
            vertical-stretch: 1;

            Rectangle {
                visible: page == Page.map;

                HorizontalLayout {
                    // A narrow window squeezes the map first, then the panels down to their minimum.
                    list := DeviceList {
                        preferred-width: root.list-width;
                        min-width: Theme.panel-min-width;
                        horizontal-stretch: 0;
                        edit-mode <=> root.edit-mode;
                        show-on-map(device) => { canvas.centre-on(device.x, device.y); }
                        manage-roles => { page = Page.edit; }
                    }
                    canvas := TopologyCanvas {
                        min-width: Theme.canvas-min-width;
                        horizontal-stretch: 1;
                    }
                    details := DetailsPanel {
                        preferred-width: root.details-width;
                        min-width: Theme.panel-min-width;
                        horizontal-stretch: 0;
                        edit-mode: root.edit-mode;
                    }
                }

                // Over the panel edges rather than in the layout, so they take no room from the map.
                Splitter {
                    x: list.width - self.width / 2;
                    size <=> root.list-width;
                    pane-width: list.width;
                    min-size: Theme.panel-min-width;
                    max-size: parent.width - details.width - Theme.canvas-min-width;
                }
                Splitter {
                    x: details.x - self.width / 2;
                    size <=> root.details-width;
                    pane-width: details.width;
                    min-size: Theme.panel-min-width;
                    max-size: parent.width - list.width - Theme.canvas-min-width;
                    pane-after: true;
                }
            }

            if page == Page.edit: EditPage {
                back => { page = Page.map; }
            }

            if page == Page.discovery: DiscoveryPage {
                back => { page = Page.map; }
                show-on-map(id, x, y) => {
                    Bridge.select(id);
                    page = Page.map;
                    canvas.centre-on(x, y);
                }
            }
        }

        // Status bar: how far a running scan has got, or the outcome of the last one; and on the
        // right, how far an AI download has got.
        Rectangle {
            height: Theme.status-height;
            background: Theme.surface;

            Rectangle {
                height: 1px;
                y: 0;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: Theme.space-l;
                padding-right: Theme.space-l;
                spacing: Theme.space-s;

                if Bridge.scanning: Spinner {
                    indeterminate: true;
                    width: 14px;
                }
                Text {
                    text: Labels.scan-status(Bridge.discovery, Bridge.scans, Bridge.count-all);
                    color: Theme.text;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if Bridge.ai-downloading: Text {
                    text: @tr("ai-download.status", Math.round(Bridge.ai-download-progress * 100));
                    color: Theme.text;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
                if Bridge.ai-downloading: VerticalLayout {
                    alignment: center;
                    ProgressIndicator {
                        progress: Bridge.ai-download-progress;
                        width: Theme.status-progress-width;
                    }
                }
                if Bridge.ai-downloading: VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("ai-settings.cancel");
                        clicked => { Bridge.cancel-ai-download(); }
                    }
                }
            }
        }
    }

    if Bridge.move-question.shown: MoveDialog {
        width: root.width;
        height: root.height;
    }
    if Bridge.unsaved-question: UnsavedDialog {
        width: root.width;
        height: root.height;
    }
    if Bridge.file-problem.kind != FileProblemKind.none: FileProblemDialog {
        width: root.width;
        height: root.height;
    }
    if Bridge.gpu-unsupported: GpuUnsupportedDialog {
        width: root.width;
        height: root.height;
    }
    if Bridge.ai-download-question: AiDownloadQuestion {
        width: root.width;
        height: root.height;
    }
    if Bridge.ai-download-outcome != InstallOutcome.none: AiDownloadOutcomeDialog {
        width: root.width;
        height: root.height;
    }
}
