import { Palette, Spinner } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Theme } from "theme.slint";
import { Header } from "header.slint";
import { Labels } from "labels.slint";
import { DeviceList } from "device-list.slint";
import { TopologyCanvas } from "topology-canvas.slint";
import { DetailsPanel } from "details-panel.slint";
import { EditPage } from "edit-page.slint";
import { Splitter } from "components/splitter.slint";

export { Bridge, Labels }

export component AppWindow inherits Window {
    title: @tr("app.title");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1000px;
    min-height: 600px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    // The design is light-only; without this, std-widgets follow a dark system theme.
    init => { Palette.color-scheme = ColorScheme.light; }

    // The edit page covers the map view rather than replacing it, so the map keeps its zoom and
    // pan while the page is open.
    property <bool> editing;
    // Panel widths the user dragged to; kept here so they survive leaving and reopening the
    // edit page.
    property <length> list-width: Theme.list-width;
    property <length> details-width: Theme.details-width;
    property <length> edit-list-width: Theme.list-width;
    property <length> edit-roles-width: Theme.edit-roles-width;

    VerticalLayout {
        Header { }

        Rectangle {
            vertical-stretch: 1;

            Rectangle {
                visible: !editing;

                HorizontalLayout {
                    // A narrow window squeezes the map first, then the panels down to their minimum.
                    list := DeviceList {
                        preferred-width: root.list-width;
                        min-width: Theme.panel-min-width;
                        horizontal-stretch: 0;
                        show-on-map(device) => { canvas.centre-on(device.x, device.y); }
                        edit => { editing = true; }
                    }
                    canvas := TopologyCanvas {
                        min-width: Theme.canvas-min-width;
                        horizontal-stretch: 1;
                    }
                    details := DetailsPanel {
                        preferred-width: root.details-width;
                        min-width: Theme.panel-min-width;
                        horizontal-stretch: 0;
                        edit => { editing = true; }
                    }
                }

                // Over the panel edges rather than in the layout, so they take no room from the map.
                Splitter {
                    x: list.width - self.width / 2;
                    size <=> root.list-width;
                    pane-width: list.width;
                    min-size: Theme.panel-min-width;
                    max-size: parent.width - details.width - Theme.canvas-min-width;
                }
                Splitter {
                    x: details.x - self.width / 2;
                    size <=> root.details-width;
                    pane-width: details.width;
                    min-size: Theme.panel-min-width;
                    max-size: parent.width - list.width - Theme.canvas-min-width;
                    pane-after: true;
                }
            }

            if editing: EditPage {
                list-width <=> root.edit-list-width;
                roles-width <=> root.edit-roles-width;
                back => { editing = false; }
            }
        }

        // Status bar: outcome of the last (simulated) scan.
        Rectangle {
            height: Theme.status-height;
            background: Theme.surface;

            Rectangle {
                height: 1px;
                y: 0;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: Theme.space-l;
                padding-right: Theme.space-l;
                spacing: Theme.space-s;

                if Bridge.scanning: Spinner {
                    indeterminate: true;
                    width: 14px;
                }
                Text {
                    text: Labels.scan-status(Bridge.scanning, Bridge.scans, Bridge.count-all, Bridge.count-offline);
                    color: Theme.text;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: @tr("status-bar.sample-only");
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
        }
    }
}
