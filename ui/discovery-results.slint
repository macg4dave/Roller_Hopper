import { Button, ListView } from "std-widgets.slint";
import { AiImportPhase, Bridge, DiscoveryPhase, FoundFilter, FoundSort } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { FoundColumns, FoundRow } from "components/found-row.slint";

component SortableHeading inherits Rectangle {
    in property <string> label;
    in property <FoundSort> column;
    in property <bool> resizable: true;
    callback resize(length);

    accessible-role: button;
    accessible-label: label;

    HorizontalLayout {
        spacing: Theme.space-xs;
        Text {
            text: root.label;
            font-size: Theme.font-small;
            font-weight: 600;
            color: Theme.text-muted;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if Bridge.discovery.sort == root.column: Text {
            text: Bridge.discovery.sort-descending ? "▼" : "▲";
            font-size: Theme.font-small;
            color: Theme.accent;
        }
    }

    click := TouchArea {
        mouse-cursor: pointer;
        clicked => { Bridge.sort-found(root.column); }
    }

    if root.resizable: resize-handle := TouchArea {
        x: root.width - self.width / 2;
        width: Theme.table-resize-hit-width;
        mouse-cursor: col-resize;
        moved => { root.resize(self.mouse-x - self.pressed-x); }
    }
}

// The hosts the discovery run found, each with its network cards, with filters for the ones
// worth a look.
export component DiscoveryResults inherits VerticalLayout {
    // Import with AI is loading the model or identifying hosts.
    property <bool> ai-busy: Bridge.discovery.ai-import == AiImportPhase.loading || Bridge.discovery.ai-import == AiImportPhase.identifying;
    spacing: Theme.space-s;

    HorizontalLayout {
        spacing: Theme.space-xs;
        for tab in [
            { filter: FoundFilter.all, label: @tr("discovery.filter.all"), count: Bridge.discovery.count-all },
            { filter: FoundFilter.new, label: @tr("discovery.filter.new"), count: Bridge.discovery.count-new },
            { filter: FoundFilter.unidentified, label: @tr("discovery.filter.unidentified"), count: Bridge.discovery.count-unidentified },
            { filter: FoundFilter.duplicates, label: @tr("discovery.filter.duplicates"), count: Bridge.discovery.count-duplicates },
        ]: Button {
            text: @tr("filter.button", tab.label, tab.count);
            primary: Bridge.discovery.filter == tab.filter;
            clicked => { Bridge.set-found-filter(tab.filter); }
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: Labels.ai-import(Bridge.discovery);
            font-size: Theme.font-small;
            color: Bridge.discovery.ai-import == AiImportPhase.failed || Bridge.discovery.ai-import == AiImportPhase.no-model
                ? Theme.warning : Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            horizontal-alignment: right;
        }
        Button {
            text: @tr("discovery.import" | "discovery.import.plural" % Bridge.discovery.importable);
            icon: @image-url("icons/plus.svg");
            colorize-icon: true;
            enabled: Bridge.discovery.importable > 0 && !root.ai-busy;
            clicked => { Bridge.import-found(); }
        }
        Button {
            text: root.ai-busy ? @tr("discovery.ai-import.stop") : @tr("discovery.ai-import");
            icon: root.ai-busy ? @image-url("icons/stop.svg") : @image-url("icons/plus.svg");
            colorize-icon: true;
            enabled: root.ai-busy || (Bridge.discovery.importable > 0 && Bridge.discovery.phase != DiscoveryPhase.running);
            clicked => {
                if root.ai-busy {
                    Bridge.stop-ai-import();
                } else {
                    Bridge.import-found-with-ai();
                }
            }
        }
    }

    // Column headings, padded and spaced like FoundRow so they sit over their columns.
    VerticalLayout {
        spacing: Theme.space-xs;
        vertical-stretch: 0;
        HorizontalLayout {
            padding-left: Theme.space-s;
            padding-right: Theme.space-s + Theme.scrollbar-width;
            spacing: Theme.space-m;
            Rectangle { width: FoundColumns.icon; }
            SortableHeading {
                label: @tr("discovery.column.name");
                column: FoundSort.name;
                horizontal-stretch: 1;
                resize(delta) => {
                    FoundColumns.ip = clamp(FoundColumns.ip - delta,
                        Theme.table-column-min-width, Theme.table-column-max-width);
                }
            }
            SortableHeading {
                label: @tr("details.ip");
                column: FoundSort.ip;
                width: FoundColumns.ip;
                resize(delta) => {
                    let change = clamp(delta,
                        Theme.table-column-min-width - FoundColumns.ip,
                        FoundColumns.mac - Theme.table-column-min-width);
                    FoundColumns.ip += change;
                    FoundColumns.mac -= change;
                }
            }
            SortableHeading {
                label: @tr("details.mac");
                column: FoundSort.mac;
                width: FoundColumns.mac;
                resize(delta) => {
                    let change = clamp(delta,
                        Theme.table-column-min-width - FoundColumns.mac,
                        FoundColumns.role - Theme.table-column-min-width);
                    FoundColumns.mac += change;
                    FoundColumns.role -= change;
                }
            }
            SortableHeading {
                label: @tr("details.role");
                column: FoundSort.role;
                width: FoundColumns.role;
                resizable: false;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
    }

    if Bridge.found.length == 0: Text {
        text: Bridge.discovery.phase == DiscoveryPhase.idle ? @tr("discovery.empty.idle") : @tr("discovery.empty.none");
        font-size: Theme.font-body;
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: top;
        vertical-stretch: 1;
    }

    if Bridge.found.length > 0: ListView {
        vertical-stretch: 1;
        for found in Bridge.found: FoundRow { found: found; }
    }
}
