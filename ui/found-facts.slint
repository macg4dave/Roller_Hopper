import { FoundView } from "bridge.slint";
import { Labels } from "labels.slint";
import { Theme } from "theme.slint";
import { Chip } from "components/chip.slint";
import { DetailField } from "components/detail-field.slint";

// What a discovery run found out about a host that its editor does not show: what it is, and
// how it was found. Read-only, under the role in the discovery details' editor. Its addresses
// and open ports are on its cards.
export component FoundFacts inherits VerticalLayout {
    in property <FoundView> found;

    spacing: Theme.space-xs;

    DetailField { label: @tr("details.type"); value: Labels.kind(found.kind); }
    if found.manufacturer != "": DetailField { label: @tr("details.manufacturer"); value: found.manufacturer; }
    if found.model != "": DetailField { label: @tr("details.model"); value: found.model; }
    if found.hostname != "": DetailField { label: @tr("details.hostname"); value: found.hostname; }
    DetailField {
        label: @tr("discovery.found-by");
        HorizontalLayout {
            padding-top: 7px;
            alignment: start;
            spacing: Theme.space-xs;
            for method in found.methods: Chip { text: Labels.method(method); }
        }
    }
    if found.duplicate-of != "": DetailField {
        label: @tr("discovery.same-mac-as");
        value: Labels.device-name(found.duplicate-of);
    }
}
