import { Button } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Dialog } from "components/dialog.slint";

// Asks before a network card becomes a child of another parent when that would remove the
// device, or found host, it leaves.
export component MoveDialog inherits Dialog {
    property <bool> found: Bridge.move-question.found;

    title: @tr("move.title");
    message: found
        ? @tr("move.question-found", Bridge.move-question.card, Bridge.move-question.from, Bridge.move-question.to)
        : @tr("move.question", Bridge.move-question.card, Bridge.move-question.from, Bridge.move-question.to);

    Button {
        text: @tr("edit.cancel");
        clicked => { Bridge.cancel-move(); }
    }
    Button {
        text: @tr("move.confirm");
        primary: true;
        clicked => { Bridge.confirm-move(); }
    }
}
