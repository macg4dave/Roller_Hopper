// Translatable text derived from data. No wording lives in .slint files: every @tr() takes a
// message key, and the text for each language (English included) is in translations/.
import { DeviceKind, DeviceStatus, GroupColour, GuestKind, RoleKind } from "bridge.slint";

export global Labels {
    // False when no bundled language matched the system locale, so keys would show as-is.
    public pure function has-language() -> bool {
        return @tr("app.title") != "app.title";
    }

    public pure function kind(kind: DeviceKind) -> string {
        if kind == DeviceKind.router { return @tr("kind.router"); }
        if kind == DeviceKind.switch { return @tr("kind.switch"); }
        if kind == DeviceKind.access-point { return @tr("kind.access-point"); }
        if kind == DeviceKind.nas { return @tr("kind.nas"); }
        if kind == DeviceKind.desktop { return @tr("kind.desktop"); }
        if kind == DeviceKind.laptop { return @tr("kind.laptop"); }
        if kind == DeviceKind.server { return @tr("kind.server"); }
        if kind == DeviceKind.printer { return @tr("kind.printer"); }
        if kind == DeviceKind.phone { return @tr("kind.phone"); }
        if kind == DeviceKind.tv { return @tr("kind.tv"); }
        if kind == DeviceKind.console { return @tr("kind.console"); }
        if kind == DeviceKind.camera { return @tr("kind.camera"); }
        if kind == DeviceKind.smart { return @tr("kind.smart"); }
        return @tr("kind.unknown");
    }

    // Standard roles only; custom roles are the user's own words and are shown as typed.
    // Rust calls this to build the role dropdown, which needs a ready-made list of strings.
    public pure function role(role: RoleKind) -> string {
        if role == RoleKind.router { return @tr("role.router"); }
        if role == RoleKind.switch { return @tr("role.switch"); }
        if role == RoleKind.access-point { return @tr("role.access-point"); }
        if role == RoleKind.server { return @tr("role.server"); }
        if role == RoleKind.nas { return @tr("role.nas"); }
        if role == RoleKind.desktop { return @tr("role.desktop"); }
        if role == RoleKind.laptop { return @tr("role.laptop"); }
        if role == RoleKind.phone { return @tr("role.phone"); }
        if role == RoleKind.printer { return @tr("role.printer"); }
        if role == RoleKind.camera { return @tr("role.camera"); }
        if role == RoleKind.iot { return @tr("role.iot"); }
        return @tr("role.other");
    }

    public pure function status(status: DeviceStatus) -> string {
        if status == DeviceStatus.online { return @tr("status.online"); }
        if status == DeviceStatus.offline { return @tr("status.offline"); }
        return @tr("status.unknown");
    }

    // A cleared name still leaves something to read and click.
    public pure function device-name(name: string) -> string {
        return name == "" ? @tr("device.unnamed") : name;
    }

    public pure function last-seen(minutes: int) -> string {
        if minutes <= 0 { return @tr("last-seen.now"); }
        if minutes < 60 { return @tr("last-seen.minutes" | "last-seen.minutes.plural" % minutes); }
        if minutes < 1440 {
            let hours = Math.floor(minutes / 60);
            return @tr("last-seen.hours" | "last-seen.hours.plural" % hours);
        }
        let days = Math.floor(minutes / 1440);
        return @tr("last-seen.days" | "last-seen.days.plural" % days);
    }

    // First in the role group dropdown. Rust calls this to build that list.
    public pure function no-group() -> string {
        return @tr("groups.none");
    }

    // First in the dropdown of what a network card is plugged into. Rust calls this to build
    // that list.
    public pure function no-link() -> string {
        return @tr("edit.card-no-link");
    }

    public pure function group-colour(colour: GroupColour) -> string {
        if colour == GroupColour.red { return @tr("groups.colour.red"); }
        if colour == GroupColour.orange { return @tr("groups.colour.orange"); }
        if colour == GroupColour.yellow { return @tr("groups.colour.yellow"); }
        if colour == GroupColour.green { return @tr("groups.colour.green"); }
        if colour == GroupColour.blue { return @tr("groups.colour.blue"); }
        if colour == GroupColour.purple { return @tr("groups.colour.purple"); }
        return @tr("groups.colour.none");
    }

    public pure function guest-kind(kind: GuestKind) -> string {
        if kind == GuestKind.container { return @tr("guest.container"); }
        return @tr("guest.virtual-machine");
    }

    // A guest's line under its name on the edit page: what it runs as, and its address.
    public pure function guest-summary(kind: GuestKind, ip: string) -> string {
        return ip == "" ? guest-kind(kind) : @tr("edit.guest-summary", guest-kind(kind), ip);
    }

    // The device a guest runs on, and what it runs as.
    public pure function runs-on(host-name: string, kind: GuestKind) -> string {
        if kind == GuestKind.container { return @tr("runs-on.container", device-name(host-name)); }
        return @tr("runs-on.virtual-machine", device-name(host-name));
    }

    public pure function uplink(name: string, inferred: bool) -> string {
        return inferred ? @tr("uplink.inferred", device-name(name)) : @tr("uplink.known", device-name(name));
    }

    // A network card's name; a card the user has not named is numbered by its place, from 0.
    public pure function card-name(name: string, index: int) -> string {
        return name == "" ? @tr("card.unnamed", index + 1) : name;
    }

    // Under a device's name in the lists: its first address and how many network cards its
    // group holds.
    public pure function group-summary(ip: string, cards: int) -> string {
        let count = @tr("list.cards" | "list.cards.plural" % cards);
        return ip == "" ? count : @tr("list.group-summary", ip, count);
    }

    // A network card's short name on the map: its own name, or NC and its number.
    public pure function card-short(name: string, index: int) -> string {
        return name == "" ? @tr("card.short", index + 1) : name;
    }

    // The subheading under a card's device name on the map: its short name and its address.
    public pure function card-label(name: string, index: int, ip: string) -> string {
        return ip == "" ? card-short(name, index) : @tr("card.label", card-short(name, index), ip);
    }

    // A device's card, named for something to plug into, or read out by a screen reader. Just
    // the device for a device with one card (index -1). Rust calls this to build the "plugged
    // into" dropdown.
    public pure function card-of(device: string, card: string, index: int) -> string {
        return index < 0 ? device-name(device) : @tr("card.of", device-name(device), card-name(card, index));
    }

    // Where a network card is plugged in (see CardView), or that it is plugged in nowhere.
    public pure function plugged-into(via-name: string, via-card: string, via-index: int, inferred: bool) -> string {
        return via-name == "" ? no-link() : uplink(card-of(via-name, via-card, via-index), inferred);
    }

    // A network card's address, and where it is plugged in, if anywhere.
    public pure function card(ip: string, via-name: string, via-card: string, via-index: int, inferred: bool) -> string {
        let address = ip == "" ? @tr("card.no-address") : ip;
        return via-name == "" ? address : @tr("details.card.value", address, plugged-into(via-name, via-card, via-index, inferred));
    }

    public pure function scan-status(scanning: bool, scans: int, devices: int, offline: int) -> string {
        if scanning { return @tr("scan.running"); }
        let summary = @tr("scan.devices" | "scan.devices.plural" % devices);
        return scans == 0 ? @tr("scan.loaded", summary, offline) : @tr("scan.complete", summary, offline);
    }
}
