import { Button, ComboBox, ProgressIndicator, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Note, SectionTitle } from "ai-text.slint";

// How the last answer ended, if one finished since the window opened.
export enum AnswerEnd { none, complete, limit, stopped }

// Trying the loaded model: the prompt and evidence to send, Run and Stop, and its answer with
// how long it was and how long it took.
export component AiTrial inherits VerticalLayout {
    in-out property <string> prompt;
    in-out property <string> input;
    in-out property <int> evidence-index;
    in-out property <int> task-index;
    in property <string> output;
    in property <bool> can-run;
    in property <bool> running;
    in property <int> answer-tokens;
    in property <float> answer-seconds;
    in property <int> prompt-tokens;
    in property <float> first-token-seconds;
    in property <AnswerEnd> answer-end;

    callback run(int, string, string);
    callback stop();
    callback restore-texts();
    callback select-evidence(int);

    spacing: Theme.space-s;

    pure function end-text(end: AnswerEnd) -> string {
        if end == AnswerEnd.limit { return @tr("ai-settings.end-limit"); }
        if end == AnswerEnd.stopped { return @tr("ai-settings.end-stopped"); }
        return "";
    }

    // Seconds to one decimal place.
    pure function tenths(value: float) -> string {
        return Math.round(value * 10) / 10;
    }

    SectionTitle { text: @tr("ai-settings.prompt"); }
    HorizontalLayout {
        spacing: Theme.space-s;
        Text {
            text: @tr("ai-settings.task");
            color: Theme.text;
            vertical-alignment: center;
        }
        task-picker := ComboBox {
            horizontal-stretch: 1;
            model: [
                @tr("ai-settings.task-identify"),
                @tr("ai-settings.task-type"),
                @tr("ai-settings.task-os"),
                @tr("ai-settings.task-description"),
                @tr("ai-settings.task-conflicts")
            ];
            current-index <=> root.task-index;
            enabled: !root.running;
        }
    }
    TextEdit {
        text <=> root.prompt;
        wrap: word-wrap;
        vertical-stretch: 3;
    }

    HorizontalLayout {
        spacing: Theme.space-s;
        SectionTitle {
            text: @tr("ai-settings.input");
            horizontal-stretch: 1;
        }
        evidence-picker := ComboBox {
            model: [
                @tr("ai-settings.evidence.truenas"),
                @tr("ai-settings.evidence.windows-server"),
                @tr("ai-settings.evidence.router"),
                @tr("ai-settings.evidence.printer"),
                @tr("ai-settings.evidence.access-point"),
                @tr("ai-settings.evidence.linux-pc"),
                @tr("ai-settings.evidence.smart-tv"),
                @tr("ai-settings.evidence.doorbell"),
                @tr("ai-settings.evidence.cheap-camera"),
                @tr("ai-settings.evidence.unknown")
            ];
            current-index <=> root.evidence-index;
            enabled: !root.running;
            selected(value) => {
                root.select-evidence(evidence-picker.current-index);
            }
        }
    }
    TextEdit {
        text <=> root.input;
        wrap: word-wrap;
        vertical-stretch: 3;
    }

    HorizontalLayout {
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        spacing: Theme.space-s;
        Button {
            text: @tr("ai-settings.run");
            icon: @image-url("icons/play.svg");
            colorize-icon: true;
            primary: true;
            enabled: root.can-run && !root.running;
            clicked => { root.run(root.task-index, root.prompt, root.input); }
        }
        Button {
            text: @tr("ai-settings.stop");
            icon: @image-url("icons/stop.svg");
            colorize-icon: true;
            enabled: root.running;
            clicked => { root.stop(); }
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: @tr("ai-settings.restore-texts");
            enabled: !running;
            clicked => { root.restore-texts(); }
        }
    }

    SectionTitle { text: @tr("ai-settings.output"); }
    if running: ProgressIndicator { indeterminate: true; }
    // Not a TextEdit, whose view jumps back to its cursor each time the answer grows. This
    // stays where the user scrolled it, following the answer's end while scrolled to the
    // bottom; the text can still be selected and copied.
    Rectangle {
        vertical-stretch: 3;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius;

        output-view := ScrollView {
            property <bool> follow: true;

            x: Theme.space-s;
            width: parent.width - 2 * Theme.space-s;
            scrolled => {
                self.follow = self.content-y <= self.visible-height - self.content-height + 1px;
            }

            VerticalLayout {
                width: output-view.visible-width;
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;
                TextInput {
                    text: root.output;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    color: Theme.text;
                    changed text => {
                        if self.text == "" {
                            output-view.follow = true;
                        } else if output-view.follow {
                            output-view.content-y = min(0px, output-view.visible-height - output-view.content-height);
                        }
                    }
                }
            }
        }
    }
    if answer-end != AnswerEnd.none && !running: Note {
        text: @tr("ai-settings.answer-stats" | "ai-settings.answer-stats.plural" % answer-tokens, tenths(answer-seconds), tenths(answer-seconds > 0 ? answer-tokens / answer-seconds : 0));
    }
    if answer-end != AnswerEnd.none && !running: Note {
        text: @tr("ai-settings.prompt-stats" | "ai-settings.prompt-stats.plural" % prompt-tokens);
    }
    // No time to show when the answer ended before its first token.
    if answer-end != AnswerEnd.none && answer-tokens > 0 && !running: Note {
        text: @tr("ai-settings.first-token", tenths(first-token-seconds));
    }
    if answer-end != AnswerEnd.none && answer-end != AnswerEnd.complete && !running: Text {
        text: end-text(answer-end);
        color: Theme.warning;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
}
