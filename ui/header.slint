import { Button } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Theme } from "theme.slint";

// Title, the project file (its name, an unsaved mark, New, Open, Save and Save as), Scan and
// Settings. Search and the edit page are reached from the device list.
export component Header inherits Rectangle {
    // Scan was clicked: the discovery page is wanted.
    callback scan();
    // The AI settings window is wanted.
    callback ai-settings();

    height: Theme.header-height;
    background: Theme.surface;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: Theme.space-l;
        padding-right: Theme.space-l;
        padding-top: Theme.space-s;
        padding-bottom: Theme.space-s;
        spacing: Theme.space-m;

        Image {
            source: @image-url("icons/logo.svg");
            colorize: Theme.accent;
            width: 24px;
        }
        Text {
            text: @tr("app.title");
            font-size: Theme.font-title;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        // The file's name is the user's own, shown as given.
        Text {
            property <string> name: Bridge.project-name == "" ? @tr("project.untitled") : Bridge.project-name;
            text: Bridge.unsaved ? @tr("header.project-unsaved", name) : name;
            font-size: Theme.font-body;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // A new project or another one waits until a scan ends.
        Button {
            text: @tr("header.new");
            enabled: !Bridge.scanning;
            clicked => { Bridge.new-project(); }
        }
        Button {
            text: @tr("header.open");
            enabled: !Bridge.scanning;
            clicked => { Bridge.open-project(); }
        }
        Button {
            text: @tr("header.save");
            clicked => { Bridge.save-project(); }
        }
        Button {
            text: @tr("header.save-as");
            clicked => { Bridge.save-project-as(); }
        }

        Button {
            text: Bridge.scanning ? @tr("header.scanning") : @tr("header.scan");
            // Wide enough for both labels, so the buttons do not shift during a scan.
            min-width: 120px;
            icon: @image-url("icons/scan.svg");
            colorize-icon: true;
            clicked => { root.scan(); }
        }
        Button {
            text: @tr("header.settings");
            icon: @image-url("icons/settings.svg");
            colorize-icon: true;
            clicked => { settings-popup.show(); }
        }
    }

    settings-popup := PopupWindow {
        x: root.width - self.width - Theme.space-l;
        y: root.height - Theme.space-xs;
        width: 260px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius;
            drop-shadow-blur: 12px;
            drop-shadow-color: #0000001f;

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;
                Text {
                    text: @tr("settings.title");
                    font-size: Theme.font-heading;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: @tr("settings.map-display-moved");
                    font-size: Theme.font-body;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                Button {
                    text: @tr("settings.ai");
                    clicked => {
                        settings-popup.close();
                        root.ai-settings();
                    }
                }
            }
        }
    }
}
