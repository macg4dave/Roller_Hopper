import { Button, LineEdit, ListView } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Theme } from "theme.slint";
import { NameBox } from "components/name-box.slint";
import { ColourPicker } from "components/colour-picker.slint";
import { LineStylePicker } from "components/line-style-picker.slint";

// Edit page, above the roles: the groups roles can be sorted into, with a way to add one.
export component GroupEditor inherits VerticalLayout {
    property <bool> adding;

    spacing: Theme.space-m;

    Text {
        text: @tr("groups.title");
        font-size: Theme.font-heading;
        font-weight: 600;
        color: Theme.text;
    }
    Text {
        text: @tr("groups.intro");
        font-size: Theme.font-body;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    ListView {
        // As tall as its rows, up to a few, so the roles below keep most of the height.
        height: min(Bridge.groups.length, 4) * Theme.row-height;
        // Groups are identified to Rust by their index in Bridge.groups.
        for group[i] in Bridge.groups: Rectangle {
            height: Theme.row-height;
            border-radius: Theme.radius;
            background: Math.mod(i, 2) == 1 ? Theme.stripe : transparent;

            HorizontalLayout {
                padding-left: Theme.space-s;
                padding-right: Theme.space-s;
                spacing: Theme.space-m;
                VerticalLayout {
                    alignment: center;
                    width: 180px;
                    NameBox {
                        name: group.name;
                        field-label: @tr("groups.name");
                        commit(text) => { Bridge.rename-group(i, text); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    // Takes the spare width, so the delete button sits at the far right.
                    horizontal-stretch: 1;
                    ColourPicker {
                        selected: group.colour;
                        picked(colour) => { Bridge.set-group-colour(i, colour); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    LineStylePicker {
                        selected: group.line-style;
                        colour: group.colour;
                        picked(style) => { Bridge.set-group-line-style(i, style); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        icon: @image-url("icons/delete.svg");
                        colorize-icon: true;
                        accessible-label: @tr("groups.delete");
                        clicked => { Bridge.delete-group(i); }
                    }
                }
            }
        }
    }
    if !adding: HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("groups.add");
            icon: @image-url("icons/plus.svg");
            colorize-icon: true;
            clicked => { adding = true; }
        }
    }
    if adding: HorizontalLayout {
        alignment: start;
        spacing: Theme.space-xs;
        name := LineEdit {
            width: 260px;
            placeholder-text: @tr("groups.new");
            init => { self.focus(); }
            accepted(text) => {
                Bridge.add-group(text);
                adding = false;
            }
        }
        Button {
            text: @tr("groups.confirm-add");
            primary: true;
            enabled: name.text != "";
            clicked => {
                Bridge.add-group(name.text);
                adding = false;
            }
        }
        Button {
            icon: @image-url("icons/close.svg");
            colorize-icon: true;
            accessible-label: @tr("groups.cancel");
            clicked => { adding = false; }
        }
    }
}
