// Design tokens. Every colour and size used by the UI comes from here.
import { GroupColour } from "bridge.slint";

export global Theme {
    // A group's colour, strong enough for line art on white; `otherwise` when it has none.
    public pure function group-colour(colour: GroupColour, otherwise: color) -> color {
        if colour == GroupColour.red { return #c42b1c; }
        if colour == GroupColour.orange { return #ca5010; }
        if colour == GroupColour.yellow { return #b58900; }
        if colour == GroupColour.green { return #107c10; }
        if colour == GroupColour.blue { return #0063b1; }
        if colour == GroupColour.purple { return #8764b8; }
        return otherwise;
    }

    // A pale wash of a group's colour, behind its devices' rows.
    public pure function group-tint(colour: GroupColour) -> color {
        if colour == GroupColour.red { return #fbeceb; }
        if colour == GroupColour.orange { return #fcefe6; }
        if colour == GroupColour.yellow { return #fbf5dc; }
        if colour == GroupColour.green { return #e8f4e8; }
        if colour == GroupColour.blue { return #e5f0fa; }
        if colour == GroupColour.purple { return #f1edf8; }
        return transparent;
    }

    // Surfaces
    out property <color> background: #f7f8fa;
    out property <color> surface: #ffffff;
    out property <color> border: #e3e6eb;
    out property <color> hover: #f1f3f6;
    out property <color> grid: #eceff3;
    // Every other row of a table, so each line is easy to follow.
    out property <color> stripe: #f4f6f9;

    // Text and line art
    out property <color> text: #1f2328;
    out property <color> text-muted: #6b7280;
    out property <color> icon: #2b3440;
    out property <color> icon-faded: #a3a9b1;
    out property <color> line: #9aa3af;

    // Accent and status
    out property <color> accent: #1a66d8;
    out property <color> accent-soft: #e8f0fd;
    out property <color> online: #22a447;
    out property <color> offline: #a3a9b1;
    out property <color> unknown: #e0a100;

    // Spacing and shape
    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> radius: 6px;
    out property <length> line-width: 1.25px;
    // A slack strand to a dragged device; it thins to line-width as it stretches.
    out property <length> strand-width: 3px;
    // The small circle at the foot of each device's trunk.
    out property <length> root-size: 8px;
    // The blob where a strand joins a line, at its largest (slack); it shrinks as it stretches.
    out property <length> blob-size: 12px;

    // Typography
    out property <length> font-small: 11px;
    out property <length> font-body: 13px;
    out property <length> font-heading: 15px;
    out property <length> font-title: 18px;

    // Panels and map
    out property <length> header-height: 52px;
    out property <length> status-height: 30px;
    // Starting widths of the resizable panels, and the least each may be dragged to.
    out property <length> list-width: 290px;
    out property <length> details-width: 340px;
    out property <length> edit-roles-width: 600px;
    out property <length> panel-min-width: 220px;
    out property <length> canvas-min-width: 320px;
    out property <length> edit-fields-min-width: 300px;
    // Room for a role row's columns, so they never squeeze together.
    out property <length> edit-roles-min-width: 500px;
    out property <length> splitter-width: 8px;
    // The std-widgets scroll bar floats over a list's right edge; rows keep this much clear.
    out property <length> scrollbar-width: 14px;
    out property <length> row-height: 52px;
    out property <length> map-icon: 36px;
    out property <length> map-label-width: 130px;
    out property <length> grid-spacing: 32px;
}
