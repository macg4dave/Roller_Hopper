// Design tokens. Every colour and size used by the UI comes from here.

export global Theme {
    // Surfaces
    out property <color> background: #f7f8fa;
    out property <color> surface: #ffffff;
    out property <color> border: #e3e6eb;
    out property <color> hover: #f1f3f6;
    out property <color> grid: #eceff3;

    // Text and line art
    out property <color> text: #1f2328;
    out property <color> text-muted: #6b7280;
    out property <color> icon: #2b3440;
    out property <color> icon-faded: #a3a9b1;
    out property <color> line: #9aa3af;

    // Accent and status
    out property <color> accent: #1a66d8;
    out property <color> accent-soft: #e8f0fd;
    out property <color> online: #22a447;
    out property <color> offline: #a3a9b1;
    out property <color> unknown: #e0a100;

    // Spacing and shape
    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> radius: 6px;
    out property <length> line-width: 1.25px;

    // Typography
    out property <length> font-small: 11px;
    out property <length> font-body: 13px;
    out property <length> font-heading: 15px;
    out property <length> font-title: 18px;

    // Panels and map
    out property <length> header-height: 52px;
    out property <length> status-height: 30px;
    out property <length> list-width: 290px;
    out property <length> details-width: 340px;
    out property <length> row-height: 52px;
    out property <length> map-icon: 36px;
    out property <length> map-label-width: 130px;
    out property <length> grid-spacing: 32px;
}
