import { Button } from "std-widgets.slint";
import { Bridge } from "bridge.slint";
import { Theme } from "theme.slint";
import { ViewOptions } from "view-options.slint";
import { JoinBlob } from "components/join-blob.slint";
import { MapNode } from "components/map-node.slint";

// The pannable, zoomable topology map. Pan and zoom are visual state and live here.
export component TopologyCanvas inherits Rectangle {
    // Where the view is heading; zoom and pan below glide towards these.
    property <float> target-zoom: 1;
    property <length> target-pan-x;
    property <length> target-pan-y;
    // Zoom and pan glide together with the same timing, so the point under the cursor stays put.
    property <bool> glide;
    property <float> zoom: target-zoom;
    property <length> pan-x: target-pan-x;
    property <length> pan-y: target-pan-y;
    animate zoom, pan-x, pan-y {
        duration: glide ? 160ms : 0ms;
        easing: ease-out;
    }
    // Keep fitting the map to the view on resize until the user pans or zooms by hand.
    property <bool> auto-fit: true;
    property <length> grid: Theme.grid-spacing * zoom;

    background: Theme.background;
    clip: true;

    changed width => { if auto-fit { fit(false); } }
    changed height => { if auto-fit { fit(false); } }

    function fit(animated: bool) {
        let b = Bridge.bounds;
        let margin = 24px;
        let new-zoom = clamp(min((root.width - 2 * margin) / (b.width * 1px), (root.height - 2 * margin) / (b.height * 1px)), 0.25, 1.25);
        glide = animated;
        target-pan-x = (root.width - b.width * new-zoom * 1px) / 2 - b.x * new-zoom * 1px;
        target-pan-y = (root.height - b.height * new-zoom * 1px) / 2 - b.y * new-zoom * 1px;
        target-zoom = new-zoom;
        auto-fit = true;
    }

    // Glides the map so the point (x, y), in map units, sits in the centre of the view.
    public function centre-on(x: float, y: float) {
        glide = true;
        target-pan-x = root.width / 2 - x * target-zoom * 1px;
        target-pan-y = root.height / 2 - y * target-zoom * 1px;
        auto-fit = false;
    }

    // Zooms by `factor`, keeping the map point under (px, py) in place.
    function zoom-at(px: length, py: length, factor: float) {
        let new-zoom = clamp(target-zoom * factor, 0.25, 3);
        glide = true;
        target-pan-x = px - (px - target-pan-x) * new-zoom / target-zoom;
        target-pan-y = py - (py - target-pan-y) * new-zoom / target-zoom;
        target-zoom = new-zoom;
        auto-fit = false;
    }

    // Subtle grid that moves with the map.
    for i in Math.ceil(root.width / grid) + 1: Rectangle {
        x: Math.mod(pan-x, grid) + i * grid - grid;
        width: 1px;
        background: Theme.grid;
    }
    for i in Math.ceil(root.height / grid) + 1: Rectangle {
        y: Math.mod(pan-y, grid) + i * grid - grid;
        height: 1px;
        background: Theme.grid;
    }

    pan := TouchArea {
        property <length> start-x;
        property <length> start-y;
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                start-x = target-pan-x;
                start-y = target-pan-y;
            }
        }
        moved => {
            // Dragging follows the pointer exactly; gliding here would feel like lag.
            glide = false;
            target-pan-x = start-x + self.mouse-x - self.pressed-x;
            target-pan-y = start-y + self.mouse-y - self.pressed-y;
            auto-fit = false;
        }
        scroll-event(event) => {
            // A wheel notch arrives as 60px; touchpads send many small deltas, which zoom in
            // proportion instead of each counting as a full step.
            zoom-at(self.mouse-x, self.mouse-y, Math.pow(1.15, event.delta-y / 60px));
            accept
        }
    }

    // The map itself, laid out in map units and scaled as one picture: panning and zooming only
    // move this one element, so nothing inside is laid out or redrawn from scratch.
    Rectangle {
        x: pan-x + Bridge.bounds.x * zoom * 1px;
        y: pan-y + Bridge.bounds.y * zoom * 1px;
        width: Bridge.bounds.width * 1px;
        height: Bridge.bounds.height * 1px;
        transform-origin: { x: 0, y: 0 };
        transform-scale: zoom;

        // Connection lines: one path per colour and style.
        for set in Bridge.lines: Path {
            width: parent.width;
            height: parent.height;
            viewbox-x: Bridge.bounds.x;
            viewbox-y: Bridge.bounds.y;
            viewbox-width: Bridge.bounds.width;
            viewbox-height: Bridge.bounds.height;
            commands: set.commands;
            opacity: set.inferred ? Theme.inferred-opacity : 1;
            stroke: set.selected ? Theme.accent : Theme.group-colour(set.colour, Theme.line);
            // Keep lines thin on screen at any zoom.
            stroke-width: (set.thick ? Theme.line-width-thick : Theme.line-width) / zoom;
        }

        // Root circles at the foot of each trunk, drawn like the device's lines.
        for device in Bridge.devices: Rectangle {
            visible: device.has-root;
            x: (device.x - Bridge.bounds.x) * 1px - self.width / 2;
            y: (device.root-y - Bridge.bounds.y) * 1px - self.height / 2;
            width: Theme.root-size;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.background;
            border-width: Theme.line-width / zoom;
            border-color: device.id == Bridge.selected-id ? Theme.accent : Theme.group-colour(device.colour, Theme.line);
            opacity: device.dimmed ? 0.3 : 1;
        }

        if Bridge.strand.commands != "": Path {
            width: parent.width;
            height: parent.height;
            viewbox-x: Bridge.bounds.x;
            viewbox-y: Bridge.bounds.y;
            viewbox-width: Bridge.bounds.width;
            viewbox-height: Bridge.bounds.height;
            commands: Bridge.strand.commands;
            stroke: Theme.accent;
            stroke-width: (Theme.strand-width + (Theme.line-width - Theme.strand-width) * Bridge.strand.pull) / zoom;
        }

        JoinBlob {
            strand: Bridge.strand;
            origin-x: Bridge.bounds.x;
            origin-y: Bridge.bounds.y;
        }

        for device in Bridge.devices: MapNode {
            device: device;
            zoom: zoom;
            selected: device.id == Bridge.selected-id;
            x: (device.x - Bridge.bounds.x) * 1px - self.width / 2;
            y: (device.y - Bridge.bounds.y) * 1px - (self.icon-size + 14px) / 2;
            clicked => { Bridge.select(device.id); }
            // The pointer offset arrives already in map units, as the node sits inside the scale.
            dragged(dx, dy) => {
                Bridge.move-device(device.id, device.x + dx / 1px, device.y + dy / 1px);
                auto-fit = false;
            }
            released => { Bridge.drop-device(); }
        }
    }

    // Legend for known and inferred links; line styles belong to groups and are not listed.
    Rectangle {
        x: Theme.space-l;
        y: root.height - self.height - Theme.space-l;
        width: legend.preferred-width;
        height: legend.preferred-height;
        background: Theme.surface;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius;

        legend := HorizontalLayout {
            padding: Theme.space-s;
            spacing: Theme.space-s;
            for entry in [
                { label: @tr("legend.known"), opacity: 1 },
                { label: @tr("legend.inferred"), opacity: Theme.inferred-opacity },
            ]: HorizontalLayout {
                spacing: Theme.space-xs;
                Path {
                    width: 24px;
                    height: 10px;
                    viewbox-width: 24;
                    viewbox-height: 10;
                    commands: "M 0 5 L 24 5";
                    opacity: entry.opacity;
                    stroke: Theme.line;
                    stroke-width: Theme.line-width;
                }
                Text {
                    text: entry.label;
                    font-size: Theme.font-small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }
    }

    // What the devices are labelled with.
    ViewOptions {
        x: root.width - self.width - Theme.space-l;
        y: Theme.space-l;
    }

    // Zoom and layout controls.
    Rectangle {
        x: Theme.space-l;
        y: Theme.space-l;
        width: controls.preferred-width;
        height: controls.preferred-height;
        background: Theme.surface;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius;

        controls := VerticalLayout {
            padding: Theme.space-xs;
            spacing: Theme.space-xs;
            Button {
                icon: @image-url("icons/plus.svg");
                colorize-icon: true;
                accessible-label: @tr("map.zoom-in");
                clicked => { zoom-at(root.width / 2, root.height / 2, 1.25); }
            }
            Text {
                text: @tr("map.zoom-percent", Math.round(target-zoom * 100));
                font-size: Theme.font-small;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
            Button {
                icon: @image-url("icons/minus.svg");
                colorize-icon: true;
                accessible-label: @tr("map.zoom-out");
                clicked => { zoom-at(root.width / 2, root.height / 2, 1 / 1.25); }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Button {
                icon: @image-url("icons/fit.svg");
                colorize-icon: true;
                accessible-label: @tr("map.fit");
                clicked => { fit(true); }
            }
            Button {
                icon: @image-url("icons/reset-layout.svg");
                colorize-icon: true;
                accessible-label: @tr("map.reset-layout");
                clicked => {
                    Bridge.reset-layout();
                    fit(true);
                }
            }
        }
    }
}
