import { Button } from "std-widgets.slint";
import { Bridge } from "bridge.slint";

// Map edit mode's Add button. The ordinary device it adds is selected for the sidebar to fill in.
export component AddMenu inherits HorizontalLayout {
    alignment: start;

    Button {
        text: @tr("edit.add");
        icon: @image-url("icons/plus.svg");
        colorize-icon: true;
        clicked => { Bridge.add-device(); }
    }
}
