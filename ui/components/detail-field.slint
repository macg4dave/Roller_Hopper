import { Theme } from "../theme.slint";

// A labelled row in the details panel. Put an editor inside to replace the plain value text.
export component DetailField inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: Theme.space-m;
    padding-top: Theme.space-xs;
    padding-bottom: Theme.space-xs;

    // The top padding lines the text up with the text inside editors such as LineEdit.
    VerticalLayout {
        padding-top: 7px;
        Text {
            text: label;
            width: 92px;
            font-size: Theme.font-body;
            color: Theme.text-muted;
        }
    }

    if value != "": VerticalLayout {
        padding-top: 7px;
        horizontal-stretch: 1;
        Text {
            text: value;
            font-size: Theme.font-body;
            color: Theme.text;
            wrap: word-wrap;
        }
    }

    @children
}
