import { Bridge, DeviceStatus, DeviceView } from "../bridge.slint";
import { Labels } from "../labels.slint";
import { Theme } from "../theme.slint";
import { DeviceIcon } from "device-icon.slint";
import { StatusDot } from "status-dot.slint";

// One entry in a device list. A device heads a group: a chevron folds its network cards away,
// and a line under its name says how many it holds. Each card follows inside the group, on an
// inset band with a guide line down from the device's icon, and can be dragged onto the map to
// plug it in there. A guest follows its host, indented under it. Clicking selects the device
// or card. The background stops short of the list's scroll bar, which floats over the
// right-hand edge of the rows.
export component DeviceRow inherits Rectangle {
    in property <DeviceView> device;
    callback double-clicked;

    property <bool> card: device.card-id >= 0;
    property <bool> selected: card ? device.card-id == Bridge.selected-card : device.id == Bridge.selected-id && Bridge.selected-card < 0;
    property <string> name: card ? Labels.card-name(device.card-name, device.card-index) : Labels.device-name(device.name);
    property <length> icon-width: 26px;
    property <length> chevron-width: 16px;
    property <length> step: icon-width + Theme.space-m;
    // Where the device's icon sits; a card's guide line runs down from its centre.
    property <length> device-icon-x: Theme.space-xs + chevron-width + Theme.space-xs + (device.depth - (card ? 1 : 0)) * step;
    property <length> width-inside: root.width - Theme.scrollbar-width;

    height: card ? Theme.card-row-height : Theme.row-height;
    accessible-role: list-item;
    accessible-label: card ? Labels.card-of(device.name, device.card-name, device.card-index) : name;
    accessible-item-selected: selected;
    accessible-expandable: !card && device.children > 0;
    accessible-expanded: device.expanded;

    Rectangle {
        x: 0;
        width: width-inside;
        background: selected ? Theme.accent-soft : touch.has-hover ? Theme.hover : card ? Theme.background : Theme.group-tint(device.colour);
    }

    // A thin rule above each group, and a closing one under its last card.
    if !card: Rectangle {
        x: 0;
        y: 0;
        width: width-inside;
        height: 1px;
        background: Theme.border;
    }

    // The group's guide line: down from the device's icon to this card, with a tick across.
    if card: Rectangle {
        x: device-icon-x + icon-width / 2;
        y: 0;
        width: 1px;
        height: device.last ? root.height / 2 : root.height;
        background: Theme.border-strong;
    }
    if card: Rectangle {
        x: device-icon-x + icon-width / 2;
        y: root.height / 2;
        width: step - icon-width / 2 - Theme.space-xs;
        height: 1px;
        background: Theme.border-strong;
    }

    drag := DragArea {
        enabled: card;
        allow-move: true;
        data: Bridge.card-transfer(device.card-id);
        drag-image: device.card-icon.image;

        touch := TouchArea {
            mouse-cursor: card ? MouseCursor.grab : MouseCursor.default;
            clicked => {
                if card {
                    Bridge.select-card(device.card-id);
                } else {
                    Bridge.select(device.id);
                }
            }
            double-clicked => { root.double-clicked(); }
        }
    }

    HorizontalLayout {
        width: width-inside;
        x: 0;
        padding-left: card ? device-icon-x + step : Theme.space-xs + device.depth * step;
        padding-right: Theme.space-m;
        spacing: Theme.space-m;
        opacity: drag.dragging ? 0.4 : 1;

        // Folds the group up or opens it; a device with no cards has nothing to fold.
        if !card: Rectangle {
            width: chevron-width;
            chevron := Image {
                source: @image-url("../icons/chevron-right.svg");
                visible: device.children > 0;
                width: parent.width;
                height: parent.width;
                colorize: chevron-touch.has-hover ? Theme.text : Theme.text-muted;
                transform-rotation: device.expanded ? 90deg : 0deg;
                animate transform-rotation { duration: 120ms; }
            }
            chevron-touch := TouchArea {
                enabled: device.children > 0;
                accessible-role: button;
                accessible-label: device.expanded ? @tr("list.group-collapse") : @tr("list.group-expand");
                clicked => { Bridge.toggle-group(device.id); }
            }
        }

        // A card shows its own icon, which says what kind of connection it is.
        DeviceIcon {
            icon: card ? device.card-icon.image : device.icon;
            width: card ? 20px : icon-width;
            colorize: Theme.group-colour(device.colour, selected ? Theme.accent : device.status == DeviceStatus.offline || card ? Theme.icon-faded : Theme.icon);
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: name;
                font-size: card ? Theme.font-small : Theme.font-body;
                font-weight: card ? 400 : 600;
                color: Theme.text;
                overflow: elide;
            }
            if card && device.ip != "": Text {
                text: device.ip;
                font-size: Theme.font-small;
                color: Theme.text-muted;
            }
            if !card: Text {
                text: Labels.group-summary(device.ip, device.children);
                font-size: Theme.font-small;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        if !card: Text {
            text: device.role;
            font-size: Theme.font-small;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
            max-width: 90px;
        }

        if !card: VerticalLayout {
            alignment: center;
            StatusDot { status: device.status; }
        }
    }

    if card && device.last: Rectangle {
        x: 0;
        y: root.height - 1px;
        width: width-inside;
        height: 1px;
        background: Theme.border;
    }
}
