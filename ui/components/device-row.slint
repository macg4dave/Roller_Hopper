import { DeviceStatus, DeviceView } from "../bridge.slint";
import { Labels } from "../labels.slint";
import { Theme } from "../theme.slint";
import { DeviceIcon } from "device-icon.slint";
import { StatusDot } from "status-dot.slint";

// One entry in the device list. Its background stops short of the list's scroll bar, which
// floats over the right-hand edge of the rows.
export component DeviceRow inherits Rectangle {
    in property <DeviceView> device;
    in property <bool> selected;
    callback clicked;
    callback double-clicked;

    height: Theme.row-height;
    accessible-role: list-item;
    accessible-label: Labels.device-name(device.name);
    accessible-item-selected: selected;

    Rectangle {
        x: 0;
        width: parent.width - Theme.scrollbar-width;
        background: selected ? Theme.accent-soft : touch.has-hover ? Theme.hover : Theme.group-tint(device.colour);
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }

    HorizontalLayout {
        width: parent.width - Theme.scrollbar-width;
        x: 0;
        padding-left: Theme.space-s;
        padding-right: Theme.space-m;
        spacing: Theme.space-m;

        DeviceIcon {
            icon: device.icon;
            width: 26px;
            colorize: Theme.group-colour(device.colour, selected ? Theme.accent : device.status == DeviceStatus.offline ? Theme.icon-faded : Theme.icon);
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: Labels.device-name(device.name);
                font-size: Theme.font-body;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: device.ip;
                font-size: Theme.font-small;
                color: Theme.text-muted;
            }
        }

        Text {
            text: device.role;
            font-size: Theme.font-small;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
            max-width: 90px;
        }

        VerticalLayout {
            alignment: center;
            StatusDot { status: device.status; }
        }
    }
}
