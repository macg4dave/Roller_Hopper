import { Theme } from "../theme.slint";

// A list group's guide line through one child row: down from the icon of the group's head, with
// a tick across towards the child, as far as its width. It stops halfway down the last child.
export component GuideLine {
    in property <bool> last;

    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: root.last ? root.height / 2 : root.height;
        background: Theme.border-strong;
    }
    Rectangle {
        x: 0;
        y: root.height / 2;
        width: root.width;
        height: 1px;
        background: Theme.border-strong;
    }
}
