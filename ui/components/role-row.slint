import { Button, ComboBox } from "std-widgets.slint";
import { Bridge, RoleView } from "../bridge.slint";
import { Theme } from "../theme.slint";
import { DeviceIcon } from "device-icon.slint";
import { IconPicker } from "icon-picker.slint";
import { NameEdit } from "name-edit.slint";

// Column sizes shared by the rows and the heading above them, so the columns line up.
export global RoleColumns {
    out property <length> icon: 32px;
    out property <length> name: 180px;
    out property <length> group: 160px;
}

// One role in the edit page's role list: rename it, change its icon or group, or delete it.
export component RoleRow inherits Rectangle {
    in property <RoleView> role;
    // Where the role sits in Bridge.role-list, which identifies it to Rust.
    in property <int> index;
    property <length> icon-box: RoleColumns.icon;

    height: Theme.row-height;
    border-radius: Theme.radius;
    background: Math.mod(index, 2) == 1 ? Theme.stripe : transparent;

    // Picking a group replaces the dropdown's binding, so keep it following Rust's state.
    changed role => { group-box.current-index = role.group; }

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: Theme.space-m;

        icon-button := Rectangle {
            width: icon-box;
            height: icon-box;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            background: touch.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: @tr("roles.change-icon");
            accessible-action-default => { popup.show(); }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }
            if role.has-icon: DeviceIcon {
                kind: role.icon;
                width: 20px;
                height: 20px;
            }
        }

        VerticalLayout {
            alignment: center;
            width: RoleColumns.name;
            NameEdit {
                name: role.name;
                accessible-label: @tr("roles.name");
                commit(text) => { Bridge.rename-role(index, text); }
            }
        }

        VerticalLayout {
            alignment: center;
            width: RoleColumns.group;
            group-box := ComboBox {
                model: Bridge.group-choices;
                current-index: role.group;
                accessible-label: @tr("roles.group");
                selected => { Bridge.set-role-group(index, self.current-index); }
            }
        }

        Text {
            text: role.has-icon ? "" : @tr("roles.own-icon");
            font-size: Theme.font-small;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            // Keeps the column width when the button is absent, so the rows stay aligned.
            min-width: icon-box;
            if role.deletable: Button {
                icon: @image-url("../icons/delete.svg");
                colorize-icon: true;
                accessible-label: @tr("roles.delete");
                clicked => { Bridge.delete-role(index); }
            }
        }
    }

    popup := PopupWindow {
        x: icon-button.x;
        y: icon-button.y + icon-button.height + Theme.space-xs;
        width: 7 * 28px + 2 * Theme.space-s;
        height: content.preferred-height;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius;
            drop-shadow-blur: 12px;
            drop-shadow-color: #0000001f;
        }
        content := VerticalLayout {
            padding: Theme.space-s;
            spacing: Theme.space-s;
            IconPicker {
                selected: role.icon;
                has-selection: role.has-icon;
                picked(icon) => {
                    Bridge.set-role-icon(index, icon);
                    popup.close();
                }
            }
            Button {
                text: @tr("roles.detected-icon");
                enabled: role.has-icon;
                clicked => {
                    Bridge.clear-role-icon(index);
                    popup.close();
                }
            }
        }
    }
}
