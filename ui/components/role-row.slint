import { Button, ComboBox } from "std-widgets.slint";
import { Bridge, RoleView } from "../bridge.slint";
import { Theme } from "../theme.slint";
import { IconChooser } from "icon-chooser.slint";
import { NameEdit } from "name-edit.slint";

// Column sizes shared by the rows and the heading above them, so the columns line up.
export global RoleColumns {
    out property <length> icon: 32px;
    out property <length> name: 180px;
    out property <length> group: 160px;
}

// One role in the edit page's role list: rename it, change its icon or group, or delete it.
export component RoleRow inherits Rectangle {
    in property <RoleView> role;
    // Where the role sits in Bridge.role-list, which identifies it to Rust.
    in property <int> index;
    property <length> icon-box: RoleColumns.icon;

    height: Theme.row-height;
    border-radius: Theme.radius;
    background: Math.mod(index, 2) == 1 ? Theme.stripe : transparent;

    // Picking a group replaces the dropdown's binding, so keep it following Rust's state.
    changed role => { group-box.current-index = role.group; }

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: Theme.space-m;

        IconChooser {
            width: icon-box;
            height: icon-box;
            y: (parent.height - self.height) / 2;
            icon: role.icon;
            has-icon: role.has-icon;
            reset-text: @tr("roles.detected-icon");
            can-reset: role.has-icon;
            picked(icon) => { Bridge.set-role-icon(index, icon.id); }
            reset => { Bridge.clear-role-icon(index); }
        }

        VerticalLayout {
            alignment: center;
            width: RoleColumns.name;
            NameEdit {
                name: role.name;
                accessible-label: @tr("roles.name");
                commit(text) => { Bridge.rename-role(index, text); }
            }
        }

        VerticalLayout {
            alignment: center;
            width: RoleColumns.group;
            group-box := ComboBox {
                model: Bridge.group-choices;
                current-index: role.group;
                accessible-label: @tr("roles.group");
                selected => { Bridge.set-role-group(index, self.current-index); }
            }
        }

        Text {
            text: role.has-icon ? "" : @tr("roles.own-icon");
            font-size: Theme.font-small;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            // Keeps the column width when the button is absent, so the rows stay aligned.
            min-width: icon-box;
            if role.deletable: Button {
                icon: @image-url("../icons/delete.svg");
                colorize-icon: true;
                accessible-label: @tr("roles.delete");
                clicked => { Bridge.delete-role(index); }
            }
        }
    }
}
