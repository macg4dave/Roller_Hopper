import { Bridge, FoundDecision, FoundFinding, FoundView } from "../bridge.slint";
import { Labels } from "../labels.slint";
import { Theme } from "../theme.slint";
import { FlagChip } from "chip.slint";
import { DeviceIcon } from "device-icon.slint";
import { GuideLine } from "guide-line.slint";

// Column sizes shared by the rows and the heading above them, so the columns line up. The name
// takes the rest of the width.
export global FoundColumns {
    out property <length> icon: 20px;
    in-out property <length> ip: 104px;
    in-out property <length> mac: 128px;
    in-out property <length> role: 100px;
}

// One row of the discovery results. As in the device list, a host heads a group, with each of
// its network cards after it on a guide line down from its icon, and a guest follows its host,
// indented under it. A card the run did not see, off the subnet scanned, is greyed. Clicking a
// row shows the host or the card in the details. An ignored host is faded with its cards. A
// card of a host not on the map can be dragged onto any row of another host's group to become
// a child of that host, or of its device on the map.
export component FoundRow inherits Rectangle {
    in property <FoundView> found;

    property <bool> card: found.card-index >= 0;
    property <bool> selected: found.index == Bridge.selected-found && found.card-index == Bridge.selected-found-card;
    property <length> step: FoundColumns.icon + Theme.space-m;
    // Where the host's icon sits; a card's guide line runs down from its centre.
    property <length> host-icon-x: Theme.space-s + found.depth * step;
    property <color> text-colour: card && !found.seen ? Theme.text-muted : Theme.text;

    height: card ? Theme.found-card-row-height : Theme.found-row-height;
    border-radius: Theme.radius;
    property <bool> drop-here: drop.has-drag && drop.current-action != DragAction.none;

    background: selected || drop-here ? Theme.accent-soft : touch.has-hover ? Theme.hover : card ? Theme.background : Theme.group-tint(found.colour);
    border-width: drop-here ? 1px : 0;
    border-color: Theme.accent;
    opacity: drag.dragging ? 0.4 : found.decision == FoundDecision.ignored ? 0.55 : 1;
    accessible-role: list-item;
    accessible-label: card ? @tr("card.of", Labels.found-name(found.name), Labels.card-name(found.card-name, found.card-index)) : Labels.found-name(found.name);
    accessible-item-selected: selected;

    // A thin rule above each group.
    if !card: Rectangle {
        y: 0;
        height: 1px;
        width: root.width - Theme.scrollbar-width;
        background: Theme.border;
    }
    if card: GuideLine {
        x: host-icon-x + FoundColumns.icon / 2;
        y: 0;
        width: step - FoundColumns.icon / 2 - Theme.space-xs;
        height: root.height;
        last: found.last;
    }

    drop := DropArea {
        can-drop(event) => {
            return Bridge.can-move-found-card(event.data, found.index) ? DragAction.move : DragAction.none;
        }
        dropped(event) => {
            Bridge.move-found-card(event.data, found.index);
            return event.proposed-action;
        }
    }

    // Only a card of a host not yet on the map moves from here; one on the map moves in its
    // card editor.
    drag := DragArea {
        enabled: card && found.finding != FoundFinding.known && found.decision != FoundDecision.added;
        allow-move: true;
        data: Bridge.found-card-transfer(found.index, found.card-index);
        drag-image: found.card-icon.image;

        touch := TouchArea {
            mouse-cursor: drag.enabled ? MouseCursor.grab : MouseCursor.default;
            clicked => {
                if card {
                    Bridge.select-found-card(found.index, found.card-index);
                } else {
                    Bridge.select-found(found.index);
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: card ? host-icon-x + step : host-icon-x;
        padding-right: Theme.space-s + Theme.scrollbar-width;
        spacing: Theme.space-m;

        // A card shows its own icon, which says what kind of connection it is.
        DeviceIcon {
            icon: card ? found.card-icon.image : found.icon.image;
            width: card ? 16px : FoundColumns.icon;
            colorize: card ? Theme.icon-faded : found.unidentified ? Theme.unknown : Theme.icon;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.space-s;
            Text {
                text: card ? Labels.card-name(found.card-name, found.card-index) : Labels.found-name(found.name);
                color: !card && found.name == "" ? Theme.text-muted : text-colour;
                font-size: card ? Theme.font-small : Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 60px;
            }
            if !card: VerticalLayout {
                alignment: center;
                FlagChip {
                    finding: found.finding;
                    decision: found.decision;
                }
            }
        }
        for cell in [
            { text: found.ip, width: FoundColumns.ip },
            { text: found.mac, width: FoundColumns.mac },
            { text: card ? "" : found.role, width: FoundColumns.role },
        ]: Text {
            text: cell.text;
            width: cell.width;
            color: text-colour;
            font-size: card ? Theme.font-small : Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
