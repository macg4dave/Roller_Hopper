import { PortView } from "../bridge.slint";
import { Theme } from "../theme.slint";
import { PortChip } from "chip.slint";
import { SelectableText } from "selectable-text.slint";

// A network card's open ports under their label, one row each: the port, then what runs on it,
// in columns as the discovery page's port editor shows them. Nothing when there are none.
export component PortList inherits VerticalLayout {
    in property <[PortView]> ports;

    visible: ports.length > 0;
    padding-top: Theme.space-xs;
    padding-bottom: Theme.space-xs;
    spacing: Theme.space-xs;

    if ports.length > 0: SelectableText {
        text: @tr("details.open-ports");
        font-size: Theme.font-body;
        color: Theme.text-muted;
    }
    for port in ports: HorizontalLayout {
        spacing: Theme.space-s;
        HorizontalLayout {
            width: Theme.port-number-width;
            alignment: start;
            VerticalLayout {
                alignment: center;
                PortChip { port: port.port; udp: port.udp; }
            }
        }
        SelectableText {
            text: port.description == "" ? @tr("port.source.open") : port.description;
            accessible-label: @tr("details.open-ports");
            horizontal-stretch: 1;
        }
        SelectableText {
            text: port.source == "detected" ? @tr("port.source.detected")
                : port.source == "registry" ? @tr("port.source.registry")
                : port.source == "manual" ? @tr("port.source.manual") : "";
            font-size: Theme.font-small;
            color: Theme.text-muted;
        }
    }
}
