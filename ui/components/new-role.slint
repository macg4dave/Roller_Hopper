import { Button, LineEdit } from "std-widgets.slint";
import { IconChoice } from "../bridge.slint";
import { Theme } from "../theme.slint";
import { IconChooser } from "icon-chooser.slint";

// A name and icon for a new role. Reports them through `add`, the icon by its id, and leaves
// adding to the owner. No icon given means Unknown.
export component NewRole inherits HorizontalLayout {
    in-out property <IconChoice> icon;
    callback add(string, string);
    callback cancel();

    spacing: Theme.space-xs;

    VerticalLayout {
        alignment: center;
        IconChooser {
            width: 32px;
            height: 32px;
            icon: root.icon;
            picked(icon) => { root.icon = icon; }
        }
    }
    name := LineEdit {
        placeholder-text: @tr("new-role.name");
        min-width: 100px;
        init => { self.focus(); }
        accepted(text) => { root.add(text, icon.id); }
    }
    Button {
        text: @tr("new-role.add");
        primary: true;
        enabled: name.text != "";
        clicked => { root.add(name.text, icon.id); }
    }
    Button {
        icon: @image-url("../icons/close.svg");
        colorize-icon: true;
        accessible-label: @tr("new-role.cancel");
        clicked => { root.cancel(); }
    }
}
