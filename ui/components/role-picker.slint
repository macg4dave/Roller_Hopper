import { Button, ComboBox } from "std-widgets.slint";
import { Bridge } from "../bridge.slint";
import { Theme } from "../theme.slint";
import { NewRole } from "new-role.slint";

// Role dropdown for the selected device, with a way to add a custom role and pick its icon.
// The role decides the icon the device is shown with.
export component RolePicker inherits VerticalLayout {
    property <bool> adding;

    horizontal-stretch: 1;
    spacing: Theme.space-xs;

    HorizontalLayout {
        spacing: Theme.space-xs;
        ComboBox {
            // Fluent's 160px default leaves no room for the add button in the details panel.
            min-width: 120px;
            model: Bridge.roles;
            current-index <=> Bridge.role-index;
            selected => { Bridge.choose-role(self.current-index); }
        }
        Button {
            icon: @image-url("../icons/plus.svg");
            colorize-icon: true;
            accessible-label: @tr("role-picker.add-custom");
            enabled: !adding;
            clicked => { adding = true; }
        }
    }

    if adding: NewRole {
        // Start from the icon the device is shown with.
        icon: Bridge.details.icon;
        add(name, icon) => {
            Bridge.choose-new-role(name, icon);
            adding = false;
        }
        cancel => { adding = false; }
    }
}
