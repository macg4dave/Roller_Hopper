import { DeviceKind } from "../bridge.slint";
import { Theme } from "../theme.slint";

// Line-art icon for a device kind; tint with `colorize`.
export component DeviceIcon inherits Image {
    in property <DeviceKind> kind;
    colorize: Theme.icon;
    source: kind == DeviceKind.router ? @image-url("../icons/router.svg")
        : kind == DeviceKind.switch ? @image-url("../icons/switch.svg")
        : kind == DeviceKind.access-point ? @image-url("../icons/access-point.svg")
        : kind == DeviceKind.nas ? @image-url("../icons/nas.svg")
        : kind == DeviceKind.desktop ? @image-url("../icons/desktop.svg")
        : kind == DeviceKind.laptop ? @image-url("../icons/laptop.svg")
        : kind == DeviceKind.server ? @image-url("../icons/server.svg")
        : kind == DeviceKind.printer ? @image-url("../icons/printer.svg")
        : kind == DeviceKind.phone ? @image-url("../icons/phone.svg")
        : kind == DeviceKind.tv ? @image-url("../icons/tv.svg")
        : kind == DeviceKind.console ? @image-url("../icons/console.svg")
        : kind == DeviceKind.camera ? @image-url("../icons/camera.svg")
        : kind == DeviceKind.smart ? @image-url("../icons/smart.svg")
        : @image-url("../icons/unknown.svg");
}
