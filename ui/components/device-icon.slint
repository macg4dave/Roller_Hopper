import { Theme } from "../theme.slint";

// A device icon from the icon folder, tinted with `colorize`. An icon whose file is gone is
// shown as Unknown, which is built in so there is always something to show.
export component DeviceIcon inherits Image {
    in property <image> icon;
    colorize: Theme.icon;
    source: icon.width > 0 ? icon : @image-url("../../icons/Other/Unknown.svg");
}
