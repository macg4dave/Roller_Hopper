import { IconChoice } from "../bridge.slint";
import { Theme } from "../theme.slint";
import { DeviceIcon } from "device-icon.slint";
import { IconChooser } from "icon-chooser.slint";
import { SelectableText } from "selectable-text.slint";

// A network card or guest of the device being edited: its icon, which can be changed in place
// unless the row is read-only, with its name and a line about it. The text can be selected and
// copied; the surrounding row and chevron open the child on its own.
export component ChildRow inherits Rectangle {
    in property <IconChoice> icon;
    in property <bool> read-only;
    // The category the icon picker opens on (see IconChooser).
    in property <int> start-category: -1;
    in property <color> tint: Theme.accent;
    in property <string> name;
    in property <string> detail;
    callback picked(IconChoice);
    callback clicked();

    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.name;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: Theme.space-xs;
        padding-right: Theme.space-s;
        spacing: Theme.space-m;

        // Declared after the row's TouchArea, so a click on the icon opens the picker instead.
        if !read-only: IconChooser {
            width: 30px;
            height: 30px;
            icon: root.icon;
            start-category: root.start-category;
            tint: root.tint;
            picked(icon) => { root.picked(icon); }
        }
        if read-only: DeviceIcon {
            width: 30px;
            height: 30px;
            icon: root.icon.image;
            colorize: root.tint;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            SelectableText {
                text: root.name;
                font-size: Theme.font-body;
                color: Theme.text;
            }
            SelectableText {
                text: root.detail;
                font-size: Theme.font-small;
                color: Theme.text-muted;
            }
        }
        Rectangle {
            width: 14px;
            height: 14px;
            Image {
                source: @image-url("../icons/chevron-right.svg");
                colorize: open.has-hover ? Theme.text : Theme.text-muted;
            }
            open := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: root.name;
                clicked => { root.clicked(); }
            }
        }
    }
}
