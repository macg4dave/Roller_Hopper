import { IconChoice } from "../bridge.slint";
import { Theme } from "../theme.slint";
import { IconChooser } from "icon-chooser.slint";

// A network card or guest of the device being edited: its icon, which can be changed in place,
// with its name and a line about it. Clicking the rest of the row opens it in its own editor.
export component ChildRow inherits Rectangle {
    in property <IconChoice> icon;
    // The category the icon picker opens on (see IconChooser).
    in property <int> start-category: -1;
    in property <color> tint: Theme.accent;
    in property <string> name;
    in property <string> detail;
    callback picked(IconChoice);
    callback clicked();

    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.name;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: Theme.space-xs;
        padding-right: Theme.space-s;
        spacing: Theme.space-m;

        // Declared after the row's TouchArea, so a click on the icon opens the picker instead.
        IconChooser {
            width: 30px;
            height: 30px;
            icon: root.icon;
            start-category: root.start-category;
            tint: root.tint;
            picked(icon) => { root.picked(icon); }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.name;
                font-size: Theme.font-body;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: root.detail;
                font-size: Theme.font-small;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        Image {
            source: @image-url("../icons/chevron-right.svg");
            width: 14px;
            height: 14px;
            colorize: touch.has-hover ? Theme.text : Theme.text-muted;
        }
    }
}
