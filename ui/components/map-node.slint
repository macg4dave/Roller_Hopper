import { DeviceStatus, DeviceView, MapSettings } from "../bridge.slint";
import { Labels } from "../labels.slint";
import { Theme } from "../theme.slint";
import { DeviceIcon } from "device-icon.slint";
import { StatusDot } from "status-dot.slint";

// One line of a device's label, centred under it. Its backing hides the line running down from
// the device, which passes behind the label when several lines are shown.
component NodeLabel inherits HorizontalLayout {
    in property <string> text;
    in property <bool> strong;

    alignment: center;
    Rectangle {
        background: Theme.background;
        border-radius: 3px;
        HorizontalLayout {
            padding-left: 3px;
            padding-right: 3px;
            Text {
                text: root.text;
                font-size: strong ? 12px : 11px;
                font-weight: strong ? 600 : 400;
                color: strong ? Theme.text : Theme.text-muted;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

// A device on the topology map, laid out at 100% and scaled with the rest of the map by the
// canvas; the icon centre is the anchor point.
export component MapNode inherits Rectangle {
    in property <DeviceView> device;
    // The map zoom, used only to keep the icon crisp under the canvas's scale transform.
    in property <float> zoom: 1;
    in property <bool> selected;
    // A ghost is faded, and it cannot be dragged.
    property <bool> ghost: device.ghost;
    out property <length> icon-size: Theme.map-icon;
    callback clicked;
    // Pointer movement since the press, while dragging.
    callback dragged(length, length);
    // The pointer was let go, whether or not it dragged.
    callback released;

    width: Theme.map-label-width;
    height: layout.preferred-height;
    opacity: device.dimmed ? 0.3 : ghost && !selected ? Theme.ghost-opacity : 1;
    accessible-role: button;
    accessible-label: ghost ? Labels.ghost-name(device.name) : Labels.device-name(device.name);

    touch := TouchArea {
        mouse-cursor: self.pressed && !ghost ? MouseCursor.grabbing : MouseCursor.pointer;
        clicked => { root.clicked(); }
        moved => { root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.released();
            }
        }
    }

    layout := VerticalLayout {
        spacing: 3px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: icon-size + 14px;
                height: self.width;
                border-radius: self.width / 2;
                background: selected ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
                border-width: selected ? 1px : 0;
                border-color: Theme.accent;

                DeviceIcon {
                    // SVGs are rasterised at the element's own size, ignoring transforms. Drawing
                    // at the next power-of-two of the zoom and scaling back keeps icons sharp,
                    // while the few sizes used stay in Slint's image cache during smooth zooming.
                    property <float> detail: Math.pow(2, Math.ceil(Math.log(zoom, 2)));
                    icon: device.icon;
                    x: (parent.width - icon-size) / 2;
                    y: (parent.height - icon-size) / 2;
                    width: icon-size * detail;
                    height: icon-size * detail;
                    transform-origin: { x: 0, y: 0 };
                    transform-scale: 1 / detail;
                    colorize: Theme.group-colour(device.colour, selected ? Theme.accent : device.status == DeviceStatus.offline ? Theme.icon-faded : Theme.icon);
                }

                if MapSettings.show-status: StatusDot {
                    status: device.status;
                    x: parent.width - self.width - 3px;
                    y: 3px;
                }
            }
        }

        // What the View menu turns on, in the order of the details panel.
        if MapSettings.show-names: NodeLabel {
            text: Labels.device-name(device.name);
            strong: true;
        }
        if MapSettings.show-roles: NodeLabel { text: device.role; }
        if MapSettings.show-addresses: NodeLabel { text: device.ip; }
        if MapSettings.show-macs && device.mac != "": NodeLabel { text: device.mac; }
        if MapSettings.show-hostnames && device.hostname != "": NodeLabel { text: device.hostname; }
    }
}
