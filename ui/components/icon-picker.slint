import { IconChoice } from "../bridge.slint";
import { Theme } from "../theme.slint";
import { DeviceIcon } from "device-icon.slint";

// A grid of icons to choose from, each named underneath; it wraps to the width it is given.
// Reports the choice through `picked` and leaves applying it to the owner.
export component IconPicker inherits Rectangle {
    in property <[IconChoice]> icons;
    // The id of the current choice; empty when none of the icons is the current choice.
    in property <string> selected;
    callback picked(IconChoice);
    property <length> tile-width: 76px;
    property <length> tile-height: 64px;
    property <int> columns: max(1, Math.floor(root.width / tile-width));

    height: Math.ceil(icons.length / columns) * tile-height;

    for icon[i] in icons: Rectangle {
        x: Math.mod(i, columns) * tile-width;
        y: Math.floor(i / columns) * tile-height;
        width: tile-width;
        height: tile-height;
        border-radius: Theme.radius;
        property <bool> chosen: icon.id == selected;
        background: chosen ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
        border-width: chosen ? 1px : 0;
        border-color: Theme.accent;
        accessible-role: button;
        accessible-label: icon.label;
        accessible-checkable: true;
        accessible-checked: chosen;
        accessible-action-default => { root.picked(icon); }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(icon); }
        }

        VerticalLayout {
            padding: Theme.space-xs;
            spacing: Theme.space-xs;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                DeviceIcon {
                    icon: icon.image;
                    width: 24px;
                    height: 24px;
                    colorize: chosen ? Theme.accent : Theme.icon;
                }
            }
            Text {
                text: icon.label;
                font-size: Theme.font-small;
                color: chosen ? Theme.accent : Theme.text;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}
