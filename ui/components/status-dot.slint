import { DeviceStatus } from "../bridge.slint";
import { Theme } from "../theme.slint";

// Small online / offline / unknown indicator. Offline is hollow so it does not rely on colour alone.
export component StatusDot inherits Rectangle {
    in property <DeviceStatus> status;
    width: 8px;
    height: 8px;
    border-radius: self.width / 2;
    border-width: status == DeviceStatus.offline ? 1.5px : 0;
    border-color: Theme.offline;
    background: status == DeviceStatus.online ? Theme.online
        : status == DeviceStatus.unknown ? Theme.unknown
        : transparent;
}
