// The data Rust pushes into the UI and the callbacks the UI raises back to Rust.
// Rust owns this state; components only read it and call the callbacks.
// Rust sends data, not wording: user-visible text is produced in Slint (see labels.slint).

export enum DeviceKind { router, switch, access-point, nas, desktop, laptop, server, printer, phone, tv, console, camera, smart, unknown }

/// An icon from the icon folder. `id` is its path there, which identifies it to Rust; `label` is
/// its file name. `image` is empty when the file is gone, and is then shown as Unknown. `group`
/// is its index in Bridge.icons, or -1 when it is not in the folder.
export struct IconChoice {
    id: string,
    label: string,
    image: image,
    group: int,
}

/// The icons of one subfolder of the icon folder; `heading` is empty for the folder itself.
export struct IconGroup {
    heading: string,
    icons: [IconChoice],
}

export enum DeviceStatus { online, offline, unknown }

export enum StatusFilter { all, online, offline }

// The standard roles; custom roles are sent as the user typed them.
export enum RoleKind { router, switch, access-point, server, nas, desktop, laptop, phone, printer, camera, iot, other }

// A group's colour; `none` leaves its devices in the usual colours.
export enum GroupColour { none, red, orange, yellow, green, blue, purple }

// What a device runs as on its host; `none` for a physical device.
export enum GuestKind { none, virtual-machine, container }

/// One device as drawn on the map and in the lists, or one of its network cards: a row under
/// the device in the lists, and its ghost on the map. `x`/`y` are map units (icon centre).
export struct DeviceView {
    // The device's id, also for one of its cards.
    id: int,
    // For a card: its id, its place among its device's cards from 0, and its name, empty when
    // it has none. -1 for the device itself.
    card-id: int,
    card-index: int,
    card-name: string,
    name: string,
    // Of its first network card, or of the card itself.
    ip: string,
    mac: string,
    // Empty when the device gave none.
    hostname: string,
    // Already translated: standard role names come from Labels.role().
    role: string,
    // Follows the role; the detected kind's when the role has no icon of its own.
    icon: image,
    // The colour of the role's group.
    colour: GroupColour,
    status: DeviceStatus,
    // Its settled spot in the layout, which the list centres the map on; for a card without a
    // ghost, its device's. Where it is drawn while it moves is in Bridge.places.
    x: float,
    y: float,
    // Hidden by the current search or filter: faded on the map.
    dimmed: bool,
    // How many hosts it runs within: a guest comes after its host in the lists, indented
    // under it. A card's row is indented one more, under its device.
    depth: int,
}

/// Where a node in Bridge.nodes is drawn on the map right now, at the same index. Kept apart
/// from DeviceView so a moving node does not redo its labels every frame.
export struct NodePlace {
    x: float,
    y: float,
    // The root circle at the foot of its trunk, straight below it; none while it is dragged.
    has-root: bool,
    root-y: float,
}

/// A network card of the selected device, in its order. Settings not given are empty.
export struct CardView {
    id: int,
    // Its place among its device's cards, from 0, and its name, empty when it has none.
    index: int,
    name: string,
    ip: string,
    mask: string,
    gateway: string,
    mac: string,
    // Where it is plugged in: the device's name, empty when nowhere, and the card's name and
    // place there, -1 when that device has only the one card.
    via-name: string,
    via-card: string,
    via-index: int,
    inferred: bool,
    // False for a guest's first card, which reaches the network through its host.
    pluggable: bool,
}

/// A setting of the selected network card, typed on the edit page.
export enum CardField { name, address, mask, gateway, mac }

/// Read-only details of the selected device. Empty strings are not shown.
export struct DeviceDetails {
    // What the device was detected as, and the icon it is shown with.
    kind: DeviceKind,
    icon: IconChoice,
    // The icon was picked for this device rather than coming from its role.
    custom-icon: bool,
    // The colour of the role's group, as on the map and in the list.
    colour: GroupColour,
    status: DeviceStatus,
    name: string,
    // Already translated, like DeviceView.role.
    role: string,
    notes: string,
    // What it runs as, and the name of the device it runs on.
    guest: GuestKind,
    host-name: string,
    manufacturer: string,
    model: string,
    hostname: string,
    last-seen-minutes: int,
    // Name of the device this one connects through; empty for the router and for a guest,
    // which connects through its host.
    uplink-name: string,
    uplink-inferred: bool,
    services: string,
}

/// An open port of the selected device, in port order, for the edit page.
export struct PortView {
    port: int,
    description: string,
}

/// A role in the edit page's role list, in the same order as Bridge.roles.
export struct RoleView {
    // As shown in the role dropdown: translated, unless the user named it.
    name: string,
    icon: IconChoice,
    // False when the role's devices keep their own detected icon.
    has-icon: bool,
    // Other cannot be deleted: it is where devices of a deleted role go.
    deletable: bool,
    // Index in Bridge.group-choices: 0 for no group.
    group: int,
}

/// A group in the edit page's group list, in the same order as Bridge.groups.
export struct GroupView {
    name: string,
    colour: GroupColour,
    // Index in Bridge.line-styles.
    line-style: int,
}

/// Connection lines drawn alike, as SVG path commands in map units. A line takes the colour and
/// line style of the device it hangs from; the selected device's lines are highlighted instead.
/// The style is already in the commands, apart from its width.
export struct LineSet {
    commands: string,
    colour: GroupColour,
    // Inferred links are drawn faded.
    inferred: bool,
    selected: bool,
    thick: bool,
}

/// The stretchy strand from a dragged device to the line it would join, as SVG path commands in
/// map units; empty when there is none. `pull` runs from 0 (slack) to 1 (about to let go).
/// `join-x`/`join-y` mark where it joins that line, in map units.
export struct Strand {
    commands: string,
    pull: float,
    join-x: float,
    join-y: float,
}

/// The map area that holds every node and label, in map units.
export struct MapBounds {
    x: float,
    y: float,
    width: float,
    height: float,
}

export global Bridge {
    // The map's nodes: the devices, each followed by the ghosts of its further network cards.
    in property <[DeviceView]> nodes;
    in property <[NodePlace]> places;
    // The devices the search and filter let through, each followed by its network cards.
    in property <[DeviceView]> list;
    // Every device, each followed by its network cards, for the edit page.
    in property <[DeviceView]> rows;
    // Highlighted lines come last, so they are drawn on top.
    in property <[LineSet]> lines;
    in property <Strand> strand;
    in property <MapBounds> bounds;
    // The selected device, also while one of its cards is selected.
    in property <int> selected-id: -1;
    in property <DeviceDetails> details;
    in property <[CardView]> cards;
    // The selected network card, -1 for none; whether it is drawn as a ghost (else the map shows
    // it as its device); and its view.
    in property <int> selected-card: -1;
    in property <bool> selected-ghost;
    in property <CardView> card;
    // What the selected card can be plugged into: first none, then the cards of the devices
    // away from its own, in device order; and where it is plugged in now.
    in property <[string]> upstream-choices;
    in property <int> card-plug-index;
    in property <[PortView]> ports;
    in property <[string]> roles;
    in property <[RoleView]> role-list;
    // A standard role was renamed, re-iconed or deleted.
    in property <bool> roles-restorable;
    // The group list's rows, and their names led by "no group" for the role group dropdown.
    in property <[GroupView]> groups;
    in property <[string]> group-choices;
    // A preview of each line style, in the order of the group line style dropdown.
    in property <[LineSet]> line-styles;
    in property <StatusFilter> filter;
    in property <int> count-all;
    in property <int> count-online;
    in property <int> count-offline;
    in property <bool> scanning;
    // Completed simulated scans.
    in property <int> scans;
    // Every icon in the icon folder, for the icon picker.
    in property <[IconGroup]> icons;

    // Edit buffers for the selected device, set by Rust when the selection changes.
    in-out property <string> name-draft;
    in-out property <string> notes-draft;
    in-out property <int> role-index;

    // Selects a device by its id, or nothing on -1; select-card selects a network card.
    callback select(int);
    callback select-card(int);
    callback search(string);
    callback set-filter(StatusFilter);
    callback rename(string);
    callback choose-role(int);
    // Reads the icon folder again, so icons added since appear. Icons are passed by their id;
    // an empty id is the Unknown icon.
    callback refresh-icons();
    callback edit-notes(string);
    // The selected device's own icon, or back to its role's icon.
    callback set-icon(string);
    callback reset-icon();
    // Removes the selected device until the app restarts.
    callback forget();
    // The selected device's ports, identified by their index in ports. Port numbers come as
    // typed; one that is not 1–65535, or is already listed, is refused (add-port returns false).
    callback add-port(string, string) -> bool;
    callback set-port-number(int, string);
    callback set-port-description(int, string);
    callback remove-port(int);
    // Adds a blank network card to the selected device, and selects it.
    callback add-card();
    // Removes the selected card, unless it is its device's last, and selects the device.
    callback remove-card();
    // A setting of the selected card as typed; empty clears it. Refused (false) when it does
    // not parse, an address is already in use, or a subnet mask is given before an address.
    // An address may carry its prefix (`a.b.c.d/nn`).
    callback edit-card(CardField, string) -> bool;
    // Plugs the selected card into the card at an index in upstream-choices; 0 for none.
    callback plug-card(int);
    // A virtual machine or container on the selected device, with a name and its first card's
    // address as typed. Refused (false) when the name is blank or the address is refused.
    callback add-guest(GuestKind, string, string) -> bool;
    // The role list. Roles are identified by their index in role-list.
    callback add-role(string, string);
    callback rename-role(int, string);
    callback set-role-icon(int, string);
    // The role's devices keep their own detected icon.
    callback clear-role-icon(int);
    callback delete-role(int);
    // Standard roles back as they were, including deleted ones.
    callback restore-roles();
    // A role and its index in group-choices.
    callback set-role-group(int, int);
    // The group list. Groups are identified by their index in groups.
    callback add-group(string);
    callback rename-group(int, string);
    callback set-group-colour(int, GroupColour);
    // A group and its index in the line style dropdown.
    callback set-group-line-style(int, int);
    // The group's roles are left in no group.
    callback delete-group(int);
    // Dragging a node (by its index in nodes) previews the line it would join; dropping it joins
    // that line, or leaves it standing alone away from every line (a ghost goes back under its
    // device). Ignored when nothing was dragged.
    callback move-node(int, float, float);
    callback drop-node();
    // Brings back the connections as found, and the tidy layout.
    callback reset-layout();
    callback scan();
}

/// Purely visual map preferences from the map's View menu: what each device is labelled with.
export global MapSettings {
    in-out property <bool> show-names: true;
    in-out property <bool> show-roles;
    in-out property <bool> show-addresses: true;
    in-out property <bool> show-macs;
    in-out property <bool> show-hostnames;
    in-out property <bool> show-status: true;
}
