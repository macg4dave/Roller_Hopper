// The data Rust pushes into the UI and the callbacks the UI raises back to Rust.
// Rust owns this state; components only read it and call the callbacks.
// Rust sends data, not wording: user-visible text is produced in Slint (see labels.slint).

export enum DeviceKind { router, switch, access-point, nas, desktop, laptop, server, printer, phone, tv, console, camera, smart, unknown }

/// An icon from the icon folder. `id` is its path there, which identifies it to Rust; `label` is
/// its file name. `image` is empty when the file is gone, and is then shown as Unknown. `group`
/// is its index in Bridge.icons, or -1 when it is not in the folder.
export struct IconChoice {
    id: string,
    label: string,
    image: image,
    group: int,
}

/// The icons of one subfolder of the icon folder; `heading` is empty for the folder itself.
export struct IconGroup {
    heading: string,
    icons: [IconChoice],
}

export enum DeviceStatus { online, offline, unknown }

export enum StatusFilter { all, online, offline }

// The standard roles; custom roles are sent as the user typed them.
export enum RoleKind { router, switch, access-point, server, nas, desktop, laptop, phone, printer, camera, iot, other }

// A group's colour; `none` leaves its devices in the usual colours.
export enum GroupColour { none, red, orange, yellow, green, blue, purple }

// What a device runs as on its host; `none` for a physical device.
export enum GuestKind { none, virtual-machine, container }

/// One device in the lists, or one of its network cards: a row under the device in the lists,
/// and a node on the map. `x`/`y` are map units (icon centre).
export struct DeviceView {
    // The device's id, also for one of its cards.
    id: int,
    // For a card: its id, its place among its device's cards from 0, and its name, empty when
    // it has none. -1 for the device itself.
    card-id: int,
    card-index: int,
    card-name: string,
    // The card dragging its row onto the map moves: the card itself, or a device's first card.
    drag-card: int,
    // The card's own icon (Ethernet, Wi-Fi…): in its row, and as a badge on the map.
    card-icon: IconChoice,
    name: string,
    // Of its first network card, or of the card itself.
    ip: string,
    mac: string,
    // Empty when the device gave none.
    hostname: string,
    // Already translated: standard role names come from Labels.role().
    role: string,
    // Follows the role; the detected kind's when the role has no icon of its own.
    icon: image,
    // The colour of the role's group.
    colour: GroupColour,
    status: DeviceStatus,
    // Its settled spot on the map, which the list centres the map on; for a device, that of its
    // first card. Where it is drawn while it moves is in Bridge.places.
    x: float,
    y: float,
    // Hidden by the current search or filter: faded on the map.
    dimmed: bool,
    // How many hosts it runs within: a guest comes after its host in the lists, indented
    // under it. A card's row is indented one more, under its device.
    depth: int,
    // For a device: how many network cards its group holds, and whether the lists show them.
    children: int,
    expanded: bool,
    // For a card: it is the last of its device's cards, where the group's guide line ends.
    last: bool,
}

/// Where a node in Bridge.nodes is drawn on the map right now, at the same index. Kept apart
/// from DeviceView so a moving node does not redo its labels every frame.
export struct NodePlace {
    x: float,
    y: float,
    // The root circle at the foot of its trunk, straight below it; none while it is dragged.
    has-root: bool,
    root-y: float,
}

/// An open port of a network card, in port order.
export struct PortView {
    port: int,
    udp: bool,
    description: string,
}

/// A network card of the selected device, in its order. Settings not given are empty.
export struct CardView {
    id: int,
    // Its place among its device's cards, from 0, and its name, empty when it has none.
    index: int,
    name: string,
    ip: string,
    mask: string,
    gateway: string,
    mac: string,
    // Who made the card, from its MAC address; empty when unknown.
    vendor: string,
    // Where it is plugged in: the device's name, empty when nowhere, and the card's name and
    // place there, -1 when that device has only the one card.
    via-name: string,
    via-card: string,
    via-index: int,
    inferred: bool,
    ports: [PortView],
    icon: IconChoice,
}

/// A virtual machine or container running straight on the selected device, in device order.
export struct GuestView {
    id: int,
    kind: GuestKind,
    name: string,
    // Of its first network card; empty when it has none.
    ip: string,
    icon: IconChoice,
    colour: GroupColour,
}

/// A setting of the selected network card, typed on the edit page.
export enum CardField { name, address, mask, gateway, mac }

// A scan's guess at a device's operating system; unknown when it made none.
export enum OsFamily { unknown, windows, macos, linux, ios, network }
// What pointed the scan at an OS. `ttl` is the ping reply's time-to-live, for a ttl clue.
export enum OsClueKind { device-model, apple-sync-port, ssh-banner, server-header, windows-ports, ttl, ai }
export struct OsClueView {
    kind: OsClueKind,
    ttl: int,
}

/// Read-only details of the selected device. Empty strings are not shown.
export struct DeviceDetails {
    // What the device was detected as, and the icon it is shown with.
    kind: DeviceKind,
    icon: IconChoice,
    // The icon was picked for this device rather than coming from its role.
    custom-icon: bool,
    // The colour of the role's group, as on the map and in the list.
    colour: GroupColour,
    status: DeviceStatus,
    name: string,
    // Already translated, like DeviceView.role.
    role: string,
    notes: string,
    // What it runs as, and the id and name of the device it runs on (-1 for none).
    guest: GuestKind,
    host-id: int,
    host-name: string,
    manufacturer: string,
    model: string,
    hostname: string,
    // As in FoundView.
    os-family: OsFamily,
    os-detail: string,
    mdns-services: string,
    last-seen-minutes: int,
}

/// A role in the edit page's role list, in the same order as Bridge.roles.
export struct RoleView {
    // As shown in the role dropdown: translated, unless the user named it.
    name: string,
    icon: IconChoice,
    // False when the role's devices keep their own detected icon.
    has-icon: bool,
    // Other cannot be deleted: it is where devices of a deleted role go.
    deletable: bool,
    // Index in Bridge.group-choices: 0 for no group.
    group: int,
}

/// A group in the edit page's group list, in the same order as Bridge.groups.
export struct GroupView {
    name: string,
    colour: GroupColour,
    // Index in Bridge.line-styles.
    line-style: int,
}

/// Connection lines drawn alike, as SVG path commands in map units. A line takes the colour and
/// line style of the device whose card it hangs from; the selected card's lines (all of the
/// selected device's cards' lines, and the ties between them) are highlighted instead.
/// The style is already in the commands, apart from its width.
export struct LineSet {
    commands: string,
    colour: GroupColour,
    // Inferred links are drawn faded.
    inferred: bool,
    selected: bool,
    thick: bool,
}

/// The stretchy strand from a dragged device to the line it would join, as SVG path commands in
/// map units; empty when there is none. `pull` runs from 0 (slack) to 1 (about to let go).
/// `join-x`/`join-y` mark where it joins that line, in map units.
export struct Strand {
    commands: string,
    pull: float,
    join-x: float,
    join-y: float,
}

/// The map area that holds every node and label, in map units.
export struct MapBounds {
    x: float,
    y: float,
    width: float,
    height: float,
}

// A discovery run of the network typed on the Scan button's page.
export enum DiscoveryPhase { idle, running, finished }
// Import with AI: idle until begun; loading the model, then identifying one host at a time.
export enum AiImportPhase { idle, loading, identifying, finished, stopped, no-model, failed }
export enum ScanMode { quick, full, everything }
// Why the network typed cannot be scanned; none when it can.
export enum TargetError { none, empty, invalid, too-wide }
// The scan's tick boxes. Which ports a port scan probes is a dropdown beside its box.
// How a found host compares with the map: matched by MAC address.
export enum FoundFinding { known, new, duplicate }
export enum FoundDecision { pending, added, ignored }
export enum FoundFilter { all, new, unidentified, duplicates }
export enum FoundSort { name, ip, mac, role }
export enum DiscoveryMethod { arp, ping, mdns }
export enum LogEvent { started, sweep, discovered, unidentified, duplicate, failed, stopped, finished }

/// The discovery run as a whole. `seconds` is how long it has been running.
export struct DiscoveryView {
    phase: DiscoveryPhase,
    // The subnet being scanned, or else the one typed, as a subnet (empty when what was typed
    // is not one), and why what was typed cannot be scanned.
    target: string,
    target-error: TargetError,
    mode: ScanMode,
    // Addresses checked so far, of all of them; then port probes done, of all planned for the
    // hosts found, which are none until every address is checked.
    swept: int,
    addresses: int,
    probed: int,
    probes: int,
    seconds: int,
    filter: FoundFilter,
    sort: FoundSort,
    sort-descending: bool,
    count-all: int,
    count-new: int,
    count-unidentified: int,
    count-duplicates: int,
    // New hosts still waiting for a decision, which import-found adds.
    importable: int,
    // Import with AI: how far it has got, or how it ended; the hosts the model has answered
    // for, of all it began with.
    ai-import: AiImportPhase,
    ai-done: int,
    ai-total: int,
}

/// A host the run found, or in the results one of its network cards, which follow it as in the
/// device list, and in the details. `index` is the host's place among all found
/// hosts, which the callbacks take, for a card too.
export struct FoundView {
    index: int,
    // For a card: its place among its host's cards from 0, its name, empty when it has none, and
    // its own icon; whether the run saw it (it is on the subnet scanned); and whether it is the
    // host's last card, where the group's guide line ends. card-index is -1 for the host itself.
    card-index: int,
    card-name: string,
    card-icon: IconChoice,
    seen: bool,
    last: bool,
    // How many of the hosts shown it runs within: a guest follows its host, indented under it.
    depth: int,
    // The device on the map it is (known, or added since), -1 for none; and where that
    // device's first card sits on the map.
    device-id: int,
    map-x: float,
    map-y: float,
    // Empty when nothing told its name.
    name: string,
    // Of the card it answered at, or of the card itself.
    ip: string,
    mac: string,
    // Of a card's row only: its subnet mask and gateway, and who made it, empty when unknown.
    mask: string,
    gateway: string,
    vendor: string,
    hostname: string,
    manufacturer: string,
    model: string,
    kind: DeviceKind,
    // Already translated, like DeviceView.role, and its place in Bridge.roles.
    role: string,
    role-index: int,
    // The colour of the role's group, as in the device list and on the map.
    colour: GroupColour,
    icon: IconChoice,
    // The icon was picked for this host rather than coming from its role.
    custom-icon: bool,
    notes: string,
    methods: [DiscoveryMethod],
    // Its operating system as guessed, more precisely when a clue said (as given, such as
    // Ubuntu), and the clues behind it.
    os-family: OsFamily,
    os-detail: string,
    os-clues: [OsClueView],
    // The mDNS service types it announced, such as "ipp, http"; empty when none.
    mdns-services: string,
    unidentified: bool,
    finding: FoundFinding,
    // For a duplicate: the name of the device on the map with the same MAC address.
    duplicate-of: string,
    decision: FoundDecision,
}

/// A network card about to become a child of another parent, which would leave the device or
/// found host it is on with no card: the move removes that one, so it is asked first. The names
/// are as shown in the lists.
export struct MoveQuestion {
    shown: bool,
    card: string,
    from: string,
    to: string,
    // The parent left is a found host, which leaves the results rather than the map.
    found: bool,
}

// The answers to "save changes first?".
export enum UnsavedAnswer { save, discard, cancel }
// Why a project could not be opened, or (save-failed) saved; none when nothing went wrong.
export enum FileProblemKind { none, unreadable, too-large, not-project, newer, damaged, save-failed }

// How the last AI model install ended, if one ended since it was last shown.
export enum InstallOutcome { none, done, cancelled, no-folder, network, disk, corrupt }

/// A file operation that failed, shown until dismissed. `detail` is the system's own message,
/// for unreadable and save-failed.
export struct FileProblem {
    kind: FileProblemKind,
    detail: string,
}

/// A line of the discovery log. Which fields are filled depends on the event: `text` is a
/// subnet, a device's name or why the scan failed (the system's own message), `ip` and `mac` a
/// host's, `count` a number of addresses or hosts.
export struct LogView {
    seconds: int,
    warning: bool,
    event: LogEvent,
    text: string,
    ip: string,
    mac: string,
    count: int,
}

export global Bridge {
    // The project file's name, empty until the project is saved; and whether it has changes
    // not saved yet.
    in property <string> project-name;
    in property <bool> unsaved;
    // New, Open or closing waits on the answer to "save changes first?" while this is set.
    in property <bool> unsaved-question;
    in property <FileProblem> file-problem;
    // Import with AI was refused because this GPU cannot run the AI, which is said while set.
    in-out property <bool> gpu-unsupported;
    // Import with AI found no model, so asks whether to download AI support while this is set;
    // the download's size in GB.
    in-out property <bool> ai-download-question;
    in property <float> ai-download-gb;
    // AI support is downloading, from either window, and how far it has got, from 0 to 1.
    in property <bool> ai-downloading;
    in property <float> ai-download-progress;
    // How the download asked for from the question ended, shown until dismissed.
    in-out property <InstallOutcome> ai-download-outcome;
    // What the file dialogs call project files.
    out property <string> project-file-type: @tr("project.file-type");

    // The map's nodes: every network card, drawn with its device's icon and name. Devices are
    // not on the map themselves.
    in property <[DeviceView]> nodes;
    in property <[NodePlace]> places;
    // The devices the search and filter let through, each followed by its network cards.
    in property <[DeviceView]> list;
    // Every device, each followed by its network cards, for the edit page.
    in property <[DeviceView]> rows;
    // Highlighted lines come last, so they are drawn on top.
    in property <[LineSet]> lines;
    in property <Strand> strand;
    in property <MapBounds> bounds;
    // The selected device, also while one of its cards is selected.
    in property <int> selected-id: -1;
    in property <DeviceDetails> details;
    in property <[CardView]> cards;
    in property <[GuestView]> guests;
    // The selected network card, -1 for none, and its view.
    in property <int> selected-card: -1;
    in property <CardView> card;
    // What the selected card can be plugged into: first none, then the cards of the devices
    // away from its own, in device order; and where it is plugged in now.
    in property <[string]> upstream-choices;
    in property <int> card-plug-index;
    // The devices the selected card can be a child of, in device order, and the one it is a
    // child of now.
    in property <[string]> parent-choices;
    in property <int> card-parent-index;
    // Likewise for the selected card of a found host not on the map: the found hosts not on
    // the map, its own among them, then the devices on the map.
    in property <[string]> found-parent-choices;
    in property <int> found-card-parent-index;
    in property <MoveQuestion> move-question;
    in property <[PortView]> ports;
    in property <[string]> roles;
    in property <[RoleView]> role-list;
    // A standard role was renamed, re-iconed or deleted.
    in property <bool> roles-restorable;
    // The group list's rows, and their names led by "no group" for the role group dropdown.
    in property <[GroupView]> groups;
    in property <[string]> group-choices;
    // A preview of each line style, in the order of the group line style dropdown.
    in property <[LineSet]> line-styles;
    in property <StatusFilter> filter;
    in property <int> count-all;
    in property <int> count-online;
    in property <int> count-offline;
    // A discovery run is running.
    in property <bool> scanning;
    // Discovery runs finished or stopped.
    in property <int> scans;
    in property <DiscoveryView> discovery;
    // The discovery page's network box, as typed; set by Rust once, at start.
    in-out property <string> discovery-target-draft;
    // The found hosts the result filter lets through, each followed by its cards' rows.
    in property <[FoundView]> found;
    // The found host shown in the discovery details (index in FoundView), -1 for none; the rows
    // of its cards; and which of them is shown instead (card-index), -1 for the host itself.
    in property <int> selected-found: -1;
    in property <FoundView> found-details;
    in property <[FoundView]> found-cards;
    // Editable ports of the selected found card before its host is added to the map.
    in property <[PortView]> found-ports;
    in property <int> selected-found-card: -1;
    // Newest first.
    in property <[LogView]> discovery-log;
    // Every icon in the icon folder, for the icon picker.
    in property <[IconGroup]> icons;
    // The category of the network card icons in icons, which a card's picker opens on; -1 when
    // the folder has none.
    in property <int> card-icon-category: -1;
    // Likewise the category of the virtual machine and container icons, for a guest's picker.
    in property <int> guest-icon-category: -1;

    // Edit buffers for the selected device, set by Rust when the selection changes.
    in-out property <string> notes-draft;
    in-out property <int> role-index;

    // Selects a device by its id, or nothing on -1; select-card selects a network card.
    callback select(int);
    callback select-card(int);
    // Gives the card with this id the icon with this id (see IconChoice).
    callback set-card-icon(int, string);
    // Folds a device's group up in the lists, or opens it again.
    callback toggle-group(int);
    // A card's id as a drag payload, and back again: -1 when the payload is not a card. The
    // flag marks the card's own row, rather than its device's, which can also be dropped on
    // another device's group on the edit page.
    pure callback card-transfer(int, bool) -> data-transfer;
    pure callback transfer-card(data-transfer) -> int;
    callback search(string);
    callback set-filter(StatusFilter);
    callback rename(string);
    callback choose-role(int);
    // Reads the icon folder again, so icons added since appear. Icons are passed by their id;
    // an empty id is the Unknown icon.
    callback refresh-icons();
    callback edit-notes(string);
    // Gives the device with this id its own icon (the selected one, or one of its guests); or
    // the selected device back its role's icon.
    callback set-icon(int, string);
    callback reset-icon();
    // Removes the selected device until the app restarts.
    callback forget();
    // The selected card's ports, identified by their index in ports. Port numbers come as
    // typed; one that is not 1–65535, or is already listed, is refused (add-port returns false).
    callback add-port(string, string) -> bool;
    callback set-port-number(int, string);
    callback set-port-description(int, string);
    callback remove-port(int);
    // Adds a blank network card to the selected device, and selects it.
    callback add-card();
    // Removes the selected card, unless it is its device's last, and selects the device.
    callback remove-card();
    // A setting of the selected card as typed; empty clears it. Refused (false) when it does
    // not parse, an address is already in use, or a subnet mask is given before an address.
    // An address may carry its prefix (`a.b.c.d/nn`).
    callback edit-card(CardField, string) -> bool;
    // Plugs the selected card into the card at an index in upstream-choices; 0 for none.
    callback plug-card(int);
    // Makes the selected card a child of the device at an index in parent-choices.
    callback set-card-parent(int);
    // A card's own row dropped on the group of the device with this id makes it a child there.
    pure callback can-move-card(data-transfer, int) -> bool;
    callback move-card-to(data-transfer, int);
    // The project file. New and Open ask first about unsaved changes (see unsaved-question),
    // and wait while a scan runs; Save asks where only for a project never saved.
    callback new-project();
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback answer-unsaved(UnsavedAnswer);
    callback dismiss-file-problem();
    // A move that would remove the parent the card leaves waits in move-question for these.
    callback confirm-move();
    callback cancel-move();
    // Adds a blank device with one blank card, and selects it: a guest of this kind on the
    // selected device, or with `none` a device of its own.
    callback add-device(GuestKind);
    // What the selected guest runs as.
    callback set-guest-kind(GuestKind);
    // The role list. Roles are identified by their index in role-list.
    callback add-role(string, string);
    callback rename-role(int, string);
    callback set-role-icon(int, string);
    // The role's devices keep their own detected icon.
    callback clear-role-icon(int);
    callback delete-role(int);
    // Standard roles back as they were, including deleted ones.
    callback restore-roles();
    // A role and its index in group-choices.
    callback set-role-group(int, int);
    // The group list. Groups are identified by their index in groups.
    callback add-group(string);
    callback rename-group(int, string);
    callback set-group-colour(int, GroupColour);
    // A group and its index in the line style dropdown.
    callback set-group-line-style(int, int);
    // The group's roles are left in no group.
    callback delete-group(int);
    // Dragging the card with this id, on the map or from the lists, so its icon is at (x, y) in
    // map units: it moves there and previews the line it would join. Dropping it plugs it in
    // there, or unplugs it away from every line; cancelling sends it back. Both are ignored
    // when nothing is dragged.
    callback move-card(int, float, float);
    callback drop-card();
    callback cancel-drag();
    // The discovery run: start (again), and stop where it got to. Its network (as typed) and
    // options can be changed while it is not running.
    callback start-discovery();
    callback stop-discovery();
    callback set-discovery-target(string);
    callback set-scan-mode(ScanMode);
    callback set-found-filter(FoundFilter);
    callback sort-found(FoundSort);
    // Found hosts by their FoundView.index, -1 for none. Selecting one on the map selects its
    // device too, which is edited like any other. A host not on the map can be renamed, given a
    // role (index in roles), an icon (by id) or notes, then added to the map or ignored.
    callback select-found(int);
    // A card of a found host, by the host's index and the card's card-index. One on the map is
    // selected there and gets the card editor; one not on the map can be renamed or given an
    // icon (by id), which it is added with.
    callback select-found-card(int, int);
    callback rename-found-card(int, int, string);
    callback set-found-card-icon(int, int, string);
    callback add-found-port(int, int, string, string) -> bool;
    callback set-found-port-description(int, int, int, string);
    callback remove-found-port(int, int, int);
    callback set-found-role(int, int);
    callback rename-found(int, string);
    callback set-found-icon(int, string);
    callback reset-found-icon(int);
    callback edit-found-notes(int, string);
    callback add-found(int);
    callback ignore-found(int);
    // Adds every new host still waiting for a decision to the map; ignored hosts and possible
    // duplicates wait for the user.
    callback import-found();
    // Import with AI: the same hosts, each with what the scan made of it (type, OS family,
    // notes, and a name not from a full hostname) replaced by what the AI is confident about
    // before it is added; and stopping it, which leaves the rest waiting.
    callback import-found-with-ai();
    callback stop-ai-import();
    // Downloads AI support in the background, as agreed to in the question; and cancels the
    // download running, from either window, removing anything partly downloaded.
    callback download-ai();
    callback cancel-ai-download();
    // A card of a found host not on the map, by the host's index and the card's card-index: as
    // a drag payload, dropped on a found host's group (by its index) to become a child there,
    // or given the parent at an index in found-parent-choices.
    pure callback found-card-transfer(int, int) -> data-transfer;
    pure callback can-move-found-card(data-transfer, int) -> bool;
    callback move-found-card(data-transfer, int);
    callback set-found-card-parent(int, int, int);
}

/// Purely visual map preferences from the map's View menu: what each device is labelled with.
export global MapSettings {
    in-out property <bool> show-names: true;
    in-out property <bool> show-roles;
    in-out property <bool> show-addresses: true;
    in-out property <bool> show-macs;
    in-out property <bool> show-hostnames;
    in-out property <bool> show-status: true;
}
