# Network Mapper: English (British) UI text.
# Every user-visible string lives here and in the other languages' files; the .slint files only
# hold the message keys. Copy this file to start a new language. Placeholders: {} or {0}, {1} are
# filled in order; {n} is the count that picks a plural form.
msgid ""
msgstr ""
"Project-Id-Version: network-mapper\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

