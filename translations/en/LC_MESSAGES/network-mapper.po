msgid "details.runs-on"
msgstr "Runs on"

# One of the device's network cards.
msgid "details.card"
msgstr "Network card"

# A network card's address, then where it is plugged in (see details.plugged-into),
# e.g. "192.168.1.20, Main Switch (known link)".
