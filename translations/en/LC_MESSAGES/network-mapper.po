msgstr "First token after {0} s"

msgid "ai-settings.end-limit"
msgstr "The answer reached the answer limit. Raise the limit to let the model finish."

msgid "ai-settings.end-stopped"
msgstr "Stopped. The answer so far is kept."

# How the model picks each word of its answer.
msgid "ai-settings.generation"
msgstr "Answer settings"

msgid "ai-settings.temperature"
msgstr "Temperature"

msgid "ai-settings.temperature-explained"
msgstr "At 0 the model always picks its likeliest word, so the same input gives the same answer. Higher values vary the answer."

msgid "ai-settings.top-p"
msgstr "Top-p"

msgid "ai-settings.top-p-explained"
msgstr "Picks only among the likeliest words that together reach this share; 1 uses them all. Applies above temperature 0."

msgid "ai-settings.top-k"
msgstr "Top-k"

msgid "ai-settings.top-k-explained"
msgstr "Picks only among this many likeliest words; 0 means no limit. Applies above temperature 0."

msgid "ai-settings.min-p"
msgstr "Min-p"

msgid "ai-settings.min-p-explained"
msgstr "Leaves out words less than this share as likely as the likeliest one; 0 is off. Applies above temperature 0."

msgid "ai-settings.repeat-penalty"
msgstr "Repeat penalty"

msgid "ai-settings.repeat-penalty-explained"
msgstr "Above 1, makes the model less likely to repeat what it has just written. 1 is off."

msgid "ai-settings.presence-penalty"
msgstr "Presence penalty"

msgid "ai-settings.presence-penalty-explained"
msgstr "Makes words the model has just written less likely to appear again. Qwen3 recommends 1.5; 0 is off."

msgid "ai-settings.max-tokens"
msgstr "Answer limit (tokens)"

msgid "ai-settings.max-tokens-explained"
msgstr "Stops the answer after this many tokens. A token is a word or part of one."

msgid "ai-settings.context-tokens"
msgstr "Context limit (tokens)"

msgid "ai-settings.context-tokens-explained"
msgstr "The most tokens the prompt, evidence and answer may hold together. Higher allows longer prompts but uses more memory; the model's own limit still applies."

msgid "ai-settings.think"
msgstr "Let the model think first"

msgid "ai-settings.think-explained"
msgstr "Uses Qwen3's recommended thinking or direct-answer settings. Thinking allows a longer answer, because the reasoning comes first; it is kept separate from the final answer. Other models ignore the thinking control."

msgid "ai-settings.restore-defaults"
msgstr "Restore defaults"

msgid "ai-settings.install"
msgstr "Install AI"

# {0} is the model's name, {1} its download size in GB, {2} the folder it goes into.
msgid "ai-settings.install-note"
msgstr "Downloads {0} ({1} GB) from Hugging Face into {2}. Nothing else is sent or downloaded."

# {0} is the model's name, {1} the GB downloaded so far, {2} the GB in all.
msgid "ai-settings.downloading"
