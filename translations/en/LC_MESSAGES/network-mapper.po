# Network Mapper: English (British) UI text.
# Every user-visible string lives here and in the other languages' files; the .slint files only
# hold the message keys. Copy this file to start a new language. Placeholders: {} or {0}, {1} are
# filled in order; {n} is the count that picks a plural form.
msgid ""
msgstr ""
"Project-Id-Version: network-mapper\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Window and header
msgid "app.title"
msgstr "Network Mapper"

msgid "header.scan"
msgstr "Scan"

msgid "header.scanning"
msgstr "Scanning…"

msgid "header.settings"
msgstr "Settings"

msgid "settings.title"
msgstr "Settings"

msgid "settings.map-display-moved"
msgstr "What the map shows for each device is set with the View button on the map."

msgid "settings.ai"
msgstr "AI settings…"

# The AI settings window.
msgid "ai-settings.title"
msgstr "AI settings"

msgid "ai-settings.install-title"
msgstr "Install a model"

# {0} is the model's name.
msgid "ai-settings.offer-installed"
msgstr "{0} is installed. Choose it under Model and select Load to use it."

msgid "ai-settings.model"
msgstr "Model"

# Under the model list when there is nothing to load.
msgid "ai-settings.no-model"
msgstr "No model installed yet. Install one below, or add your own GGUF file."

# {0} is the models folder.
msgid "ai-settings.own-models"
msgstr "To use a model of your own, put its GGUF file in {0} and refresh the list. Qwen3, Qwen2 and Llama models whose tokenizer is in the file can run."

# Starts the chosen model: reads it into memory.
msgid "ai-settings.load"
msgstr "Load"

# Stops the loaded model and frees its memory.
msgid "ai-settings.unload"
msgstr "Unload"

# Re-reads the models folder.
msgid "ai-settings.refresh"
msgstr "Refresh the model list"

# The status lights at the top of the window. {0} is the model's name.
msgid "ai-settings.light-loading"
msgstr "Loading {0}"

msgid "ai-settings.light-running"
msgstr "{0} answering"

msgid "ai-settings.light-loaded"
msgstr "{0} loaded"

msgid "ai-settings.light-none"
msgstr "No model loaded"

msgid "ai-settings.light-failed"
msgstr "Model not loaded"

msgid "ai-settings.light-cuda-on"
msgstr "CUDA on"

msgid "ai-settings.light-cuda-off"
msgstr "CUDA off"

msgid "ai-settings.light-cuda-no-gpu"
msgstr "CUDA: no graphics card"

msgid "ai-settings.light-cuda-not-built"
msgstr "CUDA not built in"

msgid "ai-settings.state-none"
msgstr "No model loaded. Choose one and select Load."

msgid "ai-settings.state-loading"
msgstr "Loading the model…"

msgid "ai-settings.state-ready-gpu"
msgstr "Loaded on the graphics card and ready."

msgid "ai-settings.state-ready-cpu"
msgstr "Loaded on the processor and ready."

msgid "ai-settings.state-no-gpu"
msgstr "No usable NVIDIA graphics card was found. Switch off CUDA to load the model on the processor."

msgid "ai-settings.state-running"
msgstr "Answering… this can take a minute or more on the processor."

msgid "ai-settings.state-no-model"
msgstr "Load a model before running it."

msgid "ai-settings.state-missing"
msgstr "This model's files are missing. Install it again, or put its file back in the models folder."

msgid "ai-settings.state-broken"
msgstr "This model's files could not be read as a model. Install it again, or replace its file."

msgid "ai-settings.state-unsupported"
msgstr "This model is of a kind the app cannot run. Qwen3, Qwen2 and Llama models whose tokenizer is in the file can run."

msgid "ai-settings.state-too-long"
msgstr "The prompt and evidence are too long for the model. Shorten them and run again."

msgid "ai-settings.state-failed"
msgstr "The model stopped with an error part-way through its answer."

msgid "ai-settings.prompt"
msgstr "Prompt"

msgid "ai-settings.input"
msgstr "Device evidence (sample file)"

msgid "ai-settings.run"
msgstr "Run"

# Ends the answer being written.
msgid "ai-settings.stop"
msgstr "Stop"

msgid "ai-settings.restore-texts"
msgstr "Restore prompt and sample"

msgid "ai-settings.output"
msgstr "Output"

# Under the output. {n} is the answer's length in tokens, {0} the seconds it took, {1} the
# tokens it wrote each second.
msgid "ai-settings.answer-stats"
msgid_plural "ai-settings.answer-stats.plural"
msgstr[0] "{n} token in {0} s ({1} tokens a second)"
msgstr[1] "{n} tokens in {0} s ({1} tokens a second)"

msgid "ai-settings.end-limit"
msgstr "The answer reached the answer limit. Raise the limit to let the model finish."

msgid "ai-settings.end-stopped"
msgstr "Stopped. The answer so far is kept."

# How the model picks each word of its answer.
msgid "ai-settings.generation"
msgstr "Answer settings"

msgid "ai-settings.temperature"
msgstr "Temperature"

msgid "ai-settings.temperature-explained"
msgstr "At 0 the model always picks its likeliest word, so the same input gives the same answer. Higher values vary the answer."

msgid "ai-settings.top-p"
msgstr "Top-p"

msgid "ai-settings.top-p-explained"
msgstr "Picks only among the likeliest words that together reach this share; 1 uses them all. Applies above temperature 0."

msgid "ai-settings.top-k"
msgstr "Top-k"

msgid "ai-settings.top-k-explained"
msgstr "Picks only among this many likeliest words; 0 means no limit. Applies above temperature 0."

msgid "ai-settings.repeat-penalty"
msgstr "Repeat penalty"

msgid "ai-settings.repeat-penalty-explained"
msgstr "Above 1, makes the model less likely to repeat what it has just written. 1 is off."

msgid "ai-settings.max-tokens"
msgstr "Answer limit (tokens)"

msgid "ai-settings.max-tokens-explained"
msgstr "Stops the answer after this many tokens. A token is a word or part of one."

msgid "ai-settings.seed"
msgstr "Seed"

msgid "ai-settings.seed-explained"
msgstr "Starts the random choices: the same seed and settings repeat a varied answer. Applies above temperature 0."

msgid "ai-settings.think"
msgstr "Let the model think first"

msgid "ai-settings.think-explained"
msgstr "The model writes out its reasoning before the answer. Slower and longer, so raise the answer limit; sometimes more accurate."

msgid "ai-settings.think-unavailable"
msgstr "The loaded model cannot think before answering."

msgid "ai-settings.restore-defaults"
msgstr "Restore defaults"

msgid "ai-settings.install"
msgstr "Install AI"

# {0} is the model's name, {1} its download size in GB, {2} the folder it goes into.
msgid "ai-settings.install-note"
msgstr "Downloads {0} ({1} GB) from Hugging Face into {2}. Nothing else is sent or downloaded."

# {0} is the model's name, {1} the GB downloaded so far, {2} the GB in all.
msgid "ai-settings.downloading"
msgstr "Downloading {0}: {1} of {2} GB"

msgid "ai-settings.cancel"
msgstr "Cancel"

msgid "ai-settings.outcome-done"
msgstr "The model is installed and checked."

msgid "ai-settings.outcome-cancelled"
msgstr "The install was cancelled. Anything partly downloaded has been removed."

msgid "ai-settings.outcome-no-folder"
msgstr "This system has no application data folder to install the model into."

msgid "ai-settings.outcome-network"
msgstr "The download failed. Check the internet connection and try again."

msgid "ai-settings.outcome-disk"
msgstr "The model could not be saved. Check there is enough free disk space and try again."

msgid "ai-settings.outcome-corrupt"
msgstr "What was downloaded is not the expected model, so it was removed. Try again."

msgid "ai-settings.behaviour"
msgstr "Behaviour"

msgid "ai-settings.cuda"
msgstr "Use the graphics card (CUDA)"

msgid "ai-settings.cuda-explained"
msgstr "Runs the model on the NVIDIA graphics card, much faster than on the processor. Changing it reloads the model."

msgid "ai-settings.cuda-not-built"
msgstr "This copy of the app was built without CUDA, so the model runs on the processor."

msgid "ai-settings.fill-missing"
msgstr "Fill missing inferred fields"

msgid "ai-settings.fill-missing-explained"
msgstr "Fills in a device's empty type, OS family and description when the AI is confident. Your own entries are never changed, and each filled field can be undone."

msgid "ai-settings.auto-add"
msgstr "Automatically add new devices"

msgid "ai-settings.auto-add-explained"
msgstr "Adds new hosts the AI identifies with confidence to the map. Unclear hosts and possible duplicates always wait for you to review."

