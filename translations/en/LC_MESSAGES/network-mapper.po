msgid "edit.port-number"
msgstr "Port"

msgid "edit.port-description"
msgstr "Description"

msgid "edit.port-remove"
msgstr "Remove port"

msgid "edit.port-add"
msgstr "Add port"

msgid "edit.port-confirm-add"
msgstr "Add"

