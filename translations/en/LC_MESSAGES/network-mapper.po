msgstr "Select a host to see what the scan found out about it."

# The device on the map with the same MAC address as a found host.
msgid "discovery.same-mac-as"
msgstr "Same MAC as"

msgid "discovery.add"
msgstr "Add to map"

msgid "discovery.ignore"
msgstr "Ignore"

msgid "discovery.show-on-map"
msgstr "Show on map"

msgid "discovery.log.title"
msgstr "Discovery log"

msgid "log.level.info"
msgstr "Info"

msgid "log.level.warning"
msgstr "Warning"

# {} is a subnet.
msgid "log.started"
msgstr "Started a simulated scan of {}"

# {} is a number of addresses.
msgid "log.sweep"
msgstr "Ping sweep of {} addresses"

# {0} is a device's name, {1} its IP address.
msgid "log.discovered"
msgstr "Found {0} at {1}"

# {0} is an IP address, {1} a MAC address.
msgid "log.unidentified"
msgstr "Could not tell what the host at {0} is ({1})"

# {0} is an IP address, {1} the name of the device on the map with the same MAC address.
msgid "log.duplicate"
msgstr "The host at {0} has the same MAC address as {1}"

msgid "log.paused"
msgstr "Paused"

msgid "log.resumed"
msgstr "Resumed"

msgid "log.stopped"
msgid_plural "log.stopped.plural"
msgstr[0] "Stopped early · {n} host found"
msgstr[1] "Stopped early · {n} hosts found"

msgid "log.finished"
msgid_plural "log.finished.plural"
msgstr[0] "Finished · {n} host found"
msgstr[1] "Finished · {n} hosts found"
