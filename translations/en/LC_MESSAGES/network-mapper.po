# Edit page
msgid "edit.title"
msgstr "Devices, roles and groups"

msgid "edit.back"
msgstr "Back to map"

msgid "edit.choose-device"
msgstr "Choose a device to edit it."

msgid "edit.icon-from-role"
msgstr "Use the role's icon"

msgid "edit.forget"
msgstr "Forget device"

msgid "edit.forget-question"
msgstr "Remove this device, with any virtual machines and containers on it, from the map and the list? It comes back when the app restarts."

msgid "edit.forget-confirm"
msgstr "Forget"

msgid "edit.cancel"
msgstr "Cancel"

# The button above the device list, and its menu. What it adds starts blank and is selected,
# so it can be filled in. A virtual machine runs on the selected device, named by {}.
msgid "edit.add"
msgstr "Add"

msgid "edit.add-device"
msgstr "Device"

msgid "edit.add-guest"
msgstr "Virtual machine"

msgid "edit.add-guest-on"
msgstr "Virtual machine on {}"

# The network cards of the device being edited, each opened from its row to edit it. A new card
# starts blank and is selected, so its IP address and the rest can be filled in.
msgid "edit.cards"
msgstr "Network cards"

# First in the dropdown of what a network card is plugged into.
msgid "edit.card-no-link"
msgstr "Not connected"

msgid "edit.card-add"
msgstr "Add interface"

msgid "edit.card-remove"
msgstr "Remove network card"

# The button leading from a network card back to its device, which is named on the button.
msgid "edit.card-back"
msgstr "Back to the device"

# Under the name of the network card being edited; {} is its device.
msgid "edit.card-of"
msgstr "Network card of {}"

# Shown under a network card setting that was not accepted.
msgid "edit.card-ip-hint"
msgstr "Enter an IPv4 address that no other card has, such as 192.168.1.20 or 10.0.0.5/24."

msgid "edit.card-mask-hint"
msgstr "Enter a subnet mask such as 255.255.255.0, or a prefix length such as 24."

msgid "edit.card-gateway-hint"
msgstr "Enter an IPv4 address, such as 192.168.1.1."

msgid "edit.card-mac-hint"
msgstr "Enter six pairs of hexadecimal digits, such as 3C:22:FB:1A:2B:3C."

# The virtual machines and containers on the device being edited, listed with adding more (see
# guest.*). Each is edited on its own, opened from its row.
msgid "edit.guests"
msgstr "Guests"

# Under a guest's name in that list: what it runs as, then its IP address.
msgid "edit.guest-summary"
msgstr "{} · {}"

# The button leading from a virtual machine or container back to its host, which is named on
# the button.
msgid "edit.guest-back"
msgstr "Back to the host"

# Whether the guest being edited is a virtual machine or a container.
msgid "edit.guest-kind"
msgstr "Runs as"

# Adds a blank virtual machine to the device being edited, and opens it.
msgid "edit.guest-add"
msgstr "Add virtual machine"

# The open ports of the device being edited.
msgid "edit.port-number"
msgstr "Port"

msgid "edit.port-description"
msgstr "Description"

msgid "edit.port-remove"
msgstr "Remove port"

msgid "edit.port-add"
msgstr "Add port"

msgid "edit.port-confirm-add"
msgstr "Add"

