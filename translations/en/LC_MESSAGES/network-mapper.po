# Details panel
msgid "details.empty"
msgstr "Select a device on the map or in the list to see its details."

msgid "details.close"
msgstr "Close details"

# The pencil in the details panel: edits the selected device or network card in the panel.
msgid "details.edit"
msgstr "Edit"

# Ends editing in the details panel and shows the details again.
msgid "details.done"
msgstr "Done"

msgid "details.name"
msgstr "Name"

msgid "details.role"
msgstr "Role"

# For a virtual machine or container: the device it runs on (see runs-on.*).
msgid "details.runs-on"
msgstr "Runs on"

# One of the device's network cards.
msgid "details.card"
msgstr "Network card"

# A network card's address, then where it is plugged in (see details.plugged-into),
# e.g. "192.168.1.20, Main Switch (known link)".
msgid "details.card.value"
msgstr "{}, {}"

# A network card's settings.
msgid "details.ip"
msgstr "IP address"

msgid "details.mask"
msgstr "Subnet mask"

msgid "details.gateway"
msgstr "Gateway"

# The card of another device a network card is plugged into (see card.of and uplink.*).
msgid "details.plugged-into"
msgstr "Plugged into"

# The device (or, on the discovery page, the found host) a network card belongs to; picking
# another moves the card there.
msgid "details.child-of"
msgstr "Child of"

# Asked before a network card moves to another parent that would leave the device it is on
# with no network card.
msgid "move.title"
msgstr "Move network card?"

# {0} is the network card, {1} the device it leaves, {2} the device it moves to.
msgid "move.question"
msgstr "{0} is the only network card of {1}. Moving it to {2} removes {1} from the map and the list, and anything running on {1} then runs on {2}. The card keeps its address and settings."

# As move.question, on the discovery page: {1} is a found host, {2} a found host or a device.
msgid "move.question-found"
msgstr "{0} is the only network card of {1}. Moving it to {2} removes {1} from the results. The card keeps its address and settings."

msgid "move.confirm"
msgstr "Move"

# While a network card is selected: shows its device's details instead.
msgid "details.show-device"
msgstr "Show device details"

# A network card the user has not named; {} is its place among its device's cards.
msgid "card.unnamed"
msgstr "Network card {}"

# A device's network card where it stands in for the device: on the map, and in the list of
# what a card can be plugged into. {0} is the device, {1} the card.
msgid "card.of"
msgstr "{0} · {1}"

msgid "card.no-address"
msgstr "No IP address"

# A network card's short name on the map, for a card the user has not named; {} is its place
# among its device's cards.
msgid "card.short"
msgstr "NC{}"

# Under a device's name on the map: {0} is the card's short name (its name, or card.short),
# {1} its IP address.
msgid "card.label"
msgstr "{0}: {1}"

