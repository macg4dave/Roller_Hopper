# Edit page
msgid "edit.title"
msgstr "Devices, roles and groups"

msgid "edit.back"
msgstr "Back to map"

msgid "edit.choose-device"
msgstr "Choose a device to edit it."

msgid "edit.icon-from-role"
msgstr "Use the role's icon"

msgid "edit.forget"
msgstr "Forget device"

msgid "edit.forget-question"
msgstr "Remove this device, with any virtual machines and containers on it, from the map and the list? It comes back when the app restarts."

msgid "edit.forget-confirm"
msgstr "Forget"

msgid "edit.cancel"
msgstr "Cancel"

msgid "edit.confirm-add"
msgstr "Add"

# The network cards of the device being edited, which are listed under it. A new card starts
# blank and is selected, so its IP address and the rest can be filled in.
msgid "edit.cards"
msgstr "Network cards"

# The address of a new virtual machine's or container's network card.
msgid "edit.card-address"
msgstr "IP address, e.g. 10.0.0.5/24"

# First in the dropdown of what a network card is plugged into.
msgid "edit.card-no-link"
msgstr "Not connected"

msgid "edit.card-add"
msgstr "Add interface"

msgid "edit.card-remove"
msgstr "Remove network card"

