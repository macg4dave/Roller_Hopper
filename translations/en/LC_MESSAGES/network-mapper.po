msgid "edit.card-back"
msgstr "Back to the device"

# Under the name of the network card being edited; {} is its device.
msgid "edit.card-of"
msgstr "Network card of {}"

# Shown under a network card setting that was not accepted.
msgid "edit.card-ip-hint"
msgstr "Enter an IPv4 address that no other card has, such as 192.168.1.20 or 10.0.0.5/24."

msgid "edit.card-mask-hint"
msgstr "Enter a subnet mask such as 255.255.255.0, or a prefix length such as 24."

msgid "edit.card-gateway-hint"
msgstr "Enter an IPv4 address, such as 192.168.1.1."

msgid "edit.card-mac-hint"
msgstr "Enter six pairs of hexadecimal digits, such as 3C:22:FB:1A:2B:3C."

# Adding a virtual machine or container to the device being edited (see guest.*).
msgid "edit.guests"
msgstr "Guests"

msgid "edit.guest-kind"
msgstr "Type"

msgid "edit.guest-add"
msgstr "Add virtual machine or container"

